<% layout('partials/layout') %>

<%
  function cardExcerpt(desc, max) {
    if (!desc) return '';
    var txt = String(desc)
      .replace(/<[^>]*>/g, ' ')
      .replace(/&nbsp;/gi, ' ')
      .replace(/&amp;/gi, '&')
      .replace(/&lt;/gi, '<')
      .replace(/&gt;/gi, '>')
      .replace(/&quot;/gi, '"')
      .replace(/&#39;/g, "'")
      .replace(/\s+/g, ' ')
      .trim();
    var limit = max || 160;
    if (txt.length > limit) {
      txt = txt.substring(0, limit);
      var lastSpace = txt.lastIndexOf(' ');
      if (lastSpace > 80) txt = txt.substring(0, lastSpace);
      txt += '…';
    }
    return txt;
  }
%>

<style>
  .slider-fade-enter { opacity: 0; }
  .slider-fade-active { opacity: 1; transition: opacity 0.5s ease; }
  #slider-bg { transition: opacity 0.4s ease, background-image 0s; }
</style>

<style>
  #hero-bgs .hero-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    opacity: 0; transition: opacity 1s ease;
    will-change: transform, opacity;
  }
  @keyframes heroZoomOut {
    from { transform: scale(1.15); }
    to { transform: scale(1); }
  }
  #hero-bgs .hero-bg.on {
    opacity: 1;
    animation: heroZoomOut 7.5s ease-out forwards;
  }
  .hero-nav-btn { background: rgba(24,24,28,.55); backdrop-filter: blur(6px); }
  .hero-nav-btn:hover { background: rgba(39,39,42,.85); }
  .hero-dot { width: 9px; height: 9px; border-radius: 9999px; background: rgba(255,255,255,.35); transition: all .3s ease; }
  .hero-dot.on { background: #10b981; width: 26px; }
</style>

<style>
  .manset-nav-btn.active { background: #dc2626; color: #fff; box-shadow: 0 4px 12px rgba(220,38,38,0.4); }
  .manset-nav-btn:not(.active) { background: rgba(24,24,28,0.8); color: #a1a1aa; }
  .manset-nav-btn:not(.active):hover { background: rgba(39,39,42,0.9); color: #f4f4f5; }
  .slider-text-fade { transition: opacity 0.18s ease; }
</style>

<!-- 🖼️ Çınarcık Görsel Hero -->
<%
  const heroCtas = [
    [{ label: t('news') + ' →', href: '/haberler', primary: true }, { label: t('ferrySchedule'), href: '#sefer-saatleri' }],
    [{ label: t('news') + ' →', href: '/haberler', primary: true }, { label: t('pharmacies'), href: '#nobetci-eczaneler' }],
    [{ label: t('news') + ' →', href: '/haberler', primary: true }, { label: t('places'), href: '/mekanlar' }],
    [{ label: t('news') + ' →', href: '/haberler', primary: true }, { label: t('sightseeing'), href: '/gezilecek-yerler' }],
    [{ label: t('news') + ' →', href: '/haberler', primary: true }, { label: t('guide'), href: '/rehber' }]
  ];
%>
<section id="hero" class="relative w-full h-[420px] md:h-[540px] overflow-hidden bg-zinc-950">
  <div id="hero-bgs">
    <div class="hero-bg on" data-title="<%= t('heroSlide1Title') %>" data-sub="<%= t('heroSlide1Sub') %>" data-cta="<%= JSON.stringify(heroCtas[0]) %>" style="background-image:url('/images/cinar/1.webp');"></div>
    <div class="hero-bg" data-title="<%= t('heroSlide2Title') %>" data-sub="<%= t('heroSlide2Sub') %>" data-cta="<%= JSON.stringify(heroCtas[1]) %>" style="background-image:url('/images/cinar/2.webp');"></div>
    <div class="hero-bg" data-title="<%= t('heroSlide3Title') %>" data-sub="<%= t('heroSlide3Sub') %>" data-cta="<%= JSON.stringify(heroCtas[2]) %>" style="background-image:url('/images/cinar/3.webp');"></div>
    <div class="hero-bg" data-title="<%= t('heroSlide4Title') %>" data-sub="<%= t('heroSlide4Sub') %>" data-cta="<%= JSON.stringify(heroCtas[3]) %>" style="background-image:url('/images/cinar/4.webp'); background-position: center 40%;"></div>
    <div class="hero-bg" data-title="<%= t('heroSlide5Title') %>" data-sub="<%= t('heroSlide5Sub') %>" data-cta="<%= JSON.stringify(heroCtas[4]) %>" style="background-image:url('/images/cinar/5.webp');"></div>
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-transparent"></div>

  <div class="relative h-full max-w-7xl mx-auto px-4 flex items-end pb-16 md:pb-20">
    <div id="hero-content" class="max-w-2xl text-white space-y-3 transition-opacity duration-500 pl-14 md:pl-16">
      <span class="inline-block bg-emerald-600 text-white font-black text-xs px-3 py-1.5 rounded-r-md tracking-wider uppercase shadow-lg"><%= t('heroSlide3Title') %></span>
      <h1 id="hero-title" class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight uppercase drop-shadow-md leading-tight"><%= t('heroSlide1Title') %></h1>
      <p id="hero-sub" class="text-zinc-300 text-sm sm:text-base max-w-xl"><%= t('heroSlide1Sub') %></p>
      <div id="hero-ctas" class="flex flex-wrap gap-3 pt-1">
        <a href="/haberler" class="bg-emerald-600 hover:bg-emerald-500 transition font-bold px-5 py-2.5 rounded-lg text-sm"><%= t('news') %> →</a>
        <a href="#sefer-saatleri" class="bg-white/10 hover:bg-white/20 backdrop-blur-md transition font-bold px-5 py-2.5 rounded-lg text-sm"><%= t('ferrySchedule') %></a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-5 right-6 z-20 flex items-center gap-2" id="hero-dots"></div>

  <button id="hero-prev" aria-label="<%= t('previousImage') %>" class="hero-nav-btn absolute left-4 top-1/2 z-20 text-white w-11 h-11 rounded-full flex items-center justify-center text-xl font-bold transition">‹</button>
  <button id="hero-next" aria-label="<%= t('nextImage') %>" class="hero-nav-btn absolute right-4 top-1/2 z-20 text-white w-11 h-11 rounded-full flex items-center justify-center text-xl font-bold transition">›</button>
</section>

<div class="max-w-7xl mx-auto px-4 py-6">
<div class="section-header">
  <h2>📰 <%= t('news') %></h2>
  <a href="/haberler" class="see-all"><%= t('allNews') %></a>
</div>
<section id="headline-slider" class="relative bg-zinc-950">
  <div id="slider-inner" class="relative w-full h-[400px] md:h-[480px] overflow-hidden rounded-2xl">
    <div id="slider-bg" class="absolute inset-0 bg-cover bg-top transition-all duration-300" style="background-image:url('<%= img(headlines[0] && headlines[0].main_image_url ? headlines[0].main_image_url : "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80") %>');"></div>
    <div id="slider-overlay" class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/25 to-transparent z-10"></div>
    <div id="slider-content" class="absolute inset-0 z-20 flex items-end p-6 sm:p-12 pl-16 sm:pl-20 pb-20 sm:pb-24">
      <div id="slider-text" class="max-w-2xl text-white space-y-3 slider-text-fade">
        <div id="slider-badge" class="<%= headlines[0] && headlines[0].badge_text && headlines[0].badge_text.trim() ? '' : 'hidden' %> bg-red-600 text-white font-black text-xs md:text-sm px-3 py-1.5 rounded-r-md tracking-wider uppercase inline-block shadow-lg"><%= headlines[0] && headlines[0].badge_text ? headlines[0].badge_text : t('manset') %></div>
        <h2 id="slider-title" class="text-2xl sm:text-3xl md:text-5xl font-black tracking-tight uppercase drop-shadow-md leading-tight"><%= headlines[0] ? headlines[0].title : t('heroTagline') %></h2>
        <p id="slider-summary" class="text-gray-300 text-sm sm:text-base max-w-2xl"><%= headlines[0] ? (headlines[0].summary || '') : '' %></p>
        <a id="slider-link" href="<%= headlines[0] ? ('/haber/' + (headlines[0].slug || headlines[0].id)) : '/haberler' %>" class="inline-block bg-red-600 text-white font-bold px-5 py-2.5 rounded-lg hover:bg-red-500 transition"><%= t('goToArticle') %></a>
      </div>
    </div>

    <div class="absolute bottom-4 right-6 z-30 flex items-center gap-2" id="manset-nav">
      <% headlines.slice(0, 5).forEach((n, i) => { %>
      <button type="button" class="manset-nav-btn <%= i === 0 ? 'active bg-red-600 text-white' : 'bg-zinc-800/80 text-zinc-300' %> px-3 py-1.5 rounded-lg font-bold text-xs shadow-lg transition-all" data-slide="<%= i %>"><%= i + 1 %></button>
      <% }); %>
    </div>

    <button id="slider-prev" class="absolute left-4 top-1/2 z-30 bg-white/10 backdrop-blur-md hover:bg-white/20 transition text-white w-12 h-12 rounded-full flex items-center justify-center text-xl font-bold">‹</button>
    <button id="slider-next" class="absolute right-4 top-1/2 z-30 bg-white/10 backdrop-blur-md hover:bg-white/20 transition text-white w-12 h-12 rounded-full flex items-center justify-center text-xl font-bold">›</button>
  </div>
</section>
</div>

<% if (announcements.length > 0) { %>
<section class="section">
  <div class="section-header">
    <h2>📢 <%= t('annList') %></h2>
    <a href="/duyurular" class="see-all"><%= t('viewAll') %></a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% announcements.forEach(a => { %>
    <a href="/duyuru/<%= a.slug || a.id %>" class="card announcement-card block group">
      <span class="announce-tag <%= a.category === 'ilan' ? 'tag-ilan' : a.category === 'etkinlik' ? 'tag-etkinlik' : 'tag-duyuru' %>"><%= a.category === 'ilan' ? t('ad') : a.category === 'etkinlik' ? t('event') : t('announcement') %></span>
      <% if (a.image) { %><img src="<%= a.image %>" alt="<%= a.title %>" loading="lazy" decoding="async" class="w-full h-40 object-cover ann-img-frame rounded-xl mb-2" /><% } %>
      <h3 class="group-hover:text-emerald-400 transition-colors"><%= a.title %></h3>
      <p><%= String(a.content || '').replace(/<[^>]*>/g, ' ').substring(0, 120) %>...</p>
      <span class="card-date"><%= new Date(a.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if ((typeof weekEvents !== 'undefined' && weekEvents.length > 0) || (typeof sea !== 'undefined' && sea)) { %>
<section class="section" id="bu-hafta">
  <div class="section-header">
    <h2>🗓️ <%= t('thisWeek') %></h2>
    <a href="/etkinlikler" class="see-all"><%= t('weekSeeEvents') %></a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">

    <div class="card flex flex-col">
      <h3 class="font-bold text-white mb-3 flex items-center gap-2">🎟️ <%= t('events') %></h3>
      <div class="flex-1">
        <% if (typeof weekEvents !== 'undefined' && weekEvents.length > 0) { %>
          <% weekEvents.forEach(ev => {
            const ed = new Date(ev.event_date + 'T00:00:00');
          %>
          <a href="/duyuru/<%= ev.slug || ev.id %>" class="flex items-center gap-3 py-2.5 border-b border-zinc-800 last:border-0 hover:text-emerald-300 transition-colors">
            <span class="shrink-0 w-12 text-center bg-amber-500/10 border border-amber-500/30 rounded-lg py-1">
              <span class="block text-amber-400 text-[10px] font-bold uppercase leading-tight"><%= ed.toLocaleDateString(t('dateLocale'), { weekday: 'short' }) %></span>
              <span class="block text-white text-base font-black leading-none"><%= ed.getDate() %></span>
              <span class="block text-amber-500/90 text-[9px] font-bold uppercase leading-tight"><%= ed.toLocaleDateString(t('dateLocale'), { month: 'short' }) %></span>
            </span>
            <span class="text-sm text-zinc-300 line-clamp-2"><%= ev.title %></span>
          </a>
          <% }) %>
        <% } else { %>
          <p class="text-zinc-500 text-sm"><%= t('weekNoEvents') %></p>
        <% } %>
      </div>
      <a href="/etkinlikler" class="see-all mt-auto pt-3"><%= t('weekSeeEvents') %></a>
    </div>

    <div class="card flex flex-col">
      <h3 class="font-bold text-white mb-3 flex items-center gap-2">🌊 <%= t('sea') %></h3>
      <div class="flex-1 flex flex-col items-center justify-center text-center py-2">
        <% if (typeof sea !== 'undefined' && sea) { %>
          <p class="text-4xl font-black text-white"><%= sea.seaTemp != null ? Number(sea.seaTemp).toFixed(1) + '°C' : '—' %></p>
          <p class="text-xs text-zinc-500 uppercase tracking-wide mt-1"><%= t('seaTemp') %></p>
          <div class="flex items-center gap-4 mt-3 text-sm text-zinc-300">
            <span title="<%= t('waveHeight') %>">🌊 <%= sea.waveHeight != null ? Number(sea.waveHeight).toFixed(2) + ' m' : '—' %></span>
            <span title="<%= t('windLabel') %>">💨 <%= sea.wind != null ? Math.round(sea.wind) + ' km/s' : '—' %></span>
          </div>
        <% } else { %>
          <p class="text-3xl">🌊</p>
          <p class="text-sm text-zinc-400 mt-2"><%= t('seaSub') %></p>
        <% } %>
      </div>
      <a href="/deniz" class="see-all mt-auto pt-3"><%= t('seaTitle') %> ></a>
    </div>

    <div class="card flex flex-col">
      <h3 class="font-bold text-white mb-3 flex items-center gap-2">🌤️ <%= t('weatherTitle') %></h3>
      <div class="flex-1 flex flex-col items-center justify-center text-center py-2">
        <% var todayW = (typeof sea !== 'undefined' && sea && sea.days && sea.days[0]) ? sea.days[0] : null; %>
        <% if (todayW) { %>
          <div class="text-4xl"><%= todayW.icon %></div>
          <p class="text-2xl font-black text-white mt-1"><%= todayW.tempMax != null ? Math.round(todayW.tempMax) + '°' : '—' %> <span class="text-zinc-500 font-normal text-lg"><%= todayW.tempMin != null ? Math.round(todayW.tempMin) + '°' : '' %></span></p>
          <p class="text-sm text-zinc-400 mt-1"><%= todayW.desc %></p>
          <div class="flex items-center gap-4 mt-3 text-xs text-zinc-500">
            <span>💧<%= todayW.rain != null ? todayW.rain : 0 %>%</span>
            <span>💨<%= sea && sea.wind != null ? Math.round(sea.wind) + ' km/s' : '—' %></span>
          </div>
        <% } else { %>
          <p class="text-3xl">🌤️</p>
          <p class="text-sm text-zinc-400 mt-2"><%= t('weatherSub') %></p>
        <% } %>
      </div>
      <button type="button" onclick="openWeatherModal()" class="see-all mt-auto pt-3 text-left hover:text-emerald-400"><%= t('seaViewWeather') %></button>
    </div>

  </div>
</section>
<% } %>

<% if (places.length > 0) { %>
<section class="section">
  <div class="section-header">
    <h2>📍 <%= t('discover') %></h2>
    <a href="/mekanlar" class="see-all"><%= t('viewAllPlaces') %></a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% places.forEach(p => { %>
    <a href="/mekan/<%= p.slug || p.id %>" class="card place-card group block overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-900/70 hover:border-zinc-700 hover:bg-zinc-800/50 transition-all">
      <% if (p.main_image_url) { %><div class="card-image" style="background-image:url('<%= img(p.main_image_url) %>')"></div><% } else { %><div class="card-image" style="background-image:url('/img/fallback.webp')"></div><% } %>
      <div class="p-4">
        <span class="inline-flex items-center rounded-full border border-pink-500/20 bg-pink-500/10 px-2.5 py-0.5 text-xs font-medium text-pink-400"><%= p.type ? p.type.charAt(0).toUpperCase() + p.type.slice(1) : (p.category || t('place')) %></span>
        <h3 class="mt-2 mb-1 text-lg font-bold tracking-tight text-white"><%= p.name %></h3>
        <p class="text-sm leading-relaxed text-zinc-400 line-clamp-2"><%= cardExcerpt(p.description) %></p>
        <div class="mt-3 flex items-center justify-end gap-2 text-xs">
          <span class="font-medium text-zinc-400 transition-all group-hover:text-emerald-400 group-hover:drop-shadow-[0_0_6px_rgba(16,185,129,0.55)]"><%= t('viewDetails') %></span>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (typeof companies !== 'undefined' && companies.length > 0) { %>
<section class="section">
  <div class="section-header">
    <h2>🏢 <%= t('guide') %></h2>
    <a href="/rehber" class="see-all"><%= t('viewAllFirms') %></a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% companies.forEach(c => { %>
    <a href="/rehber/<%= c.slug || c.id %>" class="card place-card group block overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-900/70 hover:border-zinc-700 hover:bg-zinc-800/50 transition-all">
      <div class="h-52 flex items-center justify-center bg-gradient-to-br from-zinc-950 to-zinc-900 relative overflow-hidden">
        <% if (c.logo_url) { %>
          <img src="<%= img(c.logo_url) %>" alt="<%= c.name %>" loading="lazy" decoding="async" class="max-w-[85%] max-h-[80%] object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-lg">
        <% } else { %>
          <span class="text-5xl opacity-80 group-hover:scale-110 transition-transform duration-300">🏢</span>
        <% } %>
      </div>
      <div class="p-4 text-center">
        <h3 class="text-base font-bold tracking-tight text-white group-hover:text-emerald-400 transition-colors line-clamp-2"><%= c.name %></h3>
        <% if (c.sector) { %>
          <p class="text-white font-bold text-sm mt-1"><%= c.sector %></p>
        <% } %>
      </div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (typeof sightseeing !== 'undefined' && sightseeing.length > 0) { %>
<section class="section">
  <div class="section-header">
    <h2>🧳 <%= t('sightseeing') %></h2>
    <a href="/gezilecek-yerler" class="see-all"><%= t('viewAllSights') %></a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% sightseeing.forEach(s => { %>
    <a href="/gezilecek-yer/<%= s.slug || s.id %>" class="card place-card group block overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-900/70 hover:border-zinc-700 hover:bg-zinc-800/50 transition-all">
      <% if (s.image) { %><div class="card-image" style="background-image:url('<%= img(s.image) %>')"></div><% } else { %><div class="card-image flex items-center justify-center text-5xl" style="background:linear-gradient(135deg,#18181b,#09090b)">🧳</div><% } %>
      <div class="p-4">
        <span class="inline-flex items-center rounded-full border border-pink-500/20 bg-pink-500/10 px-2.5 py-0.5 text-xs font-medium text-pink-400"><%= s.category || t('trip') %></span>
        <h3 class="mt-2 mb-1 text-lg font-bold tracking-tight text-white"><%= s.title %></h3>
        <p class="text-sm leading-relaxed text-zinc-400 line-clamp-2"><%= s.summary || cardExcerpt(s.description) %></p>
        <div class="mt-3 flex items-center justify-between gap-2 text-xs">
          <span class="text-zinc-500 line-clamp-1" title="<%= s.location %>"><%= s.location ? '📍 ' + s.location : '📍 ' + t('cinarcik') %></span>
          <span class="shrink-0 font-medium text-zinc-400 transition-all group-hover:text-emerald-400 group-hover:drop-shadow-[0_0_6px_rgba(16,185,129,0.55)]"><%= t('discoverCta') %></span>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<section class="section" id="nobetci-eczaneler">
  <div class="grid grid-cols-1 gap-6 items-start">

    <!-- 💊 Nöbetçi Eczaneler -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg">
      <div class="p-4 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>💊</span> <%= t('pharmacies') %>
        </h2>
        <span class="text-xs text-zinc-500">
          <%= new Date().toLocaleDateString(t('dateLocale'), { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
        </span>
      </div>
      <div class="p-4 flex flex-wrap justify-center gap-4">
        <% if (typeof pharmacies !== 'undefined' && pharmacies.length > 0) { %>
          <% pharmacies.forEach(p => { %>
          <div class="w-full max-w-xl bg-zinc-950 border border-zinc-800 rounded-xl p-4 flex items-start gap-3 transition-colors hover:border-emerald-500/40">
            <span class="text-2xl leading-none mt-0.5">💊</span>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-white font-bold"><%= p.name %></h3>
                <span class="flex-shrink-0 inline-block bg-emerald-500/10 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide"><%= t('onDuty') %></span>
              </div>
              <% if (p.address) { %>
                <p class="text-zinc-400 text-sm mt-1.5">📍 <%= p.address %></p>
              <% } %>
              <% if (p.phone) { %>
                <a href="tel:<%= p.phone.replace(/\s/g, '') %>" class="inline-flex items-center gap-1.5 text-zinc-300 hover:text-emerald-400 text-sm mt-1 transition-colors">📞 <%= p.phone %></a>
              <% } %>
              <% if (p.duty_note) { %>
                <p class="text-xs text-zinc-500 mt-2">🕐 <%= t('dutyEnd') %>: <%= p.duty_note %></p>
              <% } %>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p class="text-zinc-500 text-sm text-center py-6">
            <%= t('noPharmacy') %>
          </p>
        <% } %>
      </div>
      <div class="px-4 pb-4 text-[11px] text-zinc-600">
        <%= t('dataSource') %>:
        <a href="https://www.istanbuleczaciodasi.org.tr/nobetci-eczane/#!Yalova/" target="_blank" rel="noopener" class="underline hover:text-zinc-400 transition-colors"><%= t('nobetciEczaneLink') %></a>
        <%= t('autoUpdated') %>
      </div>
    </div>

    <!-- ⛴️ Sefer Saatleri -->
    <div id="sefer-saatleri" class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg scroll-mt-24">
      <div class="p-4 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>⛴️</span> <%= t('turyolSchedule') %>
        </h2>
        <span class="text-xs text-zinc-500"><%= t('ferryRoute') %></span>
      </div>
      <div class="p-4 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% if (typeof ferryGroups !== 'undefined' && ferryGroups.length > 0) { %>
          <% ferryGroups.forEach(g => { %>
          <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-4 transition-colors hover:border-sky-500/40">
            <h3 class="text-white font-bold text-sm mb-1 flex items-center gap-2">
              <span class="text-sky-400">🚢</span> <%= g.title %>
            </h3>
            <p class="text-[10px] uppercase tracking-wide text-sky-500/70 font-semibold mb-3"><%= g.badge %></p>
            <div class="<%= g.items.length > 1 ? 'space-y-3' : '' %>">
              <% g.items.forEach(item => { %>
              <div>
                <% if (g.showLabel) { %>
                <p class="text-[11px] text-zinc-400 font-semibold mb-1.5"><%= item.label %></p>
                <% } %>
                <div class="grid grid-cols-3 gap-2 text-center">
                  <% item.columns.forEach(col => { %>
                  <div>
                    <p class="text-[10px] uppercase tracking-wide text-zinc-500 mb-1.5 font-semibold"><%= col.label %></p>
                    <div class="space-y-1">
                      <% if (col.times.length > 0) { %>
                        <% col.times.forEach(t => { %>
                          <span class="block bg-zinc-900 border border-zinc-800 rounded-lg py-1.5 px-2 text-sm text-sky-400 font-bold"><%= t %></span>
                        <% }) %>
                      <% } else { %>
                        <span class="block text-xs text-zinc-600 py-1.5">—</span>
                      <% } %>
                    </div>
                  </div>
                  <% }) %>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p class="text-zinc-500 text-sm text-center py-6">
            <%= t('noFerry') %>
          </p>
        <% } %>
        </div>

        <%
          var ferryPriceList = [];
          if (typeof ferryGroups !== 'undefined' && ferryGroups) {
            ferryGroups.forEach(function (gg) {
              gg.items.forEach(function (it) {
                (it.prices || []).forEach(function (pp) {
                  if (ferryPriceList.indexOf(pp) === -1) ferryPriceList.push(pp);
                });
              });
            });
          }
        %>
        <% if (ferryPriceList.length) { %>
        <button type="button" id="ferry-fee-btn" aria-expanded="false" aria-controls="ferry-fee-panel"
          class="w-full bg-zinc-950 hover:bg-zinc-900 border border-zinc-800 hover:border-sky-500/40 rounded-xl px-4 py-3 text-sm font-bold text-sky-400 transition-all flex items-center justify-between gap-2">
          <span>💰 <%= t('ferryFeesBtn') %></span>
          <span class="ferry-fee-caret text-zinc-500 transition-transform duration-200">▾</span>
        </button>
        <div id="ferry-fee-panel" class="hidden space-y-3">
          <% (typeof ferryGroups !== 'undefined' ? ferryGroups : []).forEach(function (gg) { %>
          <%
            var gp = [];
            gg.items.forEach(function (it) {
              (it.prices || []).forEach(function (pp) { if (gp.indexOf(pp) === -1) gp.push(pp); });
            });
          %>
          <% if (gp.length) { %>
          <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-4">
            <h3 class="text-white font-bold text-sm mb-2 flex items-center gap-2">
              <span class="text-sky-400">🚢</span> <%= gg.title %>
            </h3>
            <div class="flex flex-wrap gap-2">
              <% gp.forEach(function (pp) { %>
              <span class="inline-block bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-1.5 text-sm text-sky-400 font-bold"><%= pp %></span>
              <% }) %>
            </div>
          </div>
          <% } %>
          <% }) %>
        </div>
        <% } %>
      </div>
      <div class="px-4 pb-4 text-[11px] text-zinc-600">
        <%= t('dataSource') %>:
        <a href="https://www.turyol.com/Home/Tarifeler" target="_blank" rel="noopener" class="underline hover:text-zinc-400 transition-colors">Turyol Sefer Saatleri</a>
        <%= t('autoUpdated') %>
      </div>
    </div>

    <!-- 🚌 Şehir İçi Otobüs Seferleri -->
    <%
      var bJsDay = new Date().getDay();
      var bToday = bJsDay === 0 ? 7 : bJsDay;
      var bNow = new Date();
      var bNowMin = bNow.getHours() * 60 + bNow.getMinutes();
      var hasBus = typeof transport !== 'undefined' && transport && Array.isArray(transport.hatlar) && transport.hatlar.length > 0;
      var hasFees = typeof transport !== 'undefined' && transport && Array.isArray(transport.ucretler) && transport.ucretler.length > 0;
    %>
    <div id="otobus-saatleri" class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg scroll-mt-24">
      <div class="p-4 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>🚌</span> <%= t('busSchedule') %>
        </h2>
        <span class="text-xs text-zinc-500"><%= t('busRoute') %></span>
      </div>
      <div class="p-4 space-y-4">
        <% if (hasBus) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% transport.hatlar.forEach(hat => { %>
          <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-4 transition-colors hover:border-emerald-500/40">
            <h3 class="text-white font-bold text-sm mb-1 flex items-center gap-2">
              <span class="text-emerald-400">🚌</span> <%= hat.ad %>
            </h3>
            <% if (hat.aciklama) { %>
            <p class="text-[10px] uppercase tracking-wide text-emerald-500/70 font-semibold mb-3"><%= hat.aciklama %></p>
            <% } else { %>
            <div class="mb-1"></div>
            <% } %>
            <div class="space-y-3">
              <% (hat.kalkislar || []).forEach(k => { %>
              <%
                var todays = (k.seferler || []).filter(function (s) {
                  return (s.gunler || []).indexOf(bToday) !== -1;
                });
                var marked = false;
              %>
              <div>
                <p class="text-[11px] text-zinc-400 font-semibold mb-1.5"><%= k.yer %></p>
                <% if (todays.length) { %>
                <div class="time-chips flex flex-wrap gap-2">
                  <% todays.forEach(s => { %>
                  <%
                    var isPast = false;
                    var hm = String(s.saat || '').split(':');
                    if (hm.length >= 2) isPast = (Number(hm[0]) * 60 + Number(hm[1])) < bNowMin;
                    var chipCls = '';
                    if (isPast) chipCls = 'is-past';
                    else if (!marked) { chipCls = 'is-next'; marked = true; }
                  %>
                  <span class="time-chip <%= chipCls %>">
                    <b><%= s.saat %></b>
                    <span class="chip-note chip-next-label"><%= t('ulasimNext') %></span>
                    <% if (s.not) { %><span class="chip-note chip-real-note"><%= s.not %></span><% } %>
                  </span>
                  <% }) %>
                </div>
                <% } else { %>
                <p class="text-xs text-zinc-600"><%= t('busNoToday') %></p>
                <% } %>
              </div>
              <% }) %>
            </div>
          </div>
          <% }) %>
          </div>
        <% } else { %>
          <p class="text-zinc-500 text-sm text-center py-6"><%= t('ulasimEmpty') %></p>
        <% } %>

        <% if (hasFees) { %>
        <button type="button" id="bus-fee-btn" aria-expanded="false" aria-controls="bus-fee-panel"
          class="w-full bg-zinc-950 hover:bg-zinc-900 border border-zinc-800 hover:border-emerald-500/40 rounded-xl px-4 py-3 text-sm font-bold text-emerald-400 transition-all flex items-center justify-between gap-2">
          <span>💰 <%= t('busFeesBtn') %></span>
          <span class="bus-fee-caret text-zinc-500 transition-transform duration-200">▾</span>
        </button>
        <div id="bus-fee-panel" class="hidden space-y-4">
          <% transport.ucretler.forEach(u => { %>
          <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-4">
            <h3 class="text-white font-bold text-sm mb-3"><%= u.baslik %></h3>
            <div class="space-y-2">
              <% (u.satirlar || []).forEach(s => { %>
              <div class="flex items-start justify-between gap-3 text-sm border-b border-zinc-800/70 pb-2 last:border-0 last:pb-0">
                <span class="text-zinc-300"><%= s.ad %></span>
                <span class="text-emerald-400 font-bold whitespace-nowrap"><%= s.tutar %></span>
              </div>
              <% }) %>
            </div>
            <% if (u.not) { %>
            <p class="text-[11px] text-zinc-500 mt-3 leading-relaxed"><%= u.not %></p>
            <% } %>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
      <div class="px-4 pb-4">
        <a href="<%= lp %>/ulasim" class="block bg-zinc-950 hover:bg-zinc-900 border border-zinc-800 hover:border-emerald-500/40 rounded-xl px-4 py-3 text-sm font-bold text-emerald-400 transition-all">🚌 <%= t('busDetailLink') %> →</a>
      </div>
      <div class="px-4 pb-4 text-[11px] text-zinc-600">
        <%= t('dataSource') %>:
        <a href="https://cinarcik.bel.tr/cinarcik/ulasim" target="_blank" rel="noopener" class="underline hover:text-zinc-400 transition-colors">Çınarcık Belediyesi — Ulaşım</a>
        <%= t('autoUpdated') %><% if (transport && transport.updatedAt) { %> · <%= t('lastUpdate') %>: <%= String(transport.updatedAt).slice(0, 16).replace('T', ' ') %><% } %>
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  [['ferry-fee-btn', 'ferry-fee-panel'], ['bus-fee-btn', 'bus-fee-panel']].forEach(function (pair) {
    var btn = document.getElementById(pair[0]);
    var panel = document.getElementById(pair[1]);
    if (!btn || !panel) return;
    btn.addEventListener('click', function () {
      var hidden = panel.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', hidden ? 'false' : 'true');
      var caret = btn.querySelector('.ferry-fee-caret, .bus-fee-caret');
      if (caret) caret.style.transform = hidden ? '' : 'rotate(180deg)';
    });
  });
})();
</script>

<script>
(function(){
  var lp = "<%= lp %>";
  // Haberler sunucu tarafında basıldı: admin'de yapılan her değişiklik
  // ana sayfada da aynen görünür, ayrı bir API/fetch adımı yoktur.
  var headlines = <%- JSON.stringify((headlines || []).map(function(n){ return { id:n.id, slug:n.slug, title:n.title, badge_text:n.badge_text, summary:n.summary, main_image_url:n.main_image_url }; })).replace(/</g, '\\u003c') %>;
  headlines.forEach(function(h) { if (h.main_image_url) { var im = new Image(); im.src = h.main_image_url; } });
  var current = 0;
  var autoplay = true;
  var timerId = null;

  var el = {
    bg: document.getElementById('slider-bg'),
    badge: document.getElementById('slider-badge'),
    title: document.getElementById('slider-title'),
    summary: document.getElementById('slider-summary'),
    link: document.getElementById('slider-link'),
    slider: document.getElementById('headline-slider'),
    prev: document.getElementById('slider-prev'),
    next: document.getElementById('slider-next'),
    nav: document.getElementById('manset-nav')
  };

  var defaultImg = 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80';

  function updateNavButtons() {
    if (!el.nav) return;
    var btns = el.nav.querySelectorAll('.manset-nav-btn');
    btns.forEach(function(btn, i) {
      if (i === current) {
        btn.classList.add('active', 'bg-red-600', 'text-white');
        btn.classList.remove('bg-zinc-800/80', 'text-zinc-300');
      } else {
        btn.classList.remove('active', 'bg-red-600', 'text-white');
        btn.classList.add('bg-zinc-800/80', 'text-zinc-300');
      }
    });
  }

  function show(index) {
    if (headlines.length === 0) return;
    current = Math.max(0, Math.min(index, headlines.length - 1));
    var h = headlines[current];

    el.bg.style.opacity = '0';
    setTimeout(function() {
      var src = h.main_image_url || defaultImg;
      // CSS url() içinde boşluk/Türkçe karakter 404'e yol açıyordu.
      try { src = encodeURI(src); } catch (e) {}
      el.bg.style.backgroundImage = 'url("' + src.replace(/"/g, '%22') + '")';
      el.bg.style.opacity = '1';
    }, 80);

    var textEl = document.getElementById('slider-text');
    if (textEl) textEl.style.opacity = '0';
    setTimeout(function() {
      if (h.badge_text && h.badge_text.trim()) {
        el.badge.textContent = h.badge_text;
        el.badge.classList.remove('hidden');
      } else {
        el.badge.classList.add('hidden');
      }
      el.title.textContent = h.title;
      el.summary.textContent = h.summary || '';
      el.link.href = lp + '/haber/' + (h.slug || h.id);
      if (textEl) textEl.style.opacity = '1';
    }, 100);

    updateNavButtons();
  }

  function startAuto() {
    if (timerId) clearInterval(timerId);
    if (autoplay) {
      timerId = setInterval(function() { show(current + 1 >= headlines.length ? 0 : current + 1); }, 5000);
    }
  }

  function build() {
    if (headlines.length === 0) return;
    var navBtns = el.nav ? el.nav.querySelectorAll('.manset-nav-btn') : [];
    navBtns.forEach(function(btn, i) {
      btn.addEventListener('click', function() {
        show(i);
        startAuto();
      });
    });
    show(0);
    startAuto();
  }

  function next() { show(current + 1 >= headlines.length ? 0 : current + 1); }
  function prev() { show(current - 1 < 0 ? headlines.length - 1 : current - 1); }

  el.prev.addEventListener('click', function() { prev(); startAuto(); });
  el.next.addEventListener('click', function() { next(); startAuto(); });

  el.slider.addEventListener('mouseenter', function() { if (timerId) clearInterval(timerId); });
  el.slider.addEventListener('mouseleave', function() { startAuto(); });

  if (el.slider) build();
})();
</script>

<script>
(function(){
  var slides = Array.prototype.slice.call(document.querySelectorAll('#hero-bgs .hero-bg'));
  if (!slides.length) return;

  var dotsWrap = document.getElementById('hero-dots');
  var content = document.getElementById('hero-content');
  var title = document.getElementById('hero-title');
  var sub = document.getElementById('hero-sub');
  var ctas = document.getElementById('hero-ctas');
  var current = 0;
  var timer = null;

  function renderCta(i) {
    if (!ctas) return;
    var raw = slides[i].getAttribute('data-cta');
    if (!raw) return;
    var items;
    try { items = JSON.parse(raw); } catch (e) { return; }
    if (!items || !items.length) return;
    var html = '';
    items.forEach(function(b) {
      var cls = b.primary
        ? 'bg-emerald-600 hover:bg-emerald-500 transition font-bold px-5 py-2.5 rounded-lg text-sm'
        : 'bg-white/10 hover:bg-white/20 backdrop-blur-md transition font-bold px-5 py-2.5 rounded-lg text-sm';
      html += '<a href="' + b.href + '" class="' + cls + '">' + b.label + '</a>';
    });
    ctas.innerHTML = html;
  }

  slides.forEach(function(_, i) {
    var d = document.createElement('button');
    d.type = 'button';
    d.className = 'hero-dot' + (i === 0 ? ' on' : '');
    d.setAttribute('aria-label', (i + 1) + ". <%= t('imageWord') %>");
    d.addEventListener('click', function() { show(i); restart(); });
    dotsWrap.appendChild(d);
  });
  var dots = dotsWrap.querySelectorAll('.hero-dot');

  function show(i) {
    current = (i + slides.length) % slides.length;
    slides.forEach(function(s, idx) { s.classList.toggle('on', idx === current); });
    dots.forEach(function(d, idx) { d.classList.toggle('on', idx === current); });
    if (content) content.style.opacity = '0';
    setTimeout(function() {
      if (title) title.textContent = slides[current].getAttribute('data-title') || "<%= t('cinarcik') %>";
      if (sub) sub.textContent = slides[current].getAttribute('data-sub') || '';
      renderCta(current);
      if (content) content.style.opacity = '1';
    }, 300);
  }

  function restart() {
    clearInterval(timer);
    timer = setInterval(function() { show(current + 1); }, 7500);
  }

  document.getElementById('hero-next').addEventListener('click', function() { show(current + 1); restart(); });
  document.getElementById('hero-prev').addEventListener('click', function() { show(current - 1); restart(); });

  var hero = document.getElementById('hero');
  hero.addEventListener('mouseenter', function() { clearInterval(timer); });
  hero.addEventListener('mouseleave', restart);

  renderCta(0);
  restart();
})();
</script>