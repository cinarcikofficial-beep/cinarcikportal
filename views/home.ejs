                  <div>
                    <p class="text-[10px] uppercase tracking-wide text-zinc-500 mb-1.5 font-semibold"><%= col.label %></p>
                    <div class="space-y-1">
                      <% if (col.times.length > 0) { %>
                        <% col.times.forEach(t => { %>
                          <span class="block bg-zinc-900 border border-zinc-800 rounded-lg py-1.5 px-2 text-sm text-sky-400 font-bold"><%= t %></span>
                        <% }) %>
                      <% } else { %>
                        <span class="block text-xs text-zinc-600 py-1.5">—</span>
                      <% } %>
                    </div>
                  </div>
                  <% }) %>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p class="text-zinc-500 text-sm text-center py-6">
            <%= t('noFerry') %>
          </p>
        <% } %>
      </div>
      <div class="px-4 pb-4 text-[11px] text-zinc-600">
        <%= t('dataSource') %>:
        <a href="https://www.turyol.com/Home/Tarifeler" target="_blank" rel="noopener" class="underline hover:text-zinc-400 transition-colors">Turyol Sefer Saatleri</a>
        <%= t('autoUpdated') %>
      </div>
    </div>

  </div>
</section>

<script>
(function(){
  var headlines = [];
  var current = 0;
  var autoplay = true;
  var timerId = null;

  var el = {
    bg: document.getElementById('slider-bg'),
    badge: document.getElementById('slider-badge'),
    title: document.getElementById('slider-title'),
    summary: document.getElementById('slider-summary'),
    link: document.getElementById('slider-link'),
    slider: document.getElementById('headline-slider'),
    prev: document.getElementById('slider-prev'),
    next: document.getElementById('slider-next'),
    nav: document.getElementById('manset-nav')
  };

  var defaultImg = 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80';

  function updateNavButtons() {
    if (!el.nav) return;
    var btns = el.nav.querySelectorAll('.manset-nav-btn');
    btns.forEach(function(btn, i) {
      if (i === current) {
        btn.classList.add('active');
        btn.classList.remove('bg-zinc-800/80', 'text-zinc-300');
      } else {
        btn.classList.remove('active');
        btn.classList.add('bg-zinc-800/80', 'text-zinc-300');
      }
    });
  }

  function show(index) {
    if (headlines.length === 0) return;
    current = Math.max(0, Math.min(index, headlines.length - 1));
    var h = headlines[current];

    el.bg.style.opacity = '0';
    setTimeout(function() {
      el.bg.style.backgroundImage = 'url(' + (h.main_image_url || defaultImg) + ')';
      el.bg.style.opacity = '1';
    }, 200);

    var textEl = document.getElementById('slider-text');
    if (textEl) textEl.style.opacity = '0';
    setTimeout(function() {
      if (h.badge_text && h.badge_text.trim()) {
        el.badge.textContent = h.badge_text;
        el.badge.classList.remove('hidden');
      } else {
        el.badge.classList.add('hidden');
      }
      el.title.textContent = h.title;
      el.summary.textContent = h.summary || '';
      el.link.href = '/haber/' + (h.slug || h.id);
      if (textEl) textEl.style.opacity = '1';
    }, 250);

    updateNavButtons();
  }

  function startAuto() {
    if (timerId) clearInterval(timerId);
    if (autoplay) {
      timerId = setInterval(function() { show(current + 1 >= headlines.length ? 0 : current + 1); }, 5000);
    }
  }

  function build() {
    fetch('/api/news?limit=5')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        headlines = data.news || [];
        if (headlines.length === 0) return;
        var navBtns = el.nav ? el.nav.querySelectorAll('.manset-nav-btn') : [];
        navBtns.forEach(function(btn, i) {
          btn.addEventListener('click', function() {
            show(i);
            startAuto();
          });
        });
        show(0);
        startAuto();
      });
  }

  function next() { show(current + 1 >= headlines.length ? 0 : current + 1); }
  function prev() { show(current - 1 < 0 ? headlines.length - 1 : current - 1); }

  el.prev.addEventListener('click', function() { prev(); startAuto(); });
  el.next.addEventListener('click', function() { next(); startAuto(); });

  el.slider.addEventListener('mouseenter', function() { if (timerId) clearInterval(timerId); });
  el.slider.addEventListener('mouseleave', function() { startAuto(); });

  if (el.slider) build();
})();
</script>

<script>
(function(){
  var slides = Array.prototype.slice.call(document.querySelectorAll('#hero-bgs .hero-bg'));
  if (!slides.length) return;

  var dotsWrap = document.getElementById('hero-dots');
  var content = document.getElementById('hero-content');
  var title = document.getElementById('hero-title');
  var sub = document.getElementById('hero-sub');
  var current = 0;
  var timer = null;

  slides.forEach(function(_, i) {
    var d = document.createElement('button');
    d.type = 'button';
    d.className = 'hero-dot' + (i === 0 ? ' on' : '');
    d.setAttribute('aria-label', (i + 1) + ". <%= t('imageWord') %>");
    d.addEventListener('click', function() { show(i); restart(); });
    dotsWrap.appendChild(d);
  });
  var dots = dotsWrap.querySelectorAll('.hero-dot');

  function show(i) {
    current = (i + slides.length) % slides.length;
    slides.forEach(function(s, idx) { s.classList.toggle('on', idx === current); });
    dots.forEach(function(d, idx) { d.classList.toggle('on', idx === current); });
    if (content) content.style.opacity = '0';
    setTimeout(function() {
      if (title) title.textContent = slides[current].getAttribute('data-title') || "<%= t('cinarcik') %>";
      if (sub) sub.textContent = slides[current].getAttribute('data-sub') || '';
      if (content) content.style.opacity = '1';
    }, 300);
  }

  function restart() {
    clearInterval(timer);
    timer = setInterval(function() { show(current + 1); }, 7500);
  }

  document.getElementById('hero-next').addEventListener('click', function() { show(current + 1); restart(); });
  document.getElementById('hero-prev').addEventListener('click', function() { show(current - 1); restart(); });

  var hero = document.getElementById('hero');
  hero.addEventListener('mouseenter', function() { clearInterval(timer); });
  hero.addEventListener('mouseleave', restart);

  restart();
})();
</script>