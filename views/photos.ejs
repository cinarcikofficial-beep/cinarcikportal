<% layout('partials/layout') %>
<% locals.pageTitle = t('photosTitle') %>

<div class="page-banner">
  <h1>📷 <%= t('photosTitle') %></h1>
  <p><%= t('photosSub') %></p>
</div>

<style>
  #photo-captcha-img { cursor: pointer; }
  #photo-modal.show { display: flex; }
  html.light #photo-modal .modal-card { background: #ffffff !important; border-color: #e2e8f0 !important; color: #0f172a !important; }
  html.light #photo-modal input, html.light #photo-modal textarea, html.light #photo-modal select { background-color: #ffffff !important; color: #0f172a !important; border-color: #cbd5e1 !important; }
  .photo-flash { animation: photoFlash 1.6s ease-in-out infinite; }
  @keyframes photoFlash {
    0%, 100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); filter: brightness(1); }
    50% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); filter: brightness(1.15); }
  }
  @media (prefers-reduced-motion: reduce) { .photo-flash { animation: none; } }
  html.light .photo-card { background: #ffffff !important; border-color: #e2e8f0 !important; }
  html.light .photo-card h2 { color: #0f172a !important; }
  html.light .photo-card p { color: #475569 !important; }
  html.light .photo-views-chip { background: #f1f5f9 !important; color: #475569 !important; }
  html.light .photo-share { background: #f1f5f9 !important; color: #334155 !important; }
  html.light .photo-share:hover { background: #e2e8f0 !important; color: #0f172a !important; }
</style>

<section class="section">
  <div class="max-w-6xl mx-auto">
    <% if (sent) { %>
      <div class="bg-emerald-950/60 border border-emerald-800/60 text-emerald-300 text-sm rounded-xl px-4 py-3 mb-5"><%= t('photosReceived') %></div>
    <% } %>

    <div class="flex items-center justify-end mb-6">
      <button type="button" id="open-photo-modal-btn"
        class="photo-flash inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition-all cursor-pointer shadow-lg shadow-emerald-950/40">
        <span>📷</span>
        <span><%= t('photosShareTitle') %></span>
      </button>
    </div>

    <% if (photos && photos.length) { %>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <% photos.forEach(function(p) { %>
          <figure class="photo-card group bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg">
            <div class="aspect-[4/3] overflow-hidden bg-zinc-950">
              <img src="<%= img(p.image) %>" alt="<%= p.title %>" loading="lazy" decoding="async" data-photo-id="<%= p.id %>"
                class="ann-zoom w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
            </div>
            <figcaption class="p-3">
              <h2 class="text-white font-bold text-sm line-clamp-2 min-h-[2.5rem]"><%= p.title %></h2>
              <% if (p.description) { %>
                <p class="text-zinc-400 text-xs mt-1 line-clamp-3"><%= p.description %></p>
              <% } %>
              <div class="mt-2 flex flex-wrap items-center justify-between gap-x-2 gap-y-1.5">
                <span class="inline-flex items-center">
                  <button type="button" class="fav-btn" data-fav data-fav-type="photos" data-fav-id="<%= p.id %>"
                    data-fav-url="/sizlerden-gelen" data-fav-title="<%= p.title %>" data-fav-img="<%= img(p.image) %>" aria-pressed="false"></button>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="photo-views-chip inline-flex items-center gap-1 text-zinc-400 text-[11px] px-2 py-1 rounded-lg bg-zinc-800/60" title="<%= t('views') %>">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 28 24"><path stroke-linecap="round" stroke-linejoin="round" d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <span class="photo-views" data-photo-id="<%= p.id %>"><%= Number(p.views_count) || 0 %></span>
                  </span>
                  <a href="https://wa.me/?text=<%= encodeURIComponent((p.title || '') + ' — https://marmaraninincisi.com' + (typeof lp !== 'undefined' && lp ? lp : '') + '/sizlerden-gelen') %>"
                    target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center justify-center w-7 h-7 bg-[#25D366]/10 hover:bg-[#25D366] text-[#25D366] hover:text-white rounded-lg transition-colors"
                    title="<%= t('shareWhatsapp') %>">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12.001 2C6.477 2 2 6.477 2 12.001c0 1.77.464 3.426 1.276 4.864L2 22l5.29-1.243A9.943 9.943 0 0 0 12.001 22C17.525 22 22 17.525 22 12.001 22 6.477 17.525 2 12.001 2zm5.925 14.19a1.617 1.617 0 0 1-.86 1.15c-.63.333-1.518.47-2.452-.086-1.51-.886-2.418-1.6-3.528-2.71-1.11-1.11-1.824-2.018-2.71-3.528-.556-.934-.42-1.822-.086-2.452.26-.493.66-.762 1.15-.86.188-.037.439-.01.63.06.193.071.421.217.53.384.115.174.48 1.16.553 1.335.073.175.122.302.078.48a2.72 2.72 0 0 1-.2.486c-.084.148-.212.366-.19.546.027.206.168.51.565.98.397.47.63.676.86.84.146.103.321.062.565-.057.244-.12.482-.308.672-.28.167.024.354.186.508.354.154.168.448.447.565.565.117.117.4.52.488.565.087.045.213.053.32.026z"/></svg>
                  </a>
                  <button type="button" class="photo-share inline-flex items-center justify-center w-7 h-7 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white rounded-lg transition-colors cursor-pointer"
                    data-ps-title="<%= p.title %>" title="<%= t('shareNative') %>">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.42" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                  </button>
                </span>
              </div>
              <% if (p.author_name) { %>
                <p class="text-zinc-500 text-[11px] mt-1.5"><%= t('photosBy') %> <%= p.author_name %></p>
              <% } %>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center text-zinc-500 text-sm py-10"><%= t('photosEmpty') %></div>
    <% } %>
  </div>
</section>

<!-- Fotoğraf Paylaşım Modal / Popup (İlan Ver tarzı) -->
<div id="photo-modal" class="fixed inset-0 z-[120] hidden items-center justify-center p-3 sm:p-4 overflow-y-auto bg-black/80 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="photo-modal-title">
  <div class="modal-card max-w-xl w-full bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl p-5 sm:p-7 relative my-8 transition-all transform scale-95 opacity-0 duration-200" id="photo-modal-box">

    <!-- Modal Header -->
    <div class="flex items-start justify-between gap-4 pb-4 border-b border-zinc-800/80">
      <div>
        <h2 id="photo-modal-title" class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>📷</span>
          <span><%= t('photosShareTitle') %></span>
        </h2>
        <p class="text-zinc-400 text-xs sm:text-sm mt-1"><%= t('listingModerationNote') %></p>
      </div>
      <button type="button" id="close-photo-modal-btn"
        class="text-zinc-400 hover:text-white bg-zinc-800 hover:bg-zinc-700 w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-base font-bold cursor-pointer"
        aria-label="<%= t('cancel') %>">&times;</button>
    </div>

    <!-- Alert Box (hata / başarı mesajları) -->
    <div id="photo-modal-alert" class="hidden my-4 p-3.5 rounded-xl text-sm font-medium"></div>

    <!-- Form -->
    <form id="photo-modal-form" action="/sizlerden-gelen" method="POST" enctype="multipart/form-data" data-i18n-validate class="space-y-4 pt-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div>
          <label for="user_name" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('nameLabel') %></label>
          <input type="text" id="user_name" name="user_name" required minlength="2" maxlength="80"
            value="<%= form.user_name || form.name || (user ? user.name : '') %>"
            placeholder="Adınız Soyadınız"
            class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
        </div>
        <div>
          <label for="user_email" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('emailLabel') %> <span class="text-red-400">*</span></label>
          <input type="email" id="user_email" name="user_email" required maxlength="120"
            value="<%= form.user_email || form.email || (user ? user.email : '') %>"
            placeholder="ornek@email.com"
            class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
        </div>
      </div>

      <div>
        <label for="title" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('titleLabel') %> <span class="text-red-400">*</span></label>
        <input type="text" id="title" name="title" required minlength="3" maxlength="120"
          value="<%= form.title || '' %>"
          placeholder="<%= t('titleLabel') %>"
          class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
      </div>

      <div>
        <label for="description" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('descLabel') %></label>
        <textarea id="description" name="description" rows="4" maxlength="2000"
          placeholder="<%= t('descLabel') %>"
          class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors resize-y"><%= form.description || '' %></textarea>
      </div>

      <div>
        <label for="image" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('photoLabel') %> <span class="text-red-400">*</span></label>
        <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required
          class="w-full bg-zinc-950 text-zinc-400 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-zinc-800 file:text-zinc-300 file:text-xs hover:file:bg-zinc-700 file:cursor-pointer">
        <div id="photo-image-info" class="hidden mt-2 flex items-center gap-2 text-xs text-zinc-400">
          <span id="photo-image-name" class="truncate max-w-[16rem]"></span>
          <button type="button" id="photo-image-clear" class="text-zinc-500 hover:text-red-400 font-bold cursor-pointer">&times;</button>
        </div>
        <p class="text-xs text-zinc-500 mt-1"><%= t('photoHint') %></p>
      </div>

      <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-4">
        <label class="block text-zinc-400 text-sm mb-2" for="captcha"><%= t('securityCode') %></label>
        <div class="flex items-center gap-3 flex-wrap">
          <img id="photo-captcha-img" src="<%= captchaImage %>" alt="<%= t('securityCodeAlt') %>"
            title="<%= t('refresh') %>"
            class="h-[54px] w-[170px] rounded-lg border border-zinc-800 select-none cursor-pointer">
          <input id="captcha" type="text" name="captcha" required maxlength="5" autocomplete="off"
            inputmode="text" autocapitalize="characters" spellcheck="false"
            placeholder="<%= t('captchaPlaceholder') %>"
            class="w-40 bg-zinc-900 text-white border border-zinc-800 rounded-xl px-4 py-3 text-sm uppercase tracking-widest placeholder-zinc-600 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
          <button type="button" id="photo-captcha-refresh"
            class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-3.5 py-3 rounded-xl text-xs font-bold transition cursor-pointer"><%= t('refresh') %></button>
        </div>
        <p class="text-zinc-600 text-xs mt-2"><%= t('captchaNote') %></p>
      </div>

      <button type="submit" id="photo-submit-btn"
        class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm py-3.5 rounded-xl transition-all shadow-lg shadow-emerald-950/40 cursor-pointer flex items-center justify-center gap-2">
        <svg id="photo-submit-spinner" class="hidden animate-spin h-4 w-4 text-white" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <span id="photo-submit-text"><%= t('photosShareTitle') %></span>
      </button>
    </form>
  </div>
</div>

<script>
(function () {
  var modal = document.getElementById('photo-modal');
  var box = document.getElementById('photo-modal-box');
  var openBtn = document.getElementById('open-photo-modal-btn');
  var closeBtn = document.getElementById('close-photo-modal-btn');
  var form = document.getElementById('photo-modal-form');
  var alertBox = document.getElementById('photo-modal-alert');
  var captchaImg = document.getElementById('photo-captcha-img');
  var captchaRefresh = document.getElementById('photo-captcha-refresh');
  var captchaInput = document.getElementById('captcha');
  var imageInput = document.getElementById('image');
  var imageInfo = document.getElementById('photo-image-info');
  var imageName = document.getElementById('photo-image-name');
  var imageClear = document.getElementById('photo-image-clear');
  var submitBtn = document.getElementById('photo-submit-btn');
  var submitText = document.getElementById('photo-submit-text');
  var submitSpinner = document.getElementById('photo-submit-spinner');
  if (!modal || !form) return;

  function refreshCaptcha() {
    if (captchaImg) captchaImg.src = '/captcha.svg?t=' + Date.now();
    if (captchaInput) captchaInput.value = '';
  }

  function showAlert(msg, isSuccess) {
    if (!alertBox) return;
    alertBox.className = isSuccess
      ? 'my-4 p-3.5 rounded-xl text-sm font-medium bg-emerald-950/80 border border-emerald-800 text-emerald-300'
      : 'my-4 p-3.5 rounded-xl text-sm font-medium bg-red-950/80 border border-red-800 text-red-300';
    alertBox.textContent = msg;
    alertBox.classList.remove('hidden');
    alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideAlert() {
    if (alertBox) {
      alertBox.textContent = '';
      alertBox.classList.add('hidden');
    }
  }

  function openModal() {
    hideAlert();
    refreshCaptcha();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function () {
      if (box) {
        box.classList.remove('scale-95', 'opacity-0');
        box.classList.add('scale-100', 'opacity-100');
      }
    });
    var firstInput = document.getElementById('user_name');
    if (firstInput && !firstInput.value) firstInput.focus();
    else document.getElementById('title').focus();
  }

  function closeModal() {
    if (box) {
      box.classList.remove('scale-100', 'opacity-100');
      box.classList.add('scale-95', 'opacity-0');
    }
    setTimeout(function () {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      hideAlert();
    }, 150);
  }

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  modal.addEventListener('click', function (e) {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
  });

  if (captchaImg) captchaImg.addEventListener('click', refreshCaptcha);
  if (captchaRefresh) captchaRefresh.addEventListener('click', refreshCaptcha);

  if (imageInput && imageInfo && imageName) {
    imageInput.addEventListener('change', function () {
      if (this.files && this.files[0]) {
        imageName.textContent = this.files[0].name;
        imageInfo.classList.remove('hidden');
      } else {
        imageInfo.classList.add('hidden');
      }
    });
  }

  if (imageClear && imageInput && imageInfo) {
    imageClear.addEventListener('click', function () {
      imageInput.value = '';
      imageInfo.classList.add('hidden');
    });
  }

  // Sunucudan hata geldiğinde (i18n yok, düz metin) form açık kalır, mesaj alert kutusunda gösterilir
  <% if (typeof error !== 'undefined' && error) { %>
  window.addEventListener('DOMContentLoaded', function () {
    showAlert(<%= JSON.stringify(error) %>, false);
    openModal();
  });
  <% } %>

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    hideAlert();

    var fd = new FormData(form);
    submitBtn.disabled = true;
    submitText.textContent = '<%= t("sending") %>';
    submitSpinner.classList.remove('hidden');

    fetch(form.action, {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: fd
    })
      .then(function (res) {
        return res.json().then(function (data) {
          return { ok: res.ok, data: data };
        }).catch(function () {
          return { ok: res.ok, data: {} };
        });
      })
      .then(function (result) {
        submitBtn.disabled = false;
        submitText.textContent = '<%= t("photosShareTitle") %>';
        submitSpinner.classList.add('hidden');

        if (result.ok && result.data.success) {
          showAlert(result.data.message || '<%= t("photosReceived") %>', true);
          if (window.adminToast) window.adminToast(result.data.message || '<%= t("photosReceived") %>', 'success');
          form.reset();
          if (imageInfo) imageInfo.classList.add('hidden');
          refreshCaptcha();
          setTimeout(closeModal, 1600);
        } else {
          var err = (result.data && result.data.error) ? result.data.error : '<%= t("errorOccurred") %>';
          showAlert(err, false);
          if (window.adminToast) window.adminToast(err, 'error');
          refreshCaptcha();
        }
      })
      .catch(function (err) {
        submitBtn.disabled = false;
        submitText.textContent = '<%= t("photosShareTitle") %>';
        submitSpinner.classList.add('hidden');
        var msg = '<%= t("connError") %>: ' + (err.message || '');
        showAlert(msg, false);
        refreshCaptcha();
      });
  });

  // Lightbox açılışında fotoğraf görüntülenme sayacı (sayfa başına görsel başına 1 kez)
  var seenViews = {};
  document.addEventListener('click', function (e) {
    var im = e.target && e.target.closest ? e.target.closest('.photo-card img[data-photo-id]') : null;
    if (!im) return;
    var id = im.getAttribute('data-photo-id');
    if (!id || seenViews[id]) return;
    seenViews[id] = true;
    fetch('/api/foto-gor/' + id, { method: 'POST', headers: { 'Accept': 'application/json' } }).catch(function () {});
    var chip = document.querySelector('.photo-views[data-photo-id="' + id + '"]');
    if (chip) chip.textContent = (parseInt(chip.textContent, 10) || 0) + 1;
  });

  // Kart paylaş: navigator.share (telefon), desteklenmiyorsa panoya kopyala
  document.addEventListener('click', function (e) {
    var b = e.target && e.target.closest ? e.target.closest('.photo-share') : null;
    if (!b) return;
    e.preventDefault();
    var title = b.getAttribute('data-ps-title') || document.title;
    var url = location.origin + location.pathname;
    if (navigator.share) {
      navigator.share({ title: title, url: url }).catch(function () {});
    } else if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(function () {
        if (window.adminToast) window.adminToast('<%= t("linkCopied") %>', 'success');
      }).catch(function () {});
    } else if (window.adminToast) {
      window.adminToast(url, 'info');
    }
  });
})();
</script>

<%- include('partials/zoom-lightbox') %>
