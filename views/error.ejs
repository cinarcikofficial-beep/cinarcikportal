<% layout('partials/layout') %>
<% locals.pageTitle = title || t('errorTitle') %>

<div class="max-w-lg mx-auto mt-20 px-4">
  <div class="bg-zinc-900/80 rounded-2xl p-8 border border-red-500/30 text-center">
    <div class="text-5xl mb-4">⚠️</div>
    <h1 class="text-2xl font-bold text-white mb-3"><%= title || t('defaultError') %></h1>
    <p class="text-zinc-400 text-sm mb-6"><%= message %></p>

    <% if (error === 'invalid_client' || error === 'client_id_missing') { %>
    <div class="bg-zinc-950 rounded-xl p-4 mb-6 text-left border border-zinc-800">
      <p class="text-zinc-300 text-xs font-mono mb-2"><%= t('errorDetail') %></p>
      <code class="text-red-400 text-xs">Error 401: invalid_client</code>
      <p class="text-zinc-500 text-xs mt-3">
        <%= t('oauthErrorHelp') %>
      </p>
    </div>
    <% } %>

    <div class="flex gap-3 justify-center">
      <a href="/haberler" class="bg-zinc-800 hover:bg-zinc-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition">
        <%= t('backToNews') %>
      </a>
      <a href="javascript:history.back()" class="bg-red-600 hover:bg-red-500 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition">
        <%= t('goBack') %>
      </a>
    </div>
  </div>
</div>
