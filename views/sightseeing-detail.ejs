<% layout('partials/layout') %>
<% locals.pageTitle = item.title %>

<style>
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #sl-lightbox { position: fixed; inset: 0; z-index: 90; display: none; align-items: center; justify-content: center; background: rgba(0,0,0,.88); padding: 1.5rem; }
  #sl-lightbox.open { display: flex; }
  #sl-lightbox img { max-width: 100%; max-height: 85vh; border-radius: 12px; box-shadow: 0 25px 60px rgba(0,0,0,.6); }
  #sl-lb-close { position: absolute; top: 1.1rem; right: 1.4rem; color: #fff; font-size: 2rem; cursor: pointer; line-height: 1; opacity: .8; z-index: 3; }
  #sl-lb-close:hover { opacity: 1; }
  .sl-lb-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 3rem; height: 3rem; border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(39, 39, 42, .85); color: #fff; font-size: 2rem; line-height: 1;
    border: 1px solid rgba(255, 255, 255, .15); cursor: pointer; z-index: 3;
    transition: background .2s ease, transform .2s ease;
  }
  .sl-lb-nav:hover { background: rgba(16, 185, 129, .9); transform: translateY(-50%) scale(1.06); }
  #sl-lb-prev { left: 1rem; }
  #sl-lb-next { right: 1rem; }
  #sl-lb-counter {
    position: absolute; bottom: 1.2rem; left: 50%; transform: translateX(-50%);
    background: rgba(9, 9, 11, .8); border: 1px solid #3f3f46; color: #e4e4e7;
    font-size: .75rem; font-weight: 700; padding: .35rem .85rem; border-radius: 999px; z-index: 3;
  }
  .sl-thumb { cursor: zoom-in; transition: transform .3s ease, opacity .3s ease; }
  .sl-thumb:hover { transform: scale(1.03); opacity: .9; }
</style>

<div class="max-w-6xl mx-auto px-4 py-8">

  <!-- Breadcrumb -->
  <nav class="text-xs text-zinc-500 mb-5 flex items-center gap-2 flex-wrap">
    <a href="/" class="hover:text-emerald-400 transition"><%= t('home') %></a>
    <span>/</span>
    <a href="/gezilecek-yerler" class="hover:text-emerald-400 transition"><%= t('sightseeing') %></a>
    <span>/</span>
    <span class="text-zinc-300"><%= item.title %></span>
  </nav>

  <!-- Hero -->
  <div class="relative rounded-2xl overflow-hidden border border-zinc-800/80 bg-zinc-900 mb-6">
    <% const heroImg = item.image || (item.gallery && item.gallery.length ? item.gallery[0] : ''); %>
    <% if (heroImg) { %>
    <img src="<%= heroImg %>" alt="<%= item.title %>" class="w-full h-64 md:h-96 object-cover">
    <% } else { %>
    <div class="w-full h-56 md:h-72 flex items-center justify-center text-7xl bg-gradient-to-br from-zinc-800 to-zinc-950">🧳</div>
    <% } %>
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/35 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 p-5 md:p-7">
      <span class="inline-flex items-center rounded-full border border-pink-500/20 bg-pink-500/10 px-3 py-1 text-xs font-medium text-pink-400 backdrop-blur"><%= item.category || t('general') %></span>
      <h1 class="text-white text-2xl md:text-4xl font-black tracking-tight mt-2 mb-1"><%= item.title %></h1>
      <p class="text-zinc-300 text-sm md:text-base">📍 <%= item.location || t('cinarcikYalova') %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

    <!-- Detay -->
    <div class="lg:col-span-2 space-y-6">
      <% if (item.description || item.summary) { %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
        <% if (item.summary) { %>
        <p class="text-zinc-300 text-base leading-relaxed mb-4"><%= item.summary %></p>
        <% } %>
        <% if (item.description) { %>
        <% if (/<[a-z][\s\S]*>/i.test(item.description)) { %>
        <div class="rich-desc text-zinc-400 text-sm leading-relaxed"><%- item.description %></div>
        <% } else { %>
        <p class="text-zinc-400 text-sm leading-relaxed whitespace-pre-line"><%= item.description %></p>
        <% } %>
        <% } %>
      </div>
      <% } %>

      <!-- Galeri -->
      <% if (item.gallery && item.gallery.length) { %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
        <h2 class="text-white font-bold text-lg mb-3 flex items-center gap-2">🖼️ <%= t('photos') %> <span class="text-zinc-500 text-sm font-normal">(<%= item.gallery.length %>)</span></h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <% item.gallery.forEach((g, i) => { %>
          <div class="relative rounded-xl overflow-hidden aspect-[4/3] bg-zinc-800 border border-zinc-800/80 sl-thumb" onclick="openLb('<%= g %>')">
            <img src="<%= g %>" alt="<%= item.title %> - <%= i + 1 %>" loading="lazy" class="w-full h-full object-cover">
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Künye -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
        <h2 class="text-white font-bold text-lg mb-4 flex items-center gap-2">ℹ️ <%= t('infoCard') %></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div class="bg-zinc-950/70 border border-zinc-800/70 rounded-xl p-3.5">
            <p class="text-zinc-500 text-xs mb-1">🏷️ <%= t('categoryLabel') %></p>
            <p class="text-white font-semibold"><%= item.category || t('general') %></p>
          </div>
          <div class="bg-zinc-950/70 border border-zinc-800/70 rounded-xl p-3.5">
            <p class="text-zinc-500 text-xs mb-1">📍 <%= t('locationLabel') %></p>
            <p class="text-white font-semibold"><%= item.location || t('cinarcikYalova') %></p>
          </div>
          <div class="bg-zinc-950/70 border border-zinc-800/70 rounded-xl p-3.5">
            <p class="text-zinc-500 text-xs mb-1">🖼️ <%= t('photoLabel') %></p>
            <p class="text-white font-semibold"><%= (item.gallery ? item.gallery.length : 0) + (item.image ? 1 : 0) %> <%= t('pieces') %></p>
          </div>
          <div class="bg-zinc-950/70 border border-zinc-800/70 rounded-xl p-3.5">
            <p class="text-zinc-500 text-xs mb-1">📅 <%= t('addedLabel') %></p>
            <p class="text-white font-semibold"><%= item.created_at ? new Date(item.created_at + (String(item.created_at).includes('T') ? '' : 'Z')).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' }) : '—' %></p>
          </div>
        </div>
        <% if (item.map_link) { %>
        <a href="<%= item.map_link %>" target="_blank" rel="noopener"
          class="mt-4 inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-5 py-3 rounded-xl text-sm transition shadow-lg shadow-emerald-600/20">
          📍 <%= t('googleMapOpen') %>
        </a>
        <% } %>
      </div>
    </div>

    <!-- Yan panel -->
    <div class="space-y-4">
      <!-- Diğer yerler -->
      <% if (others && others.length) { %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
        <h3 class="text-white font-bold text-sm mb-3">🧭 <%= t('otherSights') %></h3>
        <div class="space-y-3">
          <% others.forEach(o => { %>
          <a href="/gezilecek-yer/<%= o.id %>" class="flex items-center gap-3 group rounded-xl border border-zinc-800/80 hover:border-zinc-700 bg-zinc-950/60 p-2.5 transition-all">
            <div class="w-14 h-14 rounded-lg overflow-hidden bg-zinc-800 shrink-0 flex items-center justify-center">
              <% if (o.image) { %><img src="<%= o.image %>" alt="" class="w-full h-full object-cover"><% } else { %><span>🧳</span><% } %>
            </div>
            <div class="min-w-0">
              <p class="text-white text-sm font-bold line-clamp-1 group-hover:text-emerald-400 transition-colors"><%= o.title %></p>
              <p class="text-zinc-500 text-xs line-clamp-1"><%= o.location || o.category %></p>
            </div>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>

  </div>
</div>

<!-- Lightbox -->
<div id="sl-lightbox" onclick="closeLb(event)">
  <span id="sl-lb-close" title="<%= t('close') %>" onclick="closeLb(event)">&times;</span>
  <button id="sl-lb-prev" type="button" class="sl-lb-nav" title="<%= t('previousImage') %>" onclick="lbStep(-1)">‹</button>
  <img id="sl-lb-img" src="" alt="" onclick="event.stopPropagation()">
  <button id="sl-lb-next" type="button" class="sl-lb-nav" title="<%= t('nextImage') %>" onclick="lbStep(1)">›</button>
  <div id="sl-lb-counter"></div>
</div>

<script>
  var gal = <%- JSON.stringify(item.gallery || []).replace(/</g, '\\u003c') %>;
  var cur = 0;

  function renderLb() {
    document.getElementById('sl-lb-img').src = gal[cur] || '';
    document.getElementById('sl-lb-counter').textContent = (cur + 1) + ' / ' + gal.length;
    var multi = gal.length > 1;
    document.getElementById('sl-lb-prev').style.display = multi ? 'flex' : 'none';
    document.getElementById('sl-lb-next').style.display = multi ? 'flex' : 'none';
  }

  function openLb(src) {
    cur = gal.indexOf(src);
    if (cur < 0) cur = 0;
    renderLb();
    document.getElementById('sl-lightbox').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function lbStep(d) {
    if (gal.length < 2) return;
    cur = (cur + d + gal.length) % gal.length;
    renderLb();
  }

  function closeLb(e) {
    if (e.target.id === 'sl-lb-close' || e.target.id === 'sl-lightbox') {
      document.getElementById('sl-lightbox').classList.remove('open');
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function (e) {
    var lb = document.getElementById('sl-lightbox');
    if (!lb || !lb.classList.contains('open')) return;
    if (e.key === 'Escape') {
      lb.classList.remove('open');
      document.body.style.overflow = '';
    } else if (e.key === 'ArrowRight') {
      lbStep(1);
    } else if (e.key === 'ArrowLeft') {
      lbStep(-1);
    }
  });
</script>
