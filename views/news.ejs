<% layout('partials/layout') %>
<% locals.pageTitle = t('news') %>

<style>
  body { font-family: 'Inter', sans-serif; }
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ticker-pulse { animation: pulse 1.5s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  @keyframes marqueeScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .animate-marquee-right { display: inline-flex; white-space: nowrap; will-change: transform; animation: marqueeScroll 28s linear infinite; gap: 3rem; }
  .animate-marquee-right:hover { animation-play-state: paused; }
  #manset-img { transition: opacity 0.18s ease; }
  #manset-text { transition: opacity 0.18s ease; }
  .manset-nav-btn { cursor: pointer; }
  .manset-nav-btn.active { background: #dc2626; color: #fff; box-shadow: 0 4px 12px rgba(220,38,38,0.4); }
  .manset-nav-btn:not(.active) { background: rgba(24,24,28,0.8); color: #a1a1aa; }
  .manset-nav-btn:not(.active):hover { background: rgba(39,39,42,0.9); color: #f4f4f5; }
</style>

<div class="max-w-7xl mx-auto px-4 py-6 text-zinc-100">

    <!-- 1. SON DAKİKA BANDI -->
    <div class="relative flex items-center bg-red-600 rounded-xl h-11 my-4 overflow-hidden w-full shadow-lg">
      <div class="z-30 bg-red-800 text-white font-black px-4 h-full flex items-center text-xs tracking-wider uppercase shrink-0 shadow-md ticker-pulse">
        <%= t('breakingNews') %>
      </div>
      <div class="flex-1 w-full h-full relative overflow-hidden flex items-center z-10">
        <div class="animate-marquee-right breaking-marquee whitespace-nowrap text-white font-medium text-sm flex items-center">
          <% const breakings = headlines.concat(regularNews).slice(0, 10); %>
          <% for (let r = 0; r < 2; r++) { %>
            <% breakings.forEach((n, i) => { %>
              <span class="flex items-center shrink-0">
                <span class="text-red-300 mx-4">•</span>
                <a href="/haber/<%= n.slug || n.id %>" class="hover:text-red-200 transition-colors">
                  <%= n.title.substring(0, 80) %><%= n.title.length > 80 ? '...' : '' %>
                </a>
              </span>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>

    <!-- 2. MANŞET ALANI -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8">

      <!-- A) Sol/Orta Bölüm (8 Kolon - Ana Slider) -->
      <div class="lg:col-span-8">
        <div class="relative bg-zinc-900 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-lg group">
          <% const featured = headlines[0]; %>
          <% if (featured) { %>
            <% const img = featured.main_image_url || '/img/fallback.webp'; %>
            <div id="manset-slider-container" class="relative w-full h-[400px] md:h-[512px] overflow-hidden rounded-2xl">
              <img id="manset-img" src="<%= img %>" alt="<%= featured.title %>" class="w-full h-full object-cover object-top transition-all duration-500">
              <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/25 to-transparent z-10"></div>
              <div id="manset-text" class="absolute bottom-0 left-0 p-6 sm:p-8 lg:p-10 text-white z-20 max-w-2xl space-y-3">
                <span id="manset-badge" class="inline-block bg-red-600 text-white font-black text-xs md:text-sm px-3 py-1.5 rounded-r-md tracking-wider uppercase shadow-lg">
                  <%= featured.badge_text || t('manset') %>
                </span>
                <h2 id="manset-title" class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight uppercase drop-shadow-md leading-tight">
                  <%= featured.title %>
                </h2>
                <p id="manset-summary" class="text-sm sm:text-base text-gray-300 max-w-xl drop-shadow line-clamp-2">
                  <%= featured.summary || '' %>
                </p>
                <a id="manset-link" href="/haber/<%= featured.slug || featured.id %>" class="inline-block bg-red-600 text-white font-bold px-5 py-2.5 rounded-lg hover:bg-red-500 transition text-sm">
                  <%= t('readNews') %>
                </a>
              </div>

              <div class="absolute bottom-4 right-4 sm:right-6 z-30 flex items-center gap-1.5 sm:gap-2" id="manset-nav">
                <% headlines.slice(0, 10).forEach((n, i) => { %>
                  <button type="button" data-slide="<%= i %>" title="<%= n.title %>"
                    class="manset-nav-btn px-2.5 sm:px-3 py-1.5 rounded-lg font-bold text-xs shadow-lg transition-all <%= i >= 4 ? 'max-sm:hidden' : '' %>
                      <%= i === 0 ? 'active bg-red-600 text-white' : 'bg-zinc-800/80 text-zinc-300 hover:bg-zinc-700' %>">
                    <%= i + 1 %>
                  </button>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- B) Sağ Bölüm (4 Kolon - Yan Kartlar; 3 kart = sliderin sabit yüksekligi) -->
      <div class="lg:col-span-4 space-y-4">
        <% regularNews.slice(0, 3).forEach(n => { %>
          <a href="/haber/<%= n.slug || n.id %>" class="block group">
            <div class="relative rounded-xl overflow-hidden shadow-lg bg-zinc-800">
              <% const img = n.main_image_url || '/img/fallback.webp'; %>
              <img src="<%= img %>" alt="<%= n.title %>" loading="lazy" decoding="async" class="w-full h-40 object-cover object-center rounded-xl group-hover:scale-105 transition-transform duration-300">
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
              <div class="absolute bottom-0 left-0 p-3 text-white news-thumb-overlay">
                <span class="inline-block bg-red-600 text-white font-black text-[10px] px-2 py-0.5 rounded mb-1">
                  <%= n.badge_text || t('newsBadge') %>
                </span>
                <% if (n.category) { %>
                <span class="inline-block bg-emerald-600 text-white font-black text-[10px] px-2 py-0.5 rounded mb-1 ml-1">
                  <%= n.category %>
                </span>
                <% } %>
                <h3 class="text-sm font-bold line-clamp-2"><%= n.title %></h3>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>

    <!-- ✍️ YAZAR ARANIYOR (tam genişlik yatay bant) -->
    <a href="/iletisim" class="block group mb-8">
      <div class="relative overflow-hidden bg-gradient-to-r from-zinc-900 via-emerald-950/50 to-zinc-900 border border-emerald-500/30 rounded-2xl p-4 sm:p-5 hover:border-emerald-400/70 hover:shadow-[0_0_35px_rgba(16,185,129,0.2)] transition-all flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(500px 130px at 18% 0%, rgba(16,185,129,0.14), transparent 70%)"></div>
        <div class="pointer-events-none absolute top-0 bottom-0 w-24 bg-gradient-to-r from-transparent via-emerald-400/10 to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-pulse" style="left: 30%"></div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-1.5 h-4 bg-emerald-500 rounded-full inline-block"></span>
            <h3 class="text-white font-bold text-sm flex items-center gap-2">✍️ Yazar Aranıyor</h3>
            <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded-full animate-pulse">Açık</span>
          </div>
          <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed">Çınarcık'ı anlatacak kalemleri arıyoruz. Sen de ekibe katıl!</p>
        </div>
        <div class="hidden md:flex flex-col gap-1.5 shrink-0">
          <span class="text-[11px] text-emerald-200/90 bg-emerald-500/10 border border-emerald-500/25 rounded-full px-3 py-1">🖊️ İsmin yazılarınla yayında</span>
          <span class="text-[11px] text-emerald-200/90 bg-emerald-500/10 border border-emerald-500/25 rounded-full px-3 py-1">⏱️ Kendi temponda, haftada bir</span>
          <span class="text-[11px] text-emerald-200/90 bg-emerald-500/10 border border-emerald-500/25 rounded-full px-3 py-1">🤝 Deneyim şart değil</span>
        </div>
        <div class="flex items-center gap-3 shrink-0 sm:ml-2">
          <span class="inline-flex items-center gap-1.5 bg-emerald-600 group-hover:bg-emerald-500 text-white text-xs sm:text-sm font-bold px-4 py-2.5 rounded-xl shadow-lg group-hover:shadow-emerald-500/40 transition-all">Ekipte Yaz 🖋️</span>
          <div class="flex items-center gap-2">
              <div class="relative rounded-lg overflow-hidden w-[90px] h-[110px] bg-zinc-100 flex items-end justify-center group-hover:bg-white transition-colors">
                <svg viewBox="0 0 100 120" class="w-full h-full" aria-hidden="true">
                  <circle cx="50" cy="32" r="16" fill="#27272a"/>
                  <path d="M50 50c-18 0-30 12-33 30l-3 40h14l3-28c1-8 8-14 19-14s18 6 19 14l3 28h14l-3-40c-3-18-15-30-33-30z" fill="#27272a"/>
                  <path d="M44 52l6 14 6-14-6-4z" fill="#fff"/>
                  <path d="M50 66l-4 8 4 30 4-30z" fill="#52525b"/>
                  <path d="M36 56l10 10-4 6-10-12z" fill="#3f3f46"/>
                  <path d="M64 56l-10 10 4 6 10-12z" fill="#3f3f46"/>
                </svg>
                <span class="absolute bottom-1.5 left-0 right-0 text-center text-[10px] font-semibold text-zinc-600">Aday #1</span>
              </div>
              <div class="relative rounded-lg overflow-hidden w-[90px] h-[110px] bg-zinc-100 flex items-end justify-center group-hover:bg-white transition-colors">
                <svg viewBox="0 0 100 120" class="w-full h-full" aria-hidden="true">
                  <path d="M32 34c0-14 8-24 18-24s18 10 18 24c0 6-1 11-3 15l4 8c6 2 10 6 10 12v5H21v-5c0-6 4-10 10-12l4-8c-2-4-3-9-3-15z" fill="#27272a"/>
                  <circle cx="50" cy="34" r="13" fill="#fff"/>
                  <path d="M37 28c0-12 6-20 13-20s13 8 13 20c0 2 0 4-1 6-2-8-6-12-12-12s-10 4-12 12c-1-2-1-4-1-6z" fill="#27272a"/>
                  <path d="M50 52c-16 0-27 11-30 28l-2 40h13l3-26c1-7 7-12 16-12s15 5 16 12l3 26h13l-2-40c-3-17-14-28-30-28z" fill="#27272a"/>
                  <path d="M44 54l6 16 6-16-6-3z" fill="#fff"/>
                  <path d="M40 58l10 12-3 5-9-10z" fill="#3f3f46"/>
                  <path d="M60 58l-10 12 3 5 9-10z" fill="#3f3f46"/>
                </svg>
                <span class="absolute bottom-1.5 left-0 right-0 text-center text-[10px] font-semibold text-zinc-600">Aday #2</span>
              </div>
              <div class="relative rounded-lg overflow-hidden w-[90px] h-[110px] bg-emerald-50 flex items-end justify-center group-hover:bg-emerald-100 transition-colors">
                <svg viewBox="0 0 100 120" class="w-full h-full" aria-hidden="true">
                  <circle cx="50" cy="32" r="16" fill="#6ee7b7" opacity="0.5"/>
                  <path d="M50 50c-18 0-30 12-33 30l-3 40h14l3-28c1-8 8-14 19-14s18 6 19 14l3 28h14l-3-40c-3-18-15-30-33-30z" fill="#6ee7b7" opacity="0.5"/>
                  <circle cx="78" cy="86" r="16" fill="#059669"/>
                  <path d="M78 78v16M70 86h16" stroke="#fff" stroke-width="3.5" stroke-linecap="round"/>
                </svg>
                <span class="absolute bottom-1.5 left-0 right-0 text-center text-[10px] font-semibold text-emerald-700 font-bold">Sen ol →</span>
              </div>
            </div>
          </div>
        </div>
      </a>

    <!-- 3. KATEGORİ FİLTRE BAR -->
    <div class="mb-8 overflow-x-auto">
      <div class="flex gap-2 pb-2 border-b border-zinc-800" id="categoryFilter">
        <% const categories = [['Tümü', t('catAll')], ['Gündem', t('catAgenda')], ['Spor', t('catSports')], ['Yaşam', t('catLife')], ['Duyurular', t('catAnnouncements')]]; %>
        <% categories.forEach((entry, i) => { const cat = entry[0]; %>
          <button type="button" data-cat="<%= cat %>"
            class="cat-btn <%= i === 0
              ? 'bg-red-600 text-white font-bold'
              : 'bg-zinc-900/90 text-zinc-400 hover:bg-zinc-800 hover:text-white' %>
            px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-all border border-zinc-800">
            <%= entry[1] %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- 4. ANA İÇERİK -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

      <!-- A) Sol Kolon (8 Kolon - Haber Akışı) -->
      <div class="lg:col-span-8">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-1 h-5 bg-red-600 rounded"></span>
          <%= t('currentNews') %>
        </h2>

        <% const allNews = headlines.concat(regularNews); %>
        <% if (allNews.length === 0) { %>
          <div class="text-center py-12 text-zinc-500">
            <p class="text-lg"><%= t('noNews') %></p>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% allNews.slice(0, 12).forEach(n => { %>
              <a href="/haber/<%= n.slug || n.id %>" class="group block news-card-item" data-category="<%= n.category || 'Gündem' %>">
                <div class="bg-zinc-900/80 backdrop-blur-sm border border-zinc-800/80 rounded-2xl overflow-hidden shadow-lg hover:border-zinc-700 transition-all h-full flex flex-col">
                  <div class="relative h-48 overflow-hidden bg-zinc-900/60">
                    <% const img = n.main_image_url || '/img/fallback.webp'; %>
                    <img src="<%= img %>" alt="<%= n.title %>" loading="lazy" decoding="async" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300">
                    <div class="absolute top-2 left-2 flex items-center gap-1.5">
                      <span class="bg-red-600 text-white font-black text-[10px] px-2 py-0.5 rounded">
                        <%= n.badge_text || t('newsBadge') %>
                      </span>
                      <% if (n.category) { %>
                      <span class="bg-emerald-600 text-white font-black text-[10px] px-2 py-0.5 rounded">
                        <%= n.category %>
                      </span>
                      <% } %>
                    </div>
                  </div>
                  <div class="p-4 flex-1 flex flex-col">
                    <span class="text-xs text-zinc-500 mb-2">
                      <%= new Date(n.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long' }) %>
                    </span>
                    <h3 class="text-zinc-100 font-bold line-clamp-2 group-hover:text-emerald-400 transition-colors mb-2 flex-1">
                      <%= n.title %>
                    </h3>
                    <% if (n.summary) { %>
                      <p class="text-zinc-400 text-sm line-clamp-2">
                        <%= n.summary %>
                      </p>
                    <% } %>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>

      </div>

      <!-- B) Sağ Kolon (4 Kolon - Sidebar) -->
      <div id="news-sidebar" class="lg:col-span-4 space-y-8 flex flex-col">

        <!-- 1. 🔥 En Çok Okunanlar -->
        <div class="bg-zinc-900 border border-zinc-800/80 rounded-2xl p-5 shadow-lg">
          <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <span class="text-red-500">🔥</span> <%= t('mostRead') %>
          </h3>
          <div class="space-y-4">
            <% mostRead.forEach((n, i) => { %>
              <a href="/haber/<%= n.slug || n.id %>" class="flex items-start gap-3 group">
                <div class="relative flex-shrink-0 w-28 h-20 rounded-lg overflow-hidden bg-zinc-800">
                  <img src="<%= n.main_image_url || '/img/fallback.webp' %>" alt="<%= n.title %>" loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105">
                  <span class="absolute top-1 left-1 w-5 h-5 rounded-md bg-red-600 text-white text-[11px] font-black flex items-center justify-center"><%= i + 1 %></span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-zinc-200 group-hover:text-emerald-400 transition-colors font-medium line-clamp-2 text-sm"><%= n.title %></div>
                  <div class="flex items-center gap-2 text-xs text-zinc-500 mt-1">
                    <span>👁️ <%= n.views_count || 0 %></span>
                    <span>•</span>
                    <span><%= new Date(n.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'short' }) %></span>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        </div>

        <% if (otherNews.length) { %>
        <!-- 2. 📰 Diğer Haberler -->
        <div class="bg-zinc-900 border border-zinc-800/80 rounded-2xl p-5 shadow-lg flex-1 flex flex-col">
          <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <span class="text-emerald-400">📰</span> <%= t('catOtherNews') %>
          </h3>
          <div class="space-y-4">
            <% otherNews.forEach((n, i) => { %>
              <a href="/haber/<%= n.slug || n.id %>" class="flex items-start gap-3 group">
                <div class="relative flex-shrink-0 w-32 h-24 rounded-lg overflow-hidden bg-zinc-800">
                  <img src="<%= n.main_image_url || '/img/fallback.webp' %>" alt="<%= n.title %>" loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105">
                  <span class="absolute top-1 left-1 px-1.5 py-0.5 rounded-md bg-zinc-950/80 text-zinc-100 text-[11px] font-black"><%= i + 6 %></span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-zinc-200 group-hover:text-emerald-400 transition-colors font-medium line-clamp-2 text-sm"><%= n.title %></div>
                  <div class="flex items-center gap-2 text-xs text-zinc-500 mt-1">
                    <span>👁️ <%= n.views_count || 0 %></span>
                    <span>•</span>
                    <span><%= new Date(n.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'short' }) %></span>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
          <div class="mt-auto pt-4 text-center border-t border-zinc-800/60">
            <a href="/haberler" class="text-xs font-medium text-emerald-400/90 hover:text-emerald-300 transition-colors"><%= t('allNews') %></a>
          </div>
        </div>
        <% } %>

      </div>
    </div>

  </div>

<script>
(function() {
  var mansetData = <%- JSON.stringify(headlines.slice(0, 10)).replace(/</g, '\\u003c') %>;
  mansetData.forEach(function(h) { if (h.main_image_url) { var im = new Image(); im.src = h.main_image_url; } });
  var currentSlide = 0;
  var autoplay = true;
  var timerId = null;

  var imgEl = document.getElementById('manset-img');
  var badgeEl = document.getElementById('manset-badge');
  var titleEl = document.getElementById('manset-title');
  var summaryEl = document.getElementById('manset-summary');
  var linkEl = document.getElementById('manset-link');
  var navEl = document.getElementById('manset-nav');
  var containerEl = document.getElementById('manset-slider-container');

  if (!imgEl || !navEl || mansetData.length === 0) return;

  var defaultImg = '/img/fallback.webp';

  function updateNav() {
    var btns = navEl.querySelectorAll('.manset-nav-btn');
    btns.forEach(function(btn, i) {
      if (i === currentSlide) {
        btn.classList.add('active', 'bg-red-600', 'text-white');
        btn.classList.remove('bg-zinc-800/80', 'text-zinc-300');
      } else {
        btn.classList.remove('active', 'bg-red-600', 'text-white');
        btn.classList.add('bg-zinc-800/80', 'text-zinc-300');
      }
    });
  }

  function showSlide(index) {
    if (mansetData.length === 0) return;
    currentSlide = Math.max(0, Math.min(index, mansetData.length - 1));
    var h = mansetData[currentSlide];

    imgEl.style.opacity = '0';
    setTimeout(function() {
      imgEl.src = h.main_image_url || defaultImg;
      imgEl.alt = h.title;
      imgEl.style.opacity = '1';
    }, 80);

    var textWrap = document.getElementById('manset-text');
    if (textWrap) textWrap.style.opacity = '0';
    setTimeout(function() {
      if (h.badge_text && h.badge_text.trim()) {
        badgeEl.textContent = h.badge_text;
        badgeEl.style.display = '';
      } else {
        badgeEl.textContent = "<%= t('manset') %>";
      }
      titleEl.textContent = h.title;
      summaryEl.textContent = h.summary || '';
      linkEl.href = '/haber/' + (h.slug || h.id);
      if (textWrap) textWrap.style.opacity = '1';
    }, 100);

    updateNav();
  }

  function startAuto() {
    if (timerId) clearInterval(timerId);
    if (autoplay && mansetData.length > 1) {
      timerId = setInterval(function() {
        showSlide(currentSlide + 1 >= mansetData.length ? 0 : currentSlide + 1);
      }, 5000);
    }
  }

  var navBtns = navEl.querySelectorAll('.manset-nav-btn');
  navBtns.forEach(function(btn) {
    btn.addEventListener('mouseenter', function() {
      if (timerId) clearInterval(timerId);
      var idx = parseInt(btn.getAttribute('data-slide'), 10);
      showSlide(idx);
    });
    btn.addEventListener('mouseleave', function() {
      startAuto();
    });
    btn.addEventListener('click', function() {
      var idx = parseInt(btn.getAttribute('data-slide'), 10);
      showSlide(idx);
      startAuto();
    });
  });

  if (containerEl) {
    containerEl.addEventListener('mouseenter', function() { if (timerId) clearInterval(timerId); });
    containerEl.addEventListener('mouseleave', function() { startAuto(); });
  }

  showSlide(0);
  startAuto();
})();
</script>

<script>
(function() {
  var filterBar = document.getElementById('categoryFilter');
  if (!filterBar) return;
  var btns = filterBar.querySelectorAll('.cat-btn');
  var cards = document.querySelectorAll('.news-card-item');

  btns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var cat = btn.getAttribute('data-cat');

      btns.forEach(function(b) {
        b.classList.remove('bg-red-600', 'text-white', 'font-bold');
        b.classList.add('bg-zinc-900/90', 'text-zinc-400');
      });
      btn.classList.remove('bg-zinc-900/90', 'text-zinc-400');
      btn.classList.add('bg-red-600', 'text-white', 'font-bold');

      cards.forEach(function(card) {
        if (cat === 'Tümü' || card.getAttribute('data-category') === cat) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
})();
</script>

