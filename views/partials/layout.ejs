<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>" data-lp="<%= lp %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Marmara'nın İncisi | <%= typeof pageTitle !== 'undefined' ? pageTitle : t('defaultPageTitle') %></title>
  <link rel="icon" type="image/png" href="/img/logo-circle.png">
  <link rel="stylesheet" href="/css/tailwind.css">
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('metaDesc') %>">
  <meta name="google-site-verification" content="CzjrSopLFPONrxTH1m5RDQ7bft0jSV1u52Du475UUUM">

  <!-- Google tag (GA4) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HPNR24RP48"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HPNR24RP48');
  </script>

  <!-- Canonical + Hreflang -->
  <link rel="canonical" href="<%= siteUrl %><%= lp %><%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="tr" href="<%= siteUrl %><%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="en" href="<%= siteUrl %>/en<%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="ru" href="<%= siteUrl %>/ru<%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="ar" href="<%= siteUrl %>/ar<%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="x-default" href="<%= siteUrl %><%= path === '/' ? '/' : path %>">

  <!-- Open Graph -->
  <meta property="og:title" content="Marmara'nın İncisi | <%= typeof pageTitle !== 'undefined' ? pageTitle : t('defaultPageTitle') %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('metaDescShort') %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:url" content="<%= siteUrl %><%= lp %><%= path === '/' ? '/' : path %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : siteUrl + '/img/logo-circle.png' %>">
  <meta property="og:site_name" content="Marmara'nın İncisi">
  <meta property="og:locale" content="<%= lang === 'ar' ? 'ar_AR' : lang === 'en' ? 'en_US' : lang + '_' + lang.toUpperCase() %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Marmara'nın İncisi | <%= typeof pageTitle !== 'undefined' ? pageTitle : t('defaultPageTitle') %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('metaDescShort') %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : siteUrl + '/img/logo-circle.png' %>">

  <meta name="robots" content="<%= typeof robotsMeta !== 'undefined' ? robotsMeta : 'index, follow' %>">
  <link rel="alternate" type="application/rss+xml" title="Marmara'nın İncisi — Haberler RSS" href="/rss.xml">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>try{if(localStorage.getItem('theme')==='light')document.documentElement.classList.add('light');}catch(e){}</script>

  <!-- JSON-LD: Site + Organization (her sayfada) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "<%= siteUrl %>/#website",
        "url": "<%= siteUrl %>/",
        "name": "Marmara'nın İncisi",
        "description": "<%= t('metaDesc') %>",
        "inLanguage": "tr-TR",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "<%= siteUrl %>/haberler?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Organization",
        "@id": "<%= siteUrl %>/#organization",
        "name": "Marmara'nın İncisi",
        "url": "<%= siteUrl %>/",
        "logo": "<%= siteUrl %>/img/logo-circle.png",
        "sameAs": [],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Çınarcık",
          "addressRegion": "Yalova",
          "addressCountry": "TR"
        },
        "areaServed": {
          "@type": "City",
          "name": "Çınarcık",
          "addressRegion": "Yalova",
          "addressCountry": "TR"
        }
      }
    ]
  }
  </script>

  <!-- Sayfaya özel JSON-LD (haber, mekan vb.) -->
  <% if (typeof pageSchema !== 'undefined' && pageSchema) { %>
  <script type="application/ld+json"><%- JSON.stringify(pageSchema) %></script>
  <% } %>
</head>
<body class="text-white" style="min-height:100vh;display:flex;flex-direction:column;">

  <!-- CANLI BİLGİ ÇUBUĞU (En Üst) -->
  <div id="ticker-bar" class="bg-zinc-950 border-b border-zinc-800 text-xs">
    <div class="max-w-[90rem] mx-auto px-4 py-1.5 flex items-center gap-4">
      <div class="flex-1 min-w-0 overflow-x-auto whitespace-nowrap" id="ticker-content">
        <span class="text-zinc-500"><%= t('loading') %></span>
      </div>
      <span id="ticker-updated" class="hidden max-sm:hidden shrink-0 text-zinc-500 pl-3 border-l border-zinc-800 whitespace-nowrap"></span>
    </div>
  </div>

  <header class="site-header bg-zinc-900 bg-opacity-80 backdrop-blur-md sticky top-0 z-50 w-full shadow-md" role="banner">
    <div class="max-w-[90rem] mx-auto flex items-center justify-between px-4 py-1">
      <a href="/" class="flex items-center" aria-label="<%= t('homeAria') %>">
        <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 xl:w-24 xl:h-24 rounded-full overflow-hidden border-2 border-white/30 ring-2 ring-emerald-500/40 shadow-xl shadow-black/50 bg-white">
          <img src="/img/logo-circle.png" alt="<%= t('logoAlt') %>" class="w-full h-full object-cover">
        </div>
      </a>
      <nav id="main-nav" class="main-nav hidden lg:flex items-center gap-1 xl:gap-1.5 text-[13px] xl:text-sm font-semibold whitespace-nowrap">
        <a href="<%= lp %>/" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">🏠 </span><%= t('home') %></a>
        <a href="<%= lp %>/haberler" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= (path === '/haberler' || path.startsWith('/haber/')) ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">📰 </span><%= t('news') %></a>
        <a href="<%= lp %>/duyurular" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/duyurular' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">📢 </span><%= t('announcements') %></a>
        <a href="<%= lp %>/etkinlikler" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/etkinlikler' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">🗓️ </span><%= t('events') %></a>
        <a href="<%= lp %>/mekanlar" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= (path === '/mekanlar' || path.startsWith('/mekan/')) ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">📍 </span><%= t('places') %></a>
        <a href="<%= lp %>/rehber" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= (path === '/rehber' || path.startsWith('/rehber/')) ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">🏢 </span><%= t('guide') %></a>
        <a href="<%= lp %>/gezilecek-yerler" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/gezilecek-yerler' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">🧳 </span><%= t('sightseeing') %></a>
        <a href="<%= lp %>/cinarcik-hakkinda" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/cinarcik-hakkinda' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">ℹ️ </span><%= t('about') %></a>
      </nav>
      <div class="nav-right flex items-center gap-1.5 sm:gap-2">
        <span class="inline-flex items-center gap-1 relative" id="lang-dropdown">
          <span class="text-base leading-none" aria-hidden="true">🌐</span>
          <button id="lang-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Dil seçimi" title="Dil seçimi"
            class="px-2 py-1.5 rounded-lg bg-zinc-800 text-zinc-200 border border-zinc-700 text-sm font-semibold cursor-pointer hover:border-emerald-500/50 focus:border-emerald-500/60 focus:outline-none transition flex items-center gap-1.5">
            <img src="https://flagcdn.com/w40/<%= ({tr:'tr',en:'gb',ru:'ru',ar:'sa'})[lang] %>.png" alt="" class="w-5 h-auto rounded-[1px]" onerror="this.style.display='none'" />
            <span><%= lang.toUpperCase() %></span>
          </button>
          <div id="lang-menu" class="hidden absolute right-0 top-full mt-1 w-40 bg-zinc-800 border border-zinc-700 rounded-lg shadow-xl z-[60] py-1 overflow-hidden">
            <% [['tr','tr','Türkçe'],['en','gb','English'],['ru','ru','Русский'],['ar','sa','العربية']].forEach(function(item){ %>
              <% var l = item[0]; var langHref = (l === 'tr' ? '' : '/' + l) + (path === '/' ? '/' : path); %>
              <a href="<%= langHref %>" class="flex items-center gap-2 px-3 py-2 text-sm <%= lang === l ? 'text-emerald-400 bg-zinc-700/50' : 'text-zinc-200 hover:bg-zinc-700' %> transition-colors">
                <img src="https://flagcdn.com/w40/<%= item[1] %>.png" alt="" class="w-5 h-auto rounded-[1px]" onerror="this.style.display='none'" />
                <%= item[2] %>
              </a>
            <% }); %>
          </div>
        </span>
        <button id="theme-toggle" title="<%= t('themeToggle') %>" class="px-3 py-1 rounded bg-zinc-800 text-white hover:bg-zinc-700 transition text-sm">☀️</button>
        <% if (isAdmin) { %>
          <a href="<%= lp %>/admin" class="hidden sm:inline-block lg:hidden xl:inline-block px-2.5 py-1 text-xs rounded bg-emerald-600 text-white hover:bg-emerald-500 transition"><%= t('management') %></a>
          <a href="<%= lp %>/admin/logout" class="hidden sm:inline-block lg:hidden xl:inline-block ml-2 px-2.5 py-1 text-xs rounded bg-gray-600 text-white hover:bg-gray-500 transition"><%= t('logout') %></a>
        <% } %>
      </div>
      <button id="menu-toggle" class="lg:hidden p-2 -mr-2 text-2xl text-white" aria-label="Menü" aria-expanded="false" aria-controls="main-nav">☰</button>
    </div>
  </header>

  <!-- HAVA DURUMU TAHMİN MODALİ -->
  <div id="weather-modal" class="fixed inset-0 z-[100] hidden" onclick="if(event.target===this)closeWeatherModal()">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
    <div class="relative w-auto max-w-4xl mt-6 sm:mt-16 mb-8 mx-4 sm:mx-auto bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl overflow-hidden max-h-[80vh] flex flex-col">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-800 bg-zinc-900/90 sticky top-0 z-10">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🌤️</span>
          <div>
            <h3 class="text-white font-bold text-lg"><%= t('weatherTitle') %></h3>
            <p class="text-zinc-500 text-xs"><%= t('weatherSub') %></p>
          </div>
        </div>
        <button onclick="closeWeatherModal()" class="text-zinc-400 hover:text-white text-2xl leading-none px-2 transition">&times;</button>
      </div>
      <!-- Tabs -->
      <div class="flex border-b border-zinc-800 bg-zinc-900/90 sticky top-[68px] z-10">
        <button onclick="showForecastTab('week')" id="tab-week" class="flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-emerald-500 text-emerald-400"><%= t('weekly') %></button>
        <button onclick="showForecastTab('15days')" id="tab-15days" class="flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-transparent text-zinc-500 hover:text-zinc-300"><%= t('days15') %></button>
        <button onclick="showForecastTab('month')" id="tab-month" class="flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-transparent text-zinc-500 hover:text-zinc-300"><%= t('monthly') %></button>
      </div>
      <!-- Content -->
      <div id="forecast-content" class="overflow-y-auto p-4 flex-1">
        <div class="text-center text-zinc-500 py-8"><%= t('loading') %></div>
      </div>
    </div>
  </div>

  <main class="main-content"><%- typeof body !== 'undefined' ? body : '' %></main>
  <footer class="bg-zinc-900 border-t border-zinc-800 text-gray-300 pt-10 pb-6" role="contentinfo">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 px-4">
      <div class="space-y-3">
        <h3 class="text-white font-bold text-lg flex items-center gap-2">
          <span class="w-1.5 h-5 bg-emerald-500 rounded-full inline-block"></span>
          Marmara'nın İncisi
        </h3>
        <p class="text-gray-400 text-sm leading-relaxed"><%= t('footerTag') %></p>
      </div>
      <div>
        <h4 class="text-white font-bold text-lg flex items-center gap-2 justify-center mb-4">
          <span class="w-1.5 h-5 bg-emerald-500 rounded-full inline-block"></span>
          <%= t('quickLinks') %>
        </h4>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
          <li><a href="<%= lp %>/haberler" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('news') %></a></li>
          <li><a href="<%= lp %>/duyurular" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('annList') %></a></li>
          <li><a href="<%= lp %>/etkinlikler" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('events') %></a></li>
          <li><a href="<%= lp %>/deniz" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('sea') %></a></li>
          <li><a href="<%= lp %>/gizlilik" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('privacy') %></a></li>
          <li><a href="<%= lp %>/mekanlar" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('places') %></a></li>
          <li><a href="<%= lp %>/gezilecek-yerler" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('sightseeing') %></a></li>
          <li><a href="<%= lp %>/rehber" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('guide') %></a></li>
          <li><a href="<%= lp %>/iletisim" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('contact') %></a></li>
          <li><a href="<%= lp %>/cinarcik-hakkinda" class="text-gray-400 hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"><span class="text-emerald-500/50">›</span> <%= t('aboutCinarcik') %></a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-bold text-lg flex items-center gap-2 mb-4">
          <span class="w-1.5 h-5 bg-emerald-500 rounded-full inline-block"></span>
          <%= t('contact') %>
        </h4>
        <ul class="space-y-2 text-sm text-gray-400">
          <li class="flex items-center gap-2">☘️ Çınarcık, Yalova</li>
          <li class="flex items-center gap-2">🌊 <%= t('marmaraShore') %></li>
        </ul>
      </div>
    </div>
    <div class="max-w-7xl mx-auto mt-8 pt-5 border-t border-zinc-800 px-4 text-center text-xs text-gray-500">
      <p>&copy; <%= new Date().getFullYear() %> Marmara'nın İncisi. <%= t('rightsReserved') %></p>
    </div>
  </footer>

  <!-- SABİT "BİZE ULAŞIN" BUTONU (Her sayfada) -->
  <a href="<%= lp %>/iletisim" class="contact-fab" title="<%= t('contactUs') %>" aria-label="<%= t('contactUs') %>">
    <span class="fab-ic">✉️</span>
    <span class="fab-text"><%= t('contactFab') %></span>
  </a>

  <script>
  window.__i18n = <%- JSON.stringify({ loading: t('loading'), goldGram: t('goldGram'), goldQuarter: t('goldQuarter'), lastUpdate: t('lastUpdate'), forecastLoad: t('forecastLoad'), forecastError: t('forecastError'), connError: t('connError'), noData: t('noData'), today: t('today'), historical: t('historical'), forecastTitle7: t('forecastTitle7'), forecastTitle15: t('forecastTitle15'), forecastTitleMonth: t('forecastTitleMonth'), forecastReal: t('forecastReal'), forecastHist: t('forecastHist') }) %>;
  (function() {
    var cache = null;
    var lastFetch = 0;
    var CACHE_MS = 5 * 60 * 1000;
    var forecastData = null;

    function formatNum(v) {
      if (!v || v === '--') return '--';
      var s = String(v).replace(/[^0-9.,-]/g, '');
      s = s.replace(/\.(?=\d{3}(?:,|$))/g, '');
      var n = parseFloat(s.replace(',', '.'));
      if (isNaN(n)) return v;
      return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function renderTicker(d) {
      var el = document.getElementById('ticker-content');
      if (!el) return;
      var h = '';

      function changeHtml(changeStr) {
        if (!changeStr) return '';
        var clean = changeStr.replace('%', '').replace(',', '.');
        var val = parseFloat(clean);
        if (isNaN(val)) return '';
        if (val > 0) return ' <span class="text-emerald-400 text-[10px] font-bold">↑' + changeStr + '</span>';
        if (val < 0) return ' <span class="text-red-400 text-[10px] font-bold">↓' + changeStr + '</span>';
        return ' <span class="text-zinc-500 text-[10px]">→' + changeStr + '</span>';
      }

      // Hava Durumu (tıklanabilir)
      h += '<span class="ticker-item ticker-weather" onclick="openWeatherModal()" style="cursor:pointer" title="Tahmini gör">';
      h += '<span class="text-emerald-200/90">Çınarcık</span> ';
      h += '<span class="w-ic">' + (d.weather.icon || '') + '</span> ';
      h += '<span class="text-white font-bold">' + d.weather.temp + '</span> ';
      h += '<span class="text-emerald-100/70">' + d.weather.description + '</span>';
      h += ' <span class="text-emerald-300/70 text-[10px]">▸</span>';
      h += '</span>';
      h += '<span class="ticker-sep">|</span>';
      // Döviz
      h += '<span class="ticker-item"><span class="text-zinc-500">USD</span> <span class="text-emerald-400 font-semibold">' + formatNum(d.usd) + ' ₺</span>' + changeHtml(d.usdChange) + '</span>';
      h += '<span class="ticker-sep">|</span>';
      h += '<span class="ticker-item"><span class="text-zinc-500">EUR</span> <span class="text-emerald-400 font-semibold">' + formatNum(d.eur) + ' ₺</span>' + changeHtml(d.eurChange) + '</span>';
      h += '<span class="ticker-sep">|</span>';
      // Altın
      h += '<span class="ticker-item"><span class="text-zinc-500">' + window.__i18n.goldGram + '</span> <span class="text-amber-400 font-semibold">' + formatNum(d.gramAltin) + ' ₺</span>' + changeHtml(d.gramChange) + '</span>';
      h += '<span class="ticker-sep">|</span>';
      h += '<span class="ticker-item"><span class="text-zinc-500">' + window.__i18n.goldQuarter + '</span> <span class="text-amber-400 font-semibold">' + formatNum(d.ceYrekAltin) + ' ₺</span>' + changeHtml(d.ceYrekChange) + '</span>';
      h += '<span class="ticker-sep">|</span>';
      // BIST
      h += '<span class="ticker-item"><span class="text-zinc-500">BIST 100</span> <span class="text-sky-400 font-semibold">' + formatNum(d.bist100) + '</span>' + changeHtml(d.bistChange) + '</span>';
    // Güncelleme (saat her zaman sağda sabit görünür)
    var upd = document.getElementById('ticker-updated');
    if (upd) {
      if (d.updated) {
        upd.textContent = window.__i18n.lastUpdate + ': ' + d.updated;
        upd.classList.remove('hidden');
      } else {
        upd.classList.add('hidden');
      }
    }
    el.innerHTML = h;
    }

    function loadTicker() {
      var now = Date.now();
      if (cache && (now - lastFetch) < CACHE_MS) { renderTicker(cache); return; }
      fetch('/api/ticker-data')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          cache = d;
          lastFetch = Date.now();
          renderTicker(d);
        })
        .catch(function() {
          if (cache) renderTicker(cache);
        });
    }

    // ---- Hava Durumu Modal ----
    window.openWeatherModal = function() {
      document.getElementById('weather-modal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      loadForecast('week');
      if (typeof gtag === 'function') gtag('event', 'open_weather');
    };

    window.closeWeatherModal = function() {
      document.getElementById('weather-modal').classList.add('hidden');
      document.body.style.overflow = '';
    };

    window.showForecastTab = function(tab) {
      document.querySelectorAll('#weather-modal [id^="tab-"]').forEach(function(t) {
        t.className = 'flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-transparent text-zinc-500 hover:text-zinc-300';
      });
      var active = document.getElementById('tab-' + tab);
      if (active) active.className = 'flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-emerald-500 text-emerald-400';
      renderForecast(forecastData, tab);
    };

    function loadForecast(tab) {
      var container = document.getElementById('forecast-content');
      if (forecastData) {
        renderForecast(forecastData, tab);
        return;
      }
      container.innerHTML = '<div class="text-center text-zinc-500 py-8">' + window.__i18n.forecastLoad + '</div>';
      fetch('/api/weather-forecast')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.success && d.forecast && d.forecast.length > 0) {
            forecastData = d.forecast;
            renderForecast(forecastData, tab);
          } else {
            container.innerHTML = '<div class="text-center text-red-400 py-8">' + window.__i18n.forecastError + '</div>';
          }
        })
        .catch(function(err) {
          container.innerHTML = '<div class="text-center text-red-400 py-8">' + window.__i18n.connError + ': ' + err.message + '</div>';
        });
    }

    function renderForecast(data, tab) {
      var container = document.getElementById('forecast-content');
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="text-center text-zinc-500 py-8">' + window.__i18n.noData + '</div>';
        return;
      }
      var days;
      var title;
      if (tab === 'week') {
        days = data.slice(0, 7);
        title = window.__i18n.forecastTitle7;
      } else if (tab === '15days') {
        days = data.slice(0, 15);
        title = window.__i18n.forecastTitle15;
      } else {
        days = data;
        var realCount = data.filter(function(f){ return f.isForecast; }).length;
        var histCount = data.length - realCount;
        title = window.__i18n.forecastTitleMonth + ' — ' + data.length + ' Gün';
        if (histCount > 0) title += ' (' + realCount + ' ' + window.__i18n.forecastReal + ' + ' + histCount + ' ' + window.__i18n.forecastHist + ')';
      }

      var h = '<p class="text-zinc-500 text-xs mb-3">' + title + '</p>';
      h += '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">';
      days.forEach(function(f) {
        var isToday = f.date === new Date().toISOString().slice(0, 10);
        var borderClass = isToday ? ' ring-1 ring-emerald-500/40 border-emerald-500/30' : '';
        if (!f.isForecast) borderClass += ' border-dashed';
        h += '<div class="bg-zinc-800/80 border border-zinc-700/50 rounded-xl p-3 text-center transition hover:border-emerald-500/50' + borderClass + '">';
        h += '  <p class="text-zinc-400 text-[11px] font-medium">' + f.dayName + '</p>';
        h += '  <p class="text-white text-sm font-bold">' + f.dayNum + ' ' + f.month + '</p>';
        if (isToday) h += '  <span class="inline-block bg-emerald-500/20 text-emerald-400 text-[9px] font-bold px-1.5 py-0.5 rounded mt-0.5">' + window.__i18n.today + '</span>';
        else if (!f.isForecast) h += '  <span class="inline-block bg-zinc-600/30 text-zinc-500 text-[9px] px-1.5 py-0.5 rounded mt-0.5">' + window.__i18n.historical + '</span>';
        h += '  <div class="text-3xl my-2">' + f.icon + '</div>';
        h += '  <p class="text-white font-bold text-lg">' + f.tempMax + '° <span class="text-zinc-500 font-normal text-sm">' + f.tempMin + '°</span></p>';
        h += '  <p class="text-zinc-500 text-[11px] mt-1">' + f.description + '</p>';
        h += '  <div class="flex items-center justify-center gap-2 mt-2 text-[10px] text-zinc-500">';
        h += '    <span>💧%' + f.rainChance + '</span>';
        h += '    <span>💨' + f.wind + ' km/s</span>';
        h += '  </div>';
        h += '</div>';
      });
      h += '</div>';
      container.innerHTML = h;
    }

    // ESC ile kapat
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeWeatherModal();
    });

    loadTicker();
    setInterval(loadTicker, CACHE_MS);

    function translatePage() {
      if (!window.__t) return;
      // internal link/form prefixing
      var lp = document.documentElement.getAttribute('data-lp') || '';
      document.querySelectorAll('a[href]').forEach(function(a) {
        var h = a.getAttribute('href');
        if (h && h.charAt(0) === '/' && h.indexOf('//') !== 0 && h.indexOf(lp + '/') !== 0 && !/^\/(en|ru|ar)(\/|$)/.test(h) && h.indexOf('/api/') !== 0 && h.indexOf('/img/') !== 0 && h.indexOf('/css/') !== 0 && h.indexOf('/auth/') !== 0) {
          a.setAttribute('href', lp + h);
        }
      });
      document.querySelectorAll('form[action]').forEach(function(f) {
        var a = f.getAttribute('action');
        if (a && a.charAt(0) === '/' && a.indexOf(lp + '/') !== 0 && !/^\/(en|ru|ar)(\/|$)/.test(a) && a.indexOf('/api/') !== 0) {
          f.setAttribute('action', lp + a);
        }
      });
    }
    document.addEventListener('DOMContentLoaded', translatePage);

    // ---- Dil dropdown (Windows'ta emoji bayrak render edilmez; PNG bayrak kullanılır) ----
    var langBtn = document.getElementById('lang-btn');
    var langMenu = document.getElementById('lang-menu');
    var langWrap = document.getElementById('lang-dropdown');
    if (langBtn && langMenu && langWrap) {
      langBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var hidden = langMenu.classList.toggle('hidden');
        langBtn.setAttribute('aria-expanded', hidden ? 'false' : 'true');
      });
      document.addEventListener('click', function(e) {
        if (!langMenu.classList.contains('hidden') && !langWrap.contains(e.target)) {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // ---- Mobil menü ----
    var menuBtn = document.getElementById('menu-toggle');
    var mainNav = document.getElementById('main-nav');
    if (menuBtn && mainNav) {
      menuBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = mainNav.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', function(e) {
        if (mainNav.classList.contains('open') && !mainNav.contains(e.target)) {
          mainNav.classList.remove('open');
          menuBtn.setAttribute('aria-expanded', 'false');
        }
      });
      mainNav.querySelectorAll('a').forEach(function(a) {
        a.addEventListener('click', function() {
          mainNav.classList.remove('open');
          menuBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }

    var tBtn = document.getElementById('theme-toggle');
    if (tBtn) {
      if (localStorage.getItem('theme') === 'light') { document.documentElement.classList.add('light'); tBtn.textContent = '🌙'; }
      tBtn.addEventListener('click', function() {
        document.documentElement.classList.toggle('light');
        var on = document.documentElement.classList.contains('light');
        localStorage.setItem('theme', on ? 'light' : 'dark');
        tBtn.textContent = on ? '🌙' : '☀️';
      });
    }

    document.querySelectorAll('img').forEach(function(img) {
      if (!img.src || (img.src.indexOf('logo-circle') === -1 && img.id.indexOf('manset') === -1 && img.id.indexOf('hero') === -1)) {
        img.loading = 'lazy';
        img.decoding = 'async';
      }
    });
  })();
  </script>

  <!-- Windows 11 tarzı köşe bildirimi: server ?msg=&mtype= ile flash() gönderir -->
  <div class="admin-toast-root" id="admin-toast-root" aria-live="polite"></div>
  <script>
  (function() {
    var ICONS = { success: '✓', info: 'i', error: '✕' };
    var TITLES = { success: 'İşlem tamamlandı', info: 'Bilgi', error: 'Hata' };
    function adminToast(text, type, title) {
      var root = document.getElementById('admin-toast-root');
      if (!root || !text) return;
      type = (type && ICONS[type]) ? type : 'success';
      while (root.children.length >= 4) root.removeChild(root.firstChild);
      var el = document.createElement('div');
      el.className = 'admin-toast t-' + type;
      var icon = document.createElement('span');
      icon.className = 'at-icon';
      icon.textContent = ICONS[type];
      var body = document.createElement('div');
      body.className = 'at-body';
      var t = document.createElement('div');
      t.className = 'at-title';
      t.textContent = title || TITLES[type];
      var m = document.createElement('div');
      m.className = 'at-text';
      m.textContent = text;
      body.appendChild(t); body.appendChild(m);
      var close = document.createElement('button');
      close.className = 'at-close';
      close.setAttribute('aria-label', 'Kapat');
      close.innerHTML = '&times;';
      var prog = document.createElement('span');
      prog.className = 'at-progress';
      el.appendChild(icon); el.appendChild(body); el.appendChild(close); el.appendChild(prog);
      root.appendChild(el);
      requestAnimationFrame(function() { requestAnimationFrame(function() { el.classList.add('show'); }); });
      var timer = setTimeout(dismiss, 4500);
      function dismiss() {
        clearTimeout(timer);
        el.classList.remove('show');
        el.classList.add('hide');
        setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 450);
      }
      close.addEventListener('click', dismiss);
      el.addEventListener('click', function(e) { if (e.target !== close) dismiss(); });
      return el;
    }
    window.adminToast = adminToast;

    var params = new URLSearchParams(window.location.search);
    if (params.get('msg')) {
      adminToast(params.get('msg'), params.get('mtype') || 'success');
      params.delete('msg'); params.delete('mtype');
      var qs = params.toString();
      window.history.replaceState({}, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
    }
  })();
  </script>

  <!-- Windows 11 tarzı onay diyaloğu: data-confirm'li form/butonlar + adminConfirm()/adminAlert() -->
  <div class="admin-confirm-backdrop hidden" id="admin-confirm-backdrop" role="dialog" aria-modal="true" aria-labelledby="ac-title">
    <div class="admin-confirm" id="admin-confirm">
      <span class="ac-icon" id="ac-icon">?</span>
      <div class="ac-body">
        <div class="ac-title" id="ac-title">Onay</div>
        <div class="ac-text" id="ac-text"></div>
        <div class="ac-actions">
          <button type="button" class="ac-btn cancel" id="ac-cancel">Vazgeç</button>
          <button type="button" class="ac-btn primary" id="ac-ok">Tamam</button>
        </div>
      </div>
    </div>
  </div>
  <script>
  (function() {
    var backdrop = document.getElementById('admin-confirm-backdrop');
    var card = document.getElementById('admin-confirm');
    var iconEl = document.getElementById('ac-icon');
    var titleEl = document.getElementById('ac-title');
    var textEl = document.getElementById('ac-text');
    var okBtn = document.getElementById('ac-ok');
    var cancelBtn = document.getElementById('ac-cancel');
    var resolveFn = null;

    function close(result) {
      if (!resolveFn) return;
      var r = resolveFn; resolveFn = null;
      backdrop.classList.remove('show');
      setTimeout(function() { backdrop.classList.add('hidden'); }, 200);
      document.removeEventListener('keydown', onKey, true);
      r(result);
    }
    function onKey(e) {
      if (!resolveFn) return;
      if (e.key === 'Escape') { e.preventDefault(); close(false); }
      else if (e.key === 'Enter') {
        var ae = document.activeElement;
        if (ae === cancelBtn || ae === okBtn) return; // buton zaten native click tetikler
        e.preventDefault(); close(true);
      }
      else if (e.key === 'Tab') {
        var other = cancelBtn.classList.contains('hidden') ? okBtn : (document.activeElement === okBtn ? cancelBtn : okBtn);
        if (other !== document.activeElement) { e.preventDefault(); other.focus(); }
      }
    }

    function adminConfirm(message, opts) {
      opts = opts || {};
      if (resolveFn) close(false);
      var danger = opts.danger !== undefined ? !!opts.danger : /silinsin|sil\b|reddet|kalıcı/i.test(message || '');
      card.className = 'admin-confirm ' + (danger ? 'danger' : 'info');
      iconEl.textContent = danger ? '!' : 'i';
      titleEl.textContent = opts.title || (danger ? 'Bu işlemi onaylıyor musunuz?' : 'Onay');
      textEl.textContent = message || '';
      okBtn.textContent = opts.okText || (danger ? 'Evet, sil' : 'Tamam');
      okBtn.className = 'ac-btn ' + (danger ? 'danger' : 'primary');
      cancelBtn.classList.toggle('hidden', !!opts.single);
      backdrop.classList.remove('hidden');
      requestAnimationFrame(function() { requestAnimationFrame(function() { backdrop.classList.add('show'); }); });
      document.addEventListener('keydown', onKey, true);
      cancelBtn.focus();
      return new Promise(function(res) { resolveFn = res; });
    }
    window.adminConfirm = adminConfirm;
    window.adminAlert = function(message, title) { return adminConfirm(message, { single: true, title: title, okText: 'Tamam' }); };

    okBtn.addEventListener('click', function() { close(true); });
    cancelBtn.addEventListener('click', function() { close(false); });
    backdrop.addEventListener('click', function(e) { if (e.target === backdrop) close(false); });
    function submitForm(form) { HTMLFormElement.prototype.submit.call(form); }
    document.addEventListener('submit', function(e) {
      var form = e.target;
      var msg = form.getAttribute && form.getAttribute('data-confirm');
      if (!msg) return;
      e.preventDefault();
      adminConfirm(msg).then(function(ok) { if (ok) submitForm(form); });
    });
    document.addEventListener('click', function(e) {
      var btn = e.target.closest && e.target.closest('button[data-confirm], a[data-confirm]');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      adminConfirm(btn.getAttribute('data-confirm')).then(function(ok) {
        if (!ok) return;
        if (btn.form) submitForm(btn.form);
        else {
          btn.removeAttribute('data-confirm');
          btn.click();
        }
      });
    });
  })();
  </script>

  <!-- GA4 olaylari: sayfa bazli donusum olcumu -->
  <script>
  (function() {
    if (typeof gtag !== 'function') return;
    var p = window.location.pathname.replace(/^\/(en|ru|ar)(?=\/|$)/, '') || '/';
    var qs = new URLSearchParams(window.location.search);
    if (p === '/deniz') gtag('event', 'view_sea');
    if (p === '/etkinlikler') gtag('event', 'view_events');
    if (p === '/gizlilik') gtag('event', 'view_privacy');
    if (qs.get('gonderildi') === '1' && p === '/duyurular') gtag('event', 'ilan_submitted');
  })();
  </script>
