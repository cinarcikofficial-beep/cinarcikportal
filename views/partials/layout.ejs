  <script>
  window.__i18n = <%- JSON.stringify({ loading: t('loading'), goldGram: t('goldGram'), goldQuarter: t('goldQuarter'), lastUpdate: t('lastUpdate'), forecastLoad: t('forecastLoad'), forecastError: t('forecastError'), connError: t('connError'), noData: t('noData'), today: t('today'), historical: t('historical'), forecastTitle7: t('forecastTitle7'), forecastTitle15: t('forecastTitle15'), forecastTitleMonth: t('forecastTitleMonth'), forecastReal: t('forecastReal'), forecastHist: t('forecastHist') }) %>;
  (function() {
    var cache = null;
    var lastFetch = 0;
    var CACHE_MS = 5 * 60 * 1000;
    var forecastData = null;

    function formatNum(v) {
      if (!v || v === '--') return '--';
      var s = String(v).replace(/[^0-9.,-]/g, '');
      s = s.replace(/\.(?=\d{3}(?:,|$))/g, '');
      var n = parseFloat(s.replace(',', '.'));
      if (isNaN(n)) return v;
      return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function renderTicker(d) {
      var el = document.getElementById('ticker-content');
      if (!el) return;
      var h = '';

      function changeHtml(changeStr) {
        if (!changeStr) return '';
        var clean = changeStr.replace('%', '').replace(',', '.');
        var val = parseFloat(clean);
        if (isNaN(val)) return '';
        if (val > 0) return ' <span class="text-emerald-400 text-[10px] font-bold">↑' + changeStr + '</span>';
        if (val < 0) return ' <span class="text-red-400 text-[10px] font-bold">↓' + changeStr + '</span>';
        return ' <span class="text-zinc-500 text-[10px]">→' + changeStr + '</span>';
      }

      // Hava Durumu — ticker'da (üst satır)
      var wInner = '<span class="text-emerald-200/90">Çınarcık</span> ' +
        '<span class="w-ic">' + (d.weather.icon || '') + '</span> ' +
        '<span class="text-white font-bold">' + d.weather.temp + '</span> ' +
        '<span class="text-emerald-100/70">' + d.weather.description + '</span>' +
        ' <span class="text-emerald-300/70 text-[10px]">▸</span>';
      h += '<span class="ticker-item ticker-weather" onclick="openWeatherModal()" style="cursor:pointer" title="Tahmini gör">' + wInner + '</span>';
      h += '<span class="ticker-sep">|</span>';
      // Döviz
      h += '<span class="ticker-item"><span class="text-zinc-500">USD</span> <span class="text-emerald-400 font-semibold">' + formatNum(d.usd) + ' ₺</span>' + changeHtml(d.usdChange) + '</span>';
      h += '<span class="ticker-sep">|</span>';
      h += '<span class="ticker-item"><span class="text-zinc-500">EUR</span> <span class="text-emerald-400 font-semibold">' + formatNum(d.eur) + ' ₺</span>' + changeHtml(d.eurChange) + '</span>';
      h += '<span class="ticker-sep">|</span>';
      // Altın
      h += '<span class="ticker-item"><span class="text-zinc-500">' + window.__i18n.goldGram + '</span> <span class="text-amber-400 font-semibold">' + formatNum(d.gramAltin) + ' ₺</span>' + changeHtml(d.gramChange) + '</span>';
      h += '<span class="ticker-sep">|</span>';
      h += '<span class="ticker-item"><span class="text-zinc-500">' + window.__i18n.goldQuarter + '</span> <span class="text-amber-400 font-semibold">' + formatNum(d.ceYrekAltin) + ' ₺</span>' + changeHtml(d.ceYrekChange) + '</span>';
      h += '<span class="ticker-sep">|</span>';
      // BIST
      h += '<span class="ticker-item"><span class="text-zinc-500">BIST 100</span> <span class="text-sky-400 font-semibold">' + formatNum(d.bist100) + '</span>' + changeHtml(d.bistChange) + '</span>';
    // Güncelleme (saat her zaman sağda sabit görünür)
    var upd = document.getElementById('ticker-updated');
    if (upd) {
      if (d.updated) {
        upd.textContent = window.__i18n.lastUpdate + ': ' + d.updated;
        upd.classList.remove('hidden');
      } else {
        upd.classList.add('hidden');
      }
    }
    el.innerHTML = h;
    }

    function loadTicker() {
      var now = Date.now();
      if (cache && (now - lastFetch) < CACHE_MS) { renderTicker(cache); return; }
      fetch('/api/ticker-data')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          cache = d;
          lastFetch = Date.now();
          renderTicker(d);
        })
        .catch(function() {
          if (cache) renderTicker(cache);
        });
    }

    // ---- Hava Durumu Modal ----
    window.openWeatherModal = function() {
      document.getElementById('weather-modal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      loadForecast('week');
      if (typeof gtag === 'function') gtag('event', 'open_weather');
    };

    window.closeWeatherModal = function() {
      document.getElementById('weather-modal').classList.add('hidden');
      document.body.style.overflow = '';
    };

    window.showForecastTab = function(tab) {
      document.querySelectorAll('#weather-modal [id^="tab-"]').forEach(function(t) {
        t.className = 'flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-transparent text-zinc-500 hover:text-zinc-300';
      });
      var active = document.getElementById('tab-' + tab);
      if (active) active.className = 'flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-emerald-500 text-emerald-400';
      renderForecast(forecastData, tab);
    };

    function loadForecast(tab) {
      var container = document.getElementById('forecast-content');
      if (forecastData) {
        renderForecast(forecastData, tab);
        return;
      }
      container.innerHTML = '<div class="text-center text-zinc-500 py-8">' + window.__i18n.forecastLoad + '</div>';
      fetch('/api/weather-forecast')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.success && d.forecast && d.forecast.length > 0) {
            forecastData = d.forecast;
            renderForecast(forecastData, tab);
          } else {
            container.innerHTML = '<div class="text-center text-red-400 py-8">' + window.__i18n.forecastError + '</div>';
          }
        })
        .catch(function(err) {
          container.innerHTML = '<div class="text-center text-red-400 py-8">' + window.__i18n.connError + ': ' + err.message + '</div>';
        });
    }

    function renderForecast(data, tab) {
      var container = document.getElementById('forecast-content');
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="text-center text-zinc-500 py-8">' + window.__i18n.noData + '</div>';
        return;
      }
      var days;
      var title;
      if (tab === 'week') {
        days = data.slice(0, 7);
        title = window.__i18n.forecastTitle7;
      } else if (tab === '15days') {
        days = data.slice(0, 15);
        title = window.__i18n.forecastTitle15;
      } else {
        days = data;
        var realCount = data.filter(function(f){ return f.isForecast; }).length;
        var histCount = data.length - realCount;
        title = window.__i18n.forecastTitleMonth + ' — ' + data.length + ' Gün';
        if (histCount > 0) title += ' (' + realCount + ' ' + window.__i18n.forecastReal + ' + ' + histCount + ' ' + window.__i18n.forecastHist + ')';
      }

      var h = '<p class="text-zinc-500 text-xs mb-3">' + title + '</p>';
      h += '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">';
      days.forEach(function(f) {
        var isToday = f.date === new Date().toISOString().slice(0, 10);
        var borderClass = isToday ? ' ring-1 ring-emerald-500/40 border-emerald-500/30' : '';
        if (!f.isForecast) borderClass += ' border-dashed';
        h += '<div class="bg-zinc-800/80 border border-zinc-700/50 rounded-xl p-3 text-center transition hover:border-emerald-500/50' + borderClass + '">';
        h += '  <p class="text-zinc-400 text-[11px] font-medium">' + f.dayName + '</p>';
        h += '  <p class="text-white text-sm font-bold">' + f.dayNum + ' ' + f.month + '</p>';
        if (isToday) h += '  <span class="inline-block bg-emerald-500/20 text-emerald-400 text-[9px] font-bold px-1.5 py-0.5 rounded mt-0.5">' + window.__i18n.today + '</span>';
        else if (!f.isForecast) h += '  <span class="inline-block bg-zinc-600/30 text-zinc-500 text-[9px] px-1.5 py-0.5 rounded mt-0.5">' + window.__i18n.historical + '</span>';
        h += '  <div class="text-3xl my-2">' + f.icon + '</div>';
        h += '  <p class="text-white font-bold text-lg">' + f.tempMax + '° <span class="text-zinc-500 font-normal text-sm">' + f.tempMin + '°</span></p>';
        h += '  <p class="text-zinc-500 text-[11px] mt-1">' + f.description + '</p>';
        h += '  <div class="flex items-center justify-center gap-2 mt-2 text-[10px] text-zinc-500">';
        h += '    <span>💧%' + f.rainChance + '</span>';
        h += '    <span>💨' + f.wind + ' km/s</span>';
        h += '  </div>';
        h += '</div>';
      });
      h += '</div>';
      container.innerHTML = h;
    }

    // ESC ile kapat
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeWeatherModal();
    });

    loadTicker();
    setInterval(loadTicker, CACHE_MS);

    function translatePage() {
      if (!window.__t) return;
      // internal link/form prefixing
      var lp = document.documentElement.getAttribute('data-lp') || '';
      document.querySelectorAll('a[href]').forEach(function(a) {
        var h = a.getAttribute('href');
        if (h && h.charAt(0) === '/' && h.indexOf('//') !== 0 && h.indexOf(lp + '/') !== 0 && !/^\/(en|ru|ar)(\/|$)/.test(h) && h.indexOf('/api/') !== 0 && h.indexOf('/img/') !== 0 && h.indexOf('/css/') !== 0 && h.indexOf('/auth/') !== 0) {
          a.setAttribute('href', lp + h);
        }
      });
      document.querySelectorAll('form[action]').forEach(function(f) {
        var a = f.getAttribute('action');
        if (a && a.charAt(0) === '/' && a.indexOf(lp + '/') !== 0 && !/^\/(en|ru|ar)(\/|$)/.test(a) && a.indexOf('/api/') !== 0) {
          f.setAttribute('action', lp + a);
        }
      });
    }
    document.addEventListener('DOMContentLoaded', translatePage);

    // ---- Dil dropdown (Windows'ta emoji bayrak render edilmez; PNG bayrak kullanılır) ----
    var langBtn = document.getElementById('lang-btn');
    var langMenu = document.getElementById('lang-menu');
    var langWrap = document.getElementById('lang-dropdown');
    if (langBtn && langMenu && langWrap) {
      langBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var hidden = langMenu.classList.toggle('hidden');
        langBtn.setAttribute('aria-expanded', hidden ? 'false' : 'true');
      });
      document.addEventListener('click', function(e) {
        if (!langMenu.classList.contains('hidden') && !langWrap.contains(e.target)) {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // ---- Mobil menü ----
    var menuBtn = document.getElementById('menu-toggle');
    var mainNav = document.getElementById('main-nav');
    if (menuBtn && mainNav) {
      menuBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = mainNav.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', function(e) {
        if (mainNav.classList.contains('open') && !mainNav.contains(e.target)) {
          mainNav.classList.remove('open');
          menuBtn.setAttribute('aria-expanded', 'false');
        }
      });
      mainNav.querySelectorAll('a').forEach(function(a) {
        a.addEventListener('click', function() {
          mainNav.classList.remove('open');
          menuBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }

    var tBtn = document.getElementById('theme-toggle');
    if (tBtn) {
      if (localStorage.getItem('theme') === 'light') { document.documentElement.classList.add('light'); tBtn.textContent = '🌙'; }
      tBtn.addEventListener('click', function() {
        document.documentElement.classList.toggle('light');
        var on = document.documentElement.classList.contains('light');
        localStorage.setItem('theme', on ? 'light' : 'dark');
        tBtn.textContent = on ? '🌙' : '☀️';
      });
    }

    document.querySelectorAll('img').forEach(function(img) {
      if (!img.src || (img.src.indexOf('logo-circle') === -1 && img.id.indexOf('manset') === -1 && img.id.indexOf('hero') === -1)) {
        img.loading = 'lazy';
        img.decoding = 'async';
      }
    });
  })();
  </script>

  <!-- Windows 11 tarzı köşe bildirimi: server ?msg=&mtype= ile flash() gönderir -->
  <div class="admin-toast-root" id="admin-toast-root" aria-live="polite"></div>
  <script>
  (function() {
    var ICONS = { success: '✓', info: 'i', error: '✕' };
    var TITLES = { success: 'İşlem tamamlandı', info: 'Bilgi', error: 'Hata' };
    function adminToast(text, type, title) {
      var root = document.getElementById('admin-toast-root');
      if (!root || !text) return;
      type = (type && ICONS[type]) ? type : 'success';
      while (root.children.length >= 4) root.removeChild(root.firstChild);
      var el = document.createElement('div');
      el.className = 'admin-toast t-' + type;
      var icon = document.createElement('span');
      icon.className = 'at-icon';
      icon.textContent = ICONS[type];
      var body = document.createElement('div');
      body.className = 'at-body';
      var t = document.createElement('div');
      t.className = 'at-title';
      t.textContent = title || TITLES[type];
      var m = document.createElement('div');
      m.className = 'at-text';
      m.textContent = text;
      body.appendChild(t); body.appendChild(m);
      var close = document.createElement('button');
      close.className = 'at-close';
      close.setAttribute('aria-label', 'Kapat');
      close.innerHTML = '&times;';
      var prog = document.createElement('span');
      prog.className = 'at-progress';
      el.appendChild(icon); el.appendChild(body); el.appendChild(close); el.appendChild(prog);
      root.appendChild(el);
      requestAnimationFrame(function() { requestAnimationFrame(function() { el.classList.add('show'); }); });
      var timer = setTimeout(dismiss, 4500);
      function dismiss() {
        clearTimeout(timer);
        el.classList.remove('show');
        el.classList.add('hide');
        setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 450);
      }
      close.addEventListener('click', dismiss);
      el.addEventListener('click', function(e) { if (e.target !== close) dismiss(); });
      return el;
    }
    window.adminToast = adminToast;

    var params = new URLSearchParams(window.location.search);
    if (params.get('msg')) {
      adminToast(params.get('msg'), params.get('mtype') || 'success');
      params.delete('msg'); params.delete('mtype');
      var qs = params.toString();
      window.history.replaceState({}, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
    }
  })();
  </script>

  <!-- Windows 11 tarzı onay diyaloğu: data-confirm'li form/butonlar + adminConfirm()/adminAlert() -->
  <div class="admin-confirm-backdrop hidden" id="admin-confirm-backdrop" role="dialog" aria-modal="true" aria-labelledby="ac-title">
    <div class="admin-confirm" id="admin-confirm">
      <span class="ac-icon" id="ac-icon">?</span>
      <div class="ac-body">
        <div class="ac-title" id="ac-title">Onay</div>
        <div class="ac-text" id="ac-text"></div>
        <div class="ac-actions">
          <button type="button" class="ac-btn cancel" id="ac-cancel">Vazgeç</button>
          <button type="button" class="ac-btn primary" id="ac-ok">Tamam</button>
        </div>
      </div>
    </div>
  </div>
  <script>
  (function() {
    var backdrop = document.getElementById('admin-confirm-backdrop');
    var card = document.getElementById('admin-confirm');
    var iconEl = document.getElementById('ac-icon');
    var titleEl = document.getElementById('ac-title');
    var textEl = document.getElementById('ac-text');
    var okBtn = document.getElementById('ac-ok');
    var cancelBtn = document.getElementById('ac-cancel');
    var resolveFn = null;

    function close(result) {
      if (!resolveFn) return;
      var r = resolveFn; resolveFn = null;
      backdrop.classList.remove('show');
      setTimeout(function() { backdrop.classList.add('hidden'); }, 200);
      document.removeEventListener('keydown', onKey, true);
      r(result);
    }
    function onKey(e) {
      if (!resolveFn) return;
      if (e.key === 'Escape') { e.preventDefault(); close(false); }
      else if (e.key === 'Enter') {
        var ae = document.activeElement;
        if (ae === cancelBtn || ae === okBtn) return; // buton zaten native click tetikler
        e.preventDefault(); close(true);
      }
      else if (e.key === 'Tab') {
        var other = cancelBtn.classList.contains('hidden') ? okBtn : (document.activeElement === okBtn ? cancelBtn : okBtn);
        if (other !== document.activeElement) { e.preventDefault(); other.focus(); }
      }
    }

    function adminConfirm(message, opts) {
      opts = opts || {};
      if (resolveFn) close(false);
      var danger = opts.danger !== undefined ? !!opts.danger : /silinsin|sil\b|reddet|kalıcı/i.test(message || '');
      card.className = 'admin-confirm ' + (danger ? 'danger' : 'info');
      iconEl.textContent = danger ? '!' : 'i';
      titleEl.textContent = opts.title || (danger ? 'Bu işlemi onaylıyor musunuz?' : 'Onay');
      textEl.textContent = message || '';
      okBtn.textContent = opts.okText || (danger ? 'Evet, sil' : 'Tamam');
      okBtn.className = 'ac-btn ' + (danger ? 'danger' : 'primary');
      cancelBtn.classList.toggle('hidden', !!opts.single);
      backdrop.classList.remove('hidden');
      requestAnimationFrame(function() { requestAnimationFrame(function() { backdrop.classList.add('show'); }); });
      document.addEventListener('keydown', onKey, true);
      cancelBtn.focus();
      return new Promise(function(res) { resolveFn = res; });
    }
    window.adminConfirm = adminConfirm;
    window.adminAlert = function(message, title) { return adminConfirm(message, { single: true, title: title, okText: 'Tamam' }); };

    okBtn.addEventListener('click', function() { close(true); });
    cancelBtn.addEventListener('click', function() { close(false); });
    backdrop.addEventListener('click', function(e) { if (e.target === backdrop) close(false); });
    function submitForm(form) { HTMLFormElement.prototype.submit.call(form); }
    document.addEventListener('submit', function(e) {
      var form = e.target;
      var msg = form.getAttribute && form.getAttribute('data-confirm');
      if (!msg) return;
      e.preventDefault();
      adminConfirm(msg).then(function(ok) { if (ok) submitForm(form); });
    });
    document.addEventListener('click', function(e) {
      var btn = e.target.closest && e.target.closest('button[data-confirm], a[data-confirm]');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      adminConfirm(btn.getAttribute('data-confirm')).then(function(ok) {
        if (!ok) return;
        if (btn.form) submitForm(btn.form);
        else {
          btn.removeAttribute('data-confirm');
          btn.click();
        }
      });
    });
  })();
  </script>

  <!-- GA4 olaylari: sayfa bazli donusum olcumu -->
  <script>
  (function() {
    if (typeof gtag !== 'function') return;
    var p = window.location.pathname.replace(/^\/(en|ru|ar)(?=\/|$)/, '') || '/';
    var qs = new URLSearchParams(window.location.search);
    if (p === '/deniz') gtag('event', 'view_sea');
    if (p === '/ulasim') gtag('event', 'view_ulasim');
    if (p === '/etkinlikler') gtag('event', 'view_events');
    if (p === '/gizlilik') gtag('event', 'view_privacy');
    if (qs.get('gonderildi') === '1' && p === '/duyurular') gtag('event', 'ilan_submitted');
  })();
  </script>
