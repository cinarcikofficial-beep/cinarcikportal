  <script>
  (function() {
    if (typeof gtag !== 'function') return;
    var p = window.location.pathname.replace(/^\/(en|ru|ar)(?=\/|$)/, '') || '/';
    var qs = new URLSearchParams(window.location.search);
    if (p === '/deniz') gtag('event', 'view_sea');
    if (p === '/ulasim') gtag('event', 'view_ulasim');
    if (p === '/etkinlikler') gtag('event', 'view_events');
    if (p === '/gizlilik') gtag('event', 'view_privacy');
    if (qs.get('gonderildi') === '1' && p === '/duyurular') gtag('event', 'ilan_submitted');
  })();
