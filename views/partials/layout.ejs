<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>" data-lp="<%= lp %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Marmara'nın İncisi | <%= typeof pageTitle !== 'undefined' ? pageTitle : t('defaultPageTitle') %></title>
  <link rel="icon" type="image/png" href="/img/logo-circle.png">
  <link rel="stylesheet" href="/css/tailwind.css">
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('metaDesc') %>">
  <meta name="google-site-verification" content="CzjrSopLFPONrxTH1m5RDQ7bft0jSV1u52Du475UUUM">

  <!-- Google tag (GA4) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HPNR24RP48"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HPNR24RP48');
  </script>

  <!-- LCP: anasayfa hero/manşet ilk görseli -->
  <% (typeof preloadImages !== 'undefined' && preloadImages ? preloadImages : []).forEach(function(pu) { %>
    <link rel="preload" as="image" href="<%= pu %>" fetchpriority="high">
  <% }); %>

  <!-- Canonical + Hreflang -->
  <link rel="canonical" href="<%= siteUrl %><%= lp %><%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="tr" href="<%= siteUrl %><%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="en" href="<%= siteUrl %>/en<%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="ru" href="<%= siteUrl %>/ru<%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="ar" href="<%= siteUrl %>/ar<%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="de" href="<%= siteUrl %>/de<%= path === '/' ? '/' : path %>">
  <link rel="alternate" hreflang="x-default" href="<%= siteUrl %><%= path === '/' ? '/' : path %>">

  <!-- Open Graph -->
  <meta property="og:title" content="Marmara'nın İncisi | <%= typeof pageTitle !== 'undefined' ? pageTitle : t('defaultPageTitle') %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('metaDescShort') %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:url" content="<%= siteUrl %><%= lp %><%= path === '/' ? '/' : path %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : siteUrl + '/img/logo-circle.png' %>">
  <meta property="og:site_name" content="Marmara'nın İncisi">
  <meta property="og:locale" content="<%= lang === 'ar' ? 'ar_AR' : lang === 'en' ? 'en_US' : lang + '_' + lang.toUpperCase() %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Marmara'nın İncisi | <%= typeof pageTitle !== 'undefined' ? pageTitle : t('defaultPageTitle') %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('metaDescShort') %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : siteUrl + '/img/logo-circle.png' %>">

  <meta name="robots" content="<%= typeof robotsMeta !== 'undefined' ? robotsMeta : 'index, follow' %>">
  <link rel="alternate" type="application/rss+xml" title="Marmara'nın İncisi — Haberler RSS" href="/rss.xml">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Poppins:wght@400;800&display=swap" rel="stylesheet">
  <script>try{if(localStorage.getItem('theme')==='light')document.documentElement.classList.add('light');}catch(e){}</script>

  <!-- JSON-LD: Site + Organization (her sayfada) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "<%= siteUrl %>/#website",
        "url": "<%= siteUrl %>/",
        "name": "Marmara'nın İncisi",
        "description": "<%= t('metaDesc') %>",
        "inLanguage": "tr-TR",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "<%= siteUrl %>/haberler?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Organization",
        "@id": "<%= siteUrl %>/#organization",
        "name": "Marmara'nın İncisi",
        "url": "<%= siteUrl %>/",
        "logo": "<%= siteUrl %>/img/logo-circle.png",
        "sameAs": [
          "https://maps.google.com/?cid=14140722854821185587"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Çınarcık",
          "addressRegion": "Yalova",
          "addressCountry": "TR"
        },
        "areaServed": {
          "@type": "City",
          "name": "Çınarcık",
          "addressRegion": "Yalova",
          "addressCountry": "TR"
        }
      }
    ]
  }
  </script>

  <!-- Sayfaya özel JSON-LD (haber, mekan vb.) -->
  <% if (typeof pageSchema !== 'undefined' && pageSchema) { %>
  <script type="application/ld+json"><%- JSON.stringify(pageSchema) %></script>
  <% } %>
</head>
<body class="text-white" style="min-height:100vh;display:flex;flex-direction:column;">

  <!-- CANLI BİLGİ ÇUBUĞU (En Üst) -->
  <div id="ticker-bar" class="bg-zinc-950 border-b border-zinc-800 text-xs">
    <div class="max-w-[90rem] mx-auto px-4 py-1.5 flex items-center gap-2 lg:gap-3 xl:gap-4">
      <!-- Logo genişliği kadar boşluk: ticker ilk öğe ("Çınarcık") nav'daki "Ana Sayfa" ile dikey hizalanır -->
      <span class="hidden lg:block shrink-0 w-14 sm:w-16 md:w-20 xl:w-24" aria-hidden="true"></span>
      <div class="flex-1 min-w-0 overflow-x-auto whitespace-nowrap" id="ticker-content">
        <span class="text-zinc-500"><%= t('loading') %></span>
      </div>
      <span id="ticker-updated" class="hidden max-sm:hidden shrink-0 text-zinc-500 pl-3 border-l border-zinc-800 whitespace-nowrap"></span>
    </div>
  </div>

  <header class="site-header bg-zinc-900 bg-opacity-80 backdrop-blur-md sticky top-0 z-50 w-full shadow-md" role="banner">
    <div class="max-w-[90rem] mx-auto flex items-center justify-between px-4 py-1">
      <div class="flex items-center gap-2 lg:gap-3 xl:gap-4 min-w-0">
      <a href="/" class="flex items-center shrink-0" aria-label="<%= t('homeAria') %>">
        <div class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 xl:w-24 xl:h-24 rounded-full overflow-hidden border-2 border-white/30 ring-2 ring-emerald-500/40 shadow-xl shadow-black/50 bg-white">
          <img src="/img/logo-circle.png" alt="<%= t('logoAlt') %>" class="w-full h-full object-cover">
        </div>
      </a>
      <nav id="main-nav" class="main-nav hidden lg:flex items-center gap-1 xl:gap-1.5 text-[13px] xl:text-sm font-semibold whitespace-nowrap">
        <a href="<%= lp %>/" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">🏠 </span><%= t('home') %></a>
        <a href="<%= lp %>/haberler" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= (path === '/haberler' || path.startsWith('/haber/')) ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">📰 </span><%= t('news') %></a>
        <a href="<%= lp %>/duyurular" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/duyurular' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">📢 </span><%= t('announcements') %></a>
        <a href="<%= lp %>/etkinlikler" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/etkinlikler' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">🗓️ </span><%= t('events') %></a>
        <a href="<%= lp %>/mekanlar" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= (path === '/mekanlar' || path.startsWith('/mekan/')) ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">📍 </span><%= t('places') %></a>
        <a href="<%= lp %>/rehber" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= (path === '/rehber' || path.startsWith('/rehber/')) ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">🏢 </span><%= t('guide') %></a>
        <a href="<%= lp %>/gezilecek-yerler" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/gezilecek-yerler' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">🧳 </span><%= t('sightseeing') %></a>
        <a href="<%= lp %>/cinarcik-hakkinda" class="px-2.5 xl:px-3 py-2 rounded-full transition-all <%= path === '/cinarcik-hakkinda' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-500/10' : 'text-zinc-300 hover:text-emerald-300 hover:bg-zinc-800/80 border border-transparent' %>"><span class="<%= isAdmin ? 'hidden' : 'hidden xl:inline' %>">ℹ️ </span><%= t('about') %></a>
      </nav>
      </div>
      <div class="nav-right flex items-center gap-1.5 sm:gap-2">
        <span class="inline-flex items-center gap-1 relative" id="lang-dropdown">
          <button id="lang-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Dil seçimi" title="Dil seçimi"
            class="px-2 py-1.5 rounded-lg bg-zinc-800 text-zinc-200 border border-zinc-700 text-sm font-semibold cursor-pointer hover:border-emerald-500/50 focus:border-emerald-500/60 focus:outline-none transition flex items-center gap-1.5">
            <img src="https://flagcdn.com/w40/<%= ({tr:'tr',en:'gb',ru:'ru',ar:'sa',de:'de'})[lang] %>.png" alt="" class="w-5 h-auto rounded-[1px]" onerror="this.style.display='none'" />
            <span><%= lang.toUpperCase() %></span>
          </button>
          <div id="lang-menu" class="hidden absolute right-0 top-full mt-1 w-40 bg-zinc-800 border border-zinc-700 rounded-lg shadow-xl z-[60] py-1 overflow-hidden">
            <% [['tr','tr','Türkçe'],['en','gb','English'],['ru','ru','Русский'],['ar','sa','العربية'],['de','de','Deutsch']].forEach(function(item){ %>
              <% var l = item[0]; var langHref = (l === 'tr' ? '' : '/' + l) + (path === '/' ? '/' : path); %>
              <a href="<%= langHref %>" class="flex items-center gap-2 px-3 py-2 text-sm <%= lang === l ? 'text-emerald-400 bg-zinc-700/50' : 'text-zinc-200 hover:bg-zinc-700' %> transition-colors">
                <img src="https://flagcdn.com/w40/<%= item[1] %>.png" alt="" class="w-5 h-auto rounded-[1px]" onerror="this.style.display='none'" />
                <%= item[2] %>
              </a>
            <% }); %>
          </div>
        </span>
        <button id="fav-open" type="button" aria-label="<%= t('favList') %>" title="<%= t('favList') %>" style="display:none"
          class="px-2.5 py-1.5 rounded-lg bg-zinc-800 text-amber-300 border border-zinc-700 hover:border-amber-500/50 focus:outline-none transition text-sm leading-none">★<span id="fav-count" class="fav-count" style="display:none">0</span></button>
        <button id="search-open" type="button" aria-label="<%= t('searchBtn') %>" title="<%= t('searchBtn') %> (Ctrl+K)" aria-haspopup="dialog"
          class="px-2.5 py-1.5 rounded-lg bg-zinc-800 text-zinc-200 border border-zinc-700 hover:border-emerald-500/50 focus:border-emerald-500/60 focus:outline-none transition text-sm leading-none">🔍</button>
        <button id="theme-toggle" title="<%= t('themeToggle') %>" class="px-3 py-1 rounded bg-zinc-800 text-white hover:bg-zinc-700 transition text-sm">☀️</button>
        <% if (isAdmin) { %>
          <a href="<%= lp %>/admin" class="hidden sm:inline-block lg:hidden xl:inline-block px-2.5 py-1 text-xs rounded bg-emerald-600 text-white hover:bg-emerald-500 transition"><%= t('management') %></a>
          <a href="<%= lp %>/admin/logout" class="hidden sm:inline-block lg:hidden xl:inline-block ml-2 px-2.5 py-1 text-xs rounded bg-gray-600 text-white hover:bg-gray-500 transition"><%= t('logout') %></a>
        <% } %>
      </div>
      <button id="menu-toggle" class="lg:hidden p-2 -mr-2 text-2xl text-white" aria-label="Menü" aria-expanded="false" aria-controls="main-nav">☰</button>
    </div>
  </header>

  <!-- HAVA DURUMU TAHMİN MODALİ -->
  <div id="weather-modal" class="fixed inset-0 z-[100] hidden" onclick="if(event.target===this)closeWeatherModal()">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
    <div class="relative w-auto max-w-4xl mt-6 sm:mt-16 mb-8 mx-4 sm:mx-auto bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl overflow-hidden max-h-[80vh] flex flex-col">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-800 bg-zinc-900/90 sticky top-0 z-10">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🌤️</span>
          <div>
            <h3 class="text-white font-bold text-lg"><%= t('weatherTitle') %></h3>
            <p class="text-zinc-500 text-xs"><%= t('weatherSub') %></p>
          </div>
        </div>
        <button onclick="closeWeatherModal()" class="text-zinc-400 hover:text-white text-2xl leading-none px-2 transition">&times;</button>
      </div>
      <!-- Tabs -->
      <div class="flex border-b border-zinc-800 bg-zinc-900/90 sticky top-[68px] z-10">
        <button onclick="showForecastTab('week')" id="tab-week" class="flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-emerald-500 text-emerald-400"><%= t('weekly') %></button>
        <button onclick="showForecastTab('15days')" id="tab-15days" class="flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-transparent text-zinc-500 hover:text-zinc-300"><%= t('days15') %></button>
        <button onclick="showForecastTab('month')" id="tab-month" class="flex-1 py-3 text-sm font-semibold text-center transition border-b-2 border-transparent text-zinc-500 hover:text-zinc-300"><%= t('monthly') %></button>
      </div>
      <!-- Content -->
      <div id="forecast-content" class="overflow-y-auto p-4 flex-1">
        <div class="text-center text-zinc-500 py-8"><%= t('loading') %></div>
      </div>
    </div>
  </div>

  <!-- HIZLI ARAMA PANELİ (Ctrl+K) — kapatma: ESC, ✕ butonu veya karanlık alana dokunma/tıklama -->
  <div id="search-modal" class="fixed inset-0 z-[110] hidden" role="dialog" aria-modal="true" aria-label="<%= t('searchBtn') %>">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeSearchModal()"></div>
    <div class="relative w-full max-w-2xl mt-10 sm:mt-24 mx-4 sm:mx-auto bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl overflow-hidden">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-zinc-800">
        <span class="text-zinc-500 text-lg" aria-hidden="true">🔍</span>
        <input id="search-input" type="search" autocomplete="off" spellcheck="false"
          placeholder="<%= t('searchPlaceholder') %>"
          class="flex-1 min-w-0 bg-transparent text-white placeholder-zinc-500 text-base outline-none py-1" />
        <kbd class="hidden md:inline-block text-[10px] text-zinc-500 border border-zinc-700 rounded px-1.5 py-0.5 select-none">ESC</kbd>
        <button type="button" id="search-close" aria-label="<%= t('close') %>" onclick="closeSearchModal()"
          class="shrink-0 w-9 h-9 -mr-1.5 flex items-center justify-center rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-700/60 active:scale-90 transition select-none">✕</button>
      </div>
      <div id="search-results" class="max-h-[45vh] sm:max-h-[60vh] overflow-y-auto overscroll-contain p-2"></div>
      <div id="search-status" class="text-zinc-500 text-sm text-center py-6 sm:py-8 px-4"><%= t('searchMinChars') %></div>
      <div class="px-4 py-2 border-t border-zinc-800 text-[11px] text-zinc-600 flex items-center justify-between gap-3 select-none">
        <a href="<%= lp %>/kaydettiklerim" id="search-favs-link" class="shrink-0 text-zinc-500 hover:text-amber-300 transition font-semibold">★ <%= t('favList') %> <span id="search-fav-count" class="fav-count" style="display:none">0</span></a>
        <span class="hidden sm:flex items-center gap-3 shrink-0">
          <span>↑ ↓ <%= t('searchBtn') %> · Enter</span>
          <span>Ctrl + K</span>
        </span>
      </div>
    </div>
  </div>

  <script>
  (function() {
    var S = <%- JSON.stringify({ minChars: t('searchMinChars'), noResults: t('searchNoResults'), loading: t('loading'), connError: t('connError'), favSaved: t('favSaved'), favRemove: t('favRemove'), favList: t('favList'), news: t('news'), places: t('places'), announcements: t('announcements'), sightseeing: t('sightseeing'), guide: t('guide') }) %>;
    var LP = '<%= typeof lp !== 'undefined' ? lp : '' %>';
    var modal = document.getElementById('search-modal');
    var input = document.getElementById('search-input');
    var resultsEl = document.getElementById('search-results');
    var statusEl = document.getElementById('search-status');
    var openBtn = document.getElementById('search-open');
    if (!modal || !input || !resultsEl || !statusEl || !openBtn) return;

    var TYPE_LABEL = { news: S.news, places: S.places, announcements: S.announcements, sightseeing: S.sightseeing, guide: S.guide };
    var items = [], active = -1, seq = 0, timer = null;
    var cache = new Map();

    // Favori sayacı: panel satırı + header'daki ★ butonu (ilk kayıttan sonra görünür)
    var favCountEl = document.getElementById('search-fav-count');
    var favOpenBtn = document.getElementById('fav-open');
    var favHeaderCount = document.getElementById('fav-count');
    function favTotal() {
      try { var v = JSON.parse(localStorage.getItem('cinarcik_favs_v1')); return Array.isArray(v) ? v.length : 0; }
      catch (e) { return 0; }
    }
    function syncFavs() {
      var n = favTotal();
      if (favCountEl) { favCountEl.textContent = n; favCountEl.style.display = n ? 'inline-flex' : 'none'; }
      if (favOpenBtn) favOpenBtn.style.display = n ? 'inline-flex' : 'none';
      if (favHeaderCount) { favHeaderCount.textContent = n; favHeaderCount.style.display = n ? 'inline-flex' : 'none'; }
    }
    window.addEventListener('favs:changed', syncFavs);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', syncFavs);
    else syncFavs();
    if (favOpenBtn) favOpenBtn.addEventListener('click', function() { location.href = LP + '/kaydettiklerim'; });

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function escRe(s) { return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
    function hl(text, q) {
      var e = esc(text);
      if (!q) return e;
      return e.replace(new RegExp('(' + escRe(esc(q)) + ')', 'ig'), '<mark>$1</mark>');
    }
    function setStatus(msg) {
      statusEl.textContent = msg || '';
      statusEl.classList.toggle('hidden', !msg);
    }
    function setActive(i) {
      if (!items.length) return;
      active = (i + items.length) % items.length;
      var els = resultsEl.querySelectorAll('.search-item');
      els.forEach(function(el, idx) { el.classList.toggle('is-active', idx === active); });
      if (els[active]) els[active].scrollIntoView({ block: 'nearest' });
    }
    function render(list, q, favMode) {
      items = list;
      active = list.length ? 0 : -1;
      if (!list.length) { resultsEl.innerHTML = ''; setStatus(S.noResults); return; }
      setStatus('');
      // Kaydedilenler arama ile entegrasyon: favorideki sonuçlar başa alınıp ★ rozeti alır
      var favs = (window.Favs && typeof window.Favs.has === 'function') ? window.Favs : null;
      var sorted = list.slice();
      if (favs) {
        sorted.sort(function(a, b) {
          var fa = favs.has(a.type, a.id) ? 1 : 0;
          var fb = favs.has(b.type, b.id) ? 1 : 0;
          return fb - fa;
        });
      }
      var html = '';
      sorted.forEach(function(it, i) {
        var saved = favs ? favs.has(it.type, it.id) : false;
        html += '<a class="search-item px-3 py-2.5 rounded-xl' + (i === 0 ? ' is-active' : '') + '" href="' + LP + esc(it.url) + '" data-i="' + i + '">'
          + '<span class="search-ic">' + esc(it.emoji) + '</span>'
          + '<span class="search-body">'
          + '<span class="search-title">' + hl(it.title, q)
          + (saved ? ' <span class="search-saved" title="' + esc(S.favSaved || '') + '">★</span>' : '')
          + '</span>'
          + (it.meta ? '<span class="search-meta">' + esc(it.meta) + '</span>' : '')
          + '</span>'
          + '<span class="search-type">' + esc(TYPE_LABEL[it.type] || '') + '</span>'
          + (favMode ? '<button type="button" class="search-fav-del" data-del-type="' + esc(it.type) + '" data-del-id="' + esc(it.id) + '" title="' + esc(S.favRemove || '') + '" aria-label="' + esc(S.favRemove || '') + '">✕</button>' : '')
          + '</a>';
      });
      resultsEl.innerHTML = html;
      resultsEl.querySelectorAll('.search-item').forEach(function(el) {
        el.addEventListener('mouseenter', function() { setActive(parseInt(el.dataset.i, 10)); });
      });
    }
    // Kaydettiklerim satırındaki ✕: favoriden kaldırır, satırı panelden siler (gezinmeyi engeller)
    resultsEl.addEventListener('click', function(e) {
      var b = e.target && e.target.closest ? e.target.closest('.search-fav-del') : null;
      if (!b) return;
      e.preventDefault();
      e.stopPropagation();
      window.Favs.remove(b.getAttribute('data-del-type'), String(b.getAttribute('data-del-id')));
      renderFavs();
    });
    function search(q) {
      var hint = resultsEl.parentElement.querySelector('.search-fav-hint');
      if (hint) hint.style.display = 'none';
      if (q.length < 2) { renderFavs(); return; }
      if (cache.has(q)) { render(cache.get(q), q); return; }
      var my = ++seq;
      setStatus(S.loading);
      fetch('/api/search?q=' + encodeURIComponent(q))
        .then(function(r) { if (!r.ok) throw new Error('http'); return r.json(); })
        .then(function(d) {
          if (my !== seq) return;
          var list = d.results || [];
          cache.set(q, list);
          if (cache.size > 40) cache.delete(cache.keys().next().value);
          render(list, q);
        })
        .catch(function() {
          if (my !== seq) return;
          items = []; resultsEl.innerHTML = ''; setStatus(S.connError);
        });
    }
    // Sorgu yokken kaydedilenleri öneri olarak listele
    function renderFavs() {
      var favs = (window.Favs && typeof window.Favs.list === 'function') ? window.Favs.list() : [];
      if (!favs.length) { items = []; resultsEl.innerHTML = ''; setStatus(S.minChars); return; }
      var list = favs.slice().reverse().slice(0, 8).map(function(f) {
        return { type: f.t, id: f.id, emoji: ({ news: '📰', places: '📍', announcements: '📢', sightseeing: '🧳', guide: '🏢' })[f.t] || '★', title: f.title, meta: '', url: f.u };
      });
      render(list, '', true);
      var lbl = resultsEl.parentElement.querySelector('.search-fav-hint');
      if (!lbl) {
        lbl = document.createElement('div');
        lbl.className = 'search-fav-hint px-4 pt-2 pb-1 text-[11px] text-zinc-500 uppercase tracking-wide';
        lbl.textContent = S.favList;
        resultsEl.parentElement.insertBefore(lbl, resultsEl);
      }
      lbl.style.display = '';
    }
    function openSearchModal() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
      input.select();
      renderFavs();
    }
    window.closeSearchModal = function() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    };

    openBtn.addEventListener('click', openSearchModal);
    input.addEventListener('input', function() {
      clearTimeout(timer);
      var q = input.value.trim();
      timer = setTimeout(function() { search(q); }, 200);
    });
    input.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') {
        var els = resultsEl.querySelectorAll('.search-item');
        if (els[active]) { e.preventDefault(); window.location.href = els[active].href; }
      }
    });
    document.addEventListener('keydown', function(e) {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        if (modal.classList.contains('hidden')) openSearchModal(); else window.closeSearchModal();
      } else if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        window.closeSearchModal();
      }
    });
  })();
  </script>

  <!-- MİKRO-ANİMASYONLAR: grid kartlarında scroll reveal (JS yoksa/reduced-motion: içerik görünür kalır) -->
  <script>
  (function() {
    function init() {
      if (location.pathname.indexOf('/admin') === 0) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var targets = [];
      document.querySelectorAll('main .grid').forEach(function(g) {
        if (g.closest('.hero, #slider, #hero-slider, [class*="hero"]')) return;
        if (g.classList.contains('no-reveal')) return;
        if (g.children.length < 2 || g.children.length > 40 || !g.querySelector('a')) return;
        Array.prototype.push.apply(targets, g.children);
      });
      if (!targets.length || !('IntersectionObserver' in window)) return;
      document.documentElement.classList.add('has-reveal');
      targets.forEach(function(el, i) {
        el.classList.add('reveal');
        el.style.setProperty('--rd', String(i % 8));
      });
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(en) {
          if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
        });
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.04 });
      targets.forEach(function(el) { io.observe(el); });
      // Güven ağı: 3 sn içinde hâlâ görünür olmayan (observer kaçırırsa) açılır
      setTimeout(function() { targets.forEach(function(el) { el.classList.add('in'); }); }, 3000);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
  </script>

  <!-- FAVORİLER: localStorage tabanlı kayıt (giriş gerektirmez) + [data-fav] buton yönetimi -->
  <script>
  (function() {
    var LABEL = <%- JSON.stringify({ add: t('favAdd'), saved: t('favSaved') }) %>;
    var KEY = 'cinarcik_favs_v1', CAP = 100;
    function read() {
      try { var v = JSON.parse(localStorage.getItem(KEY)); return Array.isArray(v) ? v : []; }
      catch (e) { return []; }
    }
    function write(list) { try { localStorage.setItem(KEY, JSON.stringify(list)); } catch (e) {} }
    function idx(list, t, id) {
      for (var i = 0; i < list.length; i++) if (list[i].t === t && String(list[i].id) === String(id)) return i;
      return -1;
    }
    function has(t, id) { return idx(read(), t, id) !== -1; }
    function toggle(entry) {
      var list = read(), i = idx(list, entry.t, String(entry.id));
      if (i !== -1) list.splice(i, 1);
      else {
        list.push({ t: entry.t, id: String(entry.id), u: entry.u, title: entry.title, img: entry.img || '', ts: Date.now() });
        if (list.length > CAP) list.shift();
      }
      write(list);
      window.dispatchEvent(new CustomEvent('favs:changed'));
      return i === -1;
    }
    function remove(t, id) {
      var list = read(), i = idx(list, t, id);
      if (i !== -1) { list.splice(i, 1); write(list); window.dispatchEvent(new CustomEvent('favs:changed')); }
    }
    window.Favs = { list: read, has: has, toggle: toggle, remove: remove };

    function same(a, b) {
      return a.getAttribute('data-fav-type') === b.getAttribute('data-fav-type')
        && String(a.getAttribute('data-fav-id')) === String(b.getAttribute('data-fav-id'));
    }
    function paint(btn) {
      var on = has(btn.getAttribute('data-fav-type'), btn.getAttribute('data-fav-id'));
      btn.classList.toggle('is-saved', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.innerHTML = (on ? '♥' : '♡') + '<span>' + (on ? LABEL.saved : LABEL.add) + '</span>';
    }
    function paintAll() { document.querySelectorAll('[data-fav]').forEach(paint); }
    document.addEventListener('click', function(e) {
      var btn = e.target && e.target.closest ? e.target.closest('[data-fav]') : null;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      toggle({
        t: btn.getAttribute('data-fav-type'),
        id: btn.getAttribute('data-fav-id'),
        u: btn.getAttribute('data-fav-url'),
        title: btn.getAttribute('data-fav-title'),
        img: btn.getAttribute('data-fav-img')
      });
      document.querySelectorAll('[data-fav]').forEach(function(b) { if (same(b, btn)) paint(b); });
      btn.classList.remove('fav-pop');
      void btn.offsetWidth;
      btn.classList.add('fav-pop');
    });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', paintAll);
    else paintAll();
  })();
  </script>

