<!-- 📲 PWA: Ana Ekrana Ekle -->
<div id="pwa-install" class="hidden fixed left-3 right-3 bottom-3 sm:left-auto sm:right-5 sm:bottom-5 sm:w-96 z-[110] bg-zinc-900/95 backdrop-blur border border-emerald-500/30 rounded-2xl shadow-2xl p-4">
  <div class="flex items-start gap-3">
    <img src="/icons/icon-192.png" alt="Marmaraİncisi" width="48" height="48" class="w-12 h-12 rounded-xl shrink-0">
    <div class="min-w-0 flex-1">
      <p class="text-sm font-extrabold text-white">Marmaraİncisi'ni telefonuna ekle</p>
      <p id="pwa-install-text" class="text-xs text-zinc-400 mt-0.5 leading-snug">Seferler, nöbetçi eczane ve haberler tek dokunuşla — uygulama gibi açılır.</p>
    </div>
    <button type="button" id="pwa-close" aria-label="Kapat" class="text-zinc-500 hover:text-zinc-200 text-lg leading-none px-1">×</button>
  </div>
  <div class="flex gap-2 mt-3">
    <button type="button" id="pwa-install-btn" class="flex-1 bg-emerald-500 hover:bg-emerald-400 text-white text-sm font-bold rounded-xl py-2.5 transition-colors">📲 Ana Ekrana Ekle</button>
    <button type="button" id="pwa-later" class="px-4 text-xs font-semibold text-zinc-400 hover:text-zinc-200 bg-zinc-800 rounded-xl">Sonra</button>
  </div>
</div>
<script>
(function () {
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
  }
  var KEY = 'cinarcik_pwa_dismiss';
  var box = document.getElementById('pwa-install');
  if (!box) return;
  var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  if (standalone) { var navApp = document.getElementById('nav-app-icon-btn'); if (navApp) navApp.style.display = 'none'; }
  if (/\/uygulama$/.test(location.pathname)) return;
  var dismissedAt = Number(localStorage.getItem(KEY) || 0);
  if (standalone || (Date.now() - dismissedAt) < 7 * 86400000) return; // 7 gün sormaz
  if (location.pathname.indexOf('/admin') === 0) return;

  var deferred = null;
  var btn = document.getElementById('pwa-install-btn');
  function show() { setTimeout(function () { box.classList.remove('hidden'); }, 4000); }
  function hide(remember) { box.classList.add('hidden'); if (remember) localStorage.setItem(KEY, String(Date.now())); }

  window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); deferred = e; show(); });
  window.addEventListener('appinstalled', function () { hide(true); });

  // iOS Safari: otomatik kurulum yok → talimat göster
  var ua = navigator.userAgent;
  var isIOS = /iPhone|iPad|iPod/i.test(ua) && !/CriOS|FxiOS|EdgiOS/i.test(ua);
  if (isIOS) {
    document.getElementById('pwa-install-text').innerHTML = 'Safari\'de alttaki <b class="text-white">Paylaş ⬆️</b> simgesine, sonra <b class="text-white">“Ana Ekrana Ekle”</b>ye dokunun.';
    btn.textContent = 'Anladım';
    show();
  }

  btn.addEventListener('click', function () {
    if (deferred) {
      deferred.prompt();
      deferred.userChoice.finally(function () { deferred = null; hide(true); });
    } else { hide(true); }
  });
  document.getElementById('pwa-close').addEventListener('click', function () { hide(true); });
  document.getElementById('pwa-later').addEventListener('click', function () { hide(true); });
})();
</script>
