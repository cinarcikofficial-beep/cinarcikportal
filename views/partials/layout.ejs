  <script>
  (function() {
    var SITE_KEY = <%- JSON.stringify(typeof recaptchaSiteKey !== 'undefined' ? recaptchaSiteKey : '') %>;
    var LANG = <%- JSON.stringify(typeof lang !== 'undefined' ? lang : 'tr') %>;
    var NOT_ROBOT_TXT = <%- JSON.stringify((typeof t === 'function' ? t('notRobot') : 'Ben robot değilim').replace(/^🤖\s*/, '').replace(/\s*\*$/, '')) %>;
    var HINT_TXT = <%- JSON.stringify(typeof t === 'function' ? t('notRobotHint') : 'Lütfen "Ben robot değilim" kutusunu işaretleyin.') %>;
    var PRIVACY_TXT = ({ tr: 'Gizlilik · Şartlar', en: 'Privacy · Terms', ru: 'Конф. · Условия', ar: 'الخصوصية · البنود', de: 'Datenschutz · Bedingungen' })[LANG] || 'Gizlilik · Şartlar';

    function renderBuiltin(el) {
      if (el.dataset.rcRendered === 'builtin') return;
      el.dataset.rcRendered = 'builtin';
      el.innerHTML =
        '<div class="portal-rc-box" role="checkbox" aria-checked="false" tabindex="0">' +
          '<input type="hidden" name="g-recaptcha-response" value="">' +
          '<div class="portal-rc-left">' +
            '<div class="portal-rc-check">' +
              '<span class="portal-rc-icon"></span>' +
            '</div>' +
            '<span class="portal-rc-label">' + NOT_ROBOT_TXT + '</span>' +
          '</div>' +
          '<div class="portal-rc-brand">' +
            '<svg width="26" height="26" viewBox="0 0 64 64" fill="none" aria-hidden="true">' +
              '<path d="M32 8C19.8 8 9.7 16.8 7.5 28.4H16C18 21.3 24.4 16 32 16c5.3 0 10 2.5 13 6.4L39 28.4h17V11.4l-5.3 5.3C46.2 11.4 39.5 8 32 8z" fill="#4285F4"/>' +
              '<path d="M32 56c12.2 0 22.3-8.8 24.5-20.4H48c-2 7.1-8.4 12.4-16 12.4-5.3 0-10-2.5-13-6.4l6-6H8v17l5.3-5.3C17.8 52.6 24.5 56 32 56z" fill="#10b981"/>' +
            '</svg>' +
            '<span class="portal-rc-brand-title">reCAPTCHA</span>' +
            '<span class="portal-rc-brand-links"><a href="/gizlilik">' + PRIVACY_TXT + '</a></span>' +
          '</div>' +
        '</div>';

      var box = el.querySelector('.portal-rc-box');
      var hidden = el.querySelector('input[name="g-recaptcha-response"]');
      var iconWrap = el.querySelector('.portal-rc-icon');
      var busy = false;

      function triggerVerify() {
        if (busy || (hidden && hidden.value)) return;
        busy = true;
        box.classList.remove('rc-error');
        box.classList.add('rc-loading');
        iconWrap.innerHTML = '<span class="portal-rc-spinner"></span>';

        setTimeout(function() {
          fetch('/api/recaptcha-challenge', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ ts: Date.now() })
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            busy = false;
            box.classList.remove('rc-loading');
            if (data && data.success && data.token) {
              hidden.value = data.token;
              box.classList.add('rc-verified');
              box.setAttribute('aria-checked', 'true');
              iconWrap.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
            } else {
              box.classList.add('rc-error');
              iconWrap.innerHTML = '';
            }
          })
          .catch(function() {
            busy = false;
            box.classList.remove('rc-loading');
            box.classList.add('rc-error');
            iconWrap.innerHTML = '';
          });
        }, 280);
      }

      box.addEventListener('click', function(e) {
        if (e.target && e.target.tagName === 'A') return;
        triggerVerify();
      });
      box.addEventListener('keydown', function(e) {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          triggerVerify();
        }
      });
    }

    function renderGoogle(el) {
      if (el.dataset.rcRendered) return;
      try {
        if (typeof grecaptcha !== 'undefined' && grecaptcha && typeof grecaptcha.render === 'function') {
          el.dataset.rcRendered = 'google';
          var wid = grecaptcha.render(el, {
            sitekey: SITE_KEY,
            theme: document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark'
          });
          el.dataset.rcWidgetId = String(wid);
          return true;
        }
      } catch (e) {}
      return false;
    }

    function renderAll() {
      var list = document.querySelectorAll('.portal-recaptcha');
      if (!list.length) return;
      list.forEach(function(el) {
        if (SITE_KEY) {
          if (!renderGoogle(el) && window.__rcGoogleFallback) {
            renderBuiltin(el);
          }
        } else {
          renderBuiltin(el);
        }
      });
    }

    function findContainers(root) {
      if (!root) return Array.prototype.slice.call(document.querySelectorAll('.portal-recaptcha'));
      if (root.classList && root.classList.contains('portal-recaptcha')) return [root];
      return Array.prototype.slice.call(root.querySelectorAll('.portal-recaptcha'));
    }

    function getToken(root) {
      var containers = findContainers(root);
      for (var i = 0; i < containers.length; i++) {
        var c = containers[i];
        if (c.dataset.rcRendered === 'google' && typeof grecaptcha !== 'undefined' && grecaptcha.getResponse) {
          var wid = Number(c.dataset.rcWidgetId || 0);
          var gTok = grecaptcha.getResponse(wid);
          if (gTok) return gTok;
        }
        var inp = c.querySelector('[name="g-recaptcha-response"]');
        if (inp && inp.value) return inp.value;
      }
      return '';
    }

    function reset(root) {
      var containers = findContainers(root);
      containers.forEach(function(c) {
        if (c.dataset.rcRendered === 'google' && typeof grecaptcha !== 'undefined' && grecaptcha.reset) {
          try { grecaptcha.reset(Number(c.dataset.rcWidgetId || 0)); } catch (e) {}
        } else if (c.dataset.rcRendered === 'builtin') {
          var inp = c.querySelector('input[name="g-recaptcha-response"]');
          var box = c.querySelector('.portal-rc-box');
          var icon = c.querySelector('.portal-rc-icon');
          if (inp) inp.value = '';
          if (box) {
            box.classList.remove('rc-verified', 'rc-loading', 'rc-error');
            box.setAttribute('aria-checked', 'false');
          }
          if (icon) icon.innerHTML = '';
        }
      });
    }

    function highlight(root) {
      var containers = findContainers(root);
      containers.forEach(function(c) {
        var box = c.querySelector('.portal-rc-box') || c;
        box.classList.remove('rc-error');
        void box.offsetWidth;
        box.classList.add('rc-error');
        if (box.scrollIntoView) box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    window.PortalRecaptcha = {
      renderAll: renderAll,
      getToken: getToken,
      reset: reset,
      highlight: highlight,
      hintText: HINT_TXT
    };

    window.__portalRcOnload = function() {
      renderAll();
    };

    function init() {
      var hasWidgets = document.querySelectorAll('.portal-recaptcha').length > 0;
      if (!hasWidgets) return;
      if (SITE_KEY) {
        var s = document.createElement('script');
        s.src = 'https://www.google.com/recaptcha/api.js?onload=__portalRcOnload&render=explicit&hl=' + encodeURIComponent(LANG);
        s.async = true;
        s.defer = true;
        s.onerror = function() {
          window.__rcGoogleFallback = true;
          renderAll();
        };
        document.head.appendChild(s);
        setTimeout(function() {
          document.querySelectorAll('.portal-recaptcha').forEach(function(el) {
            if (!el.dataset.rcRendered) {
              window.__rcGoogleFallback = true;
              renderBuiltin(el);
            }
          });
        }, 3500);
      } else {
        renderAll();
      }
    }

    // Normal form submitlerinde (AJAX olmayan /iletisim ve /ilan-ver) otomatik kontrol
    document.addEventListener('submit', function(e) {
      var form = e.target;
      if (!form || !form.querySelector) return;
      var rc = form.querySelector('.portal-recaptcha');
      if (!rc) return;
      if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;
      if (!getToken(form)) {
        e.preventDefault();
        e.stopImmediatePropagation();
        highlight(form);
        if (window.adminToast) window.adminToast(HINT_TXT, 'error');
      }
    }, true);

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
  </script>

