<% layout('partials/layout') %>
<% locals.pageTitle = 'Gelen Mesajlar' %>

<div class="min-h-screen bg-zinc-950 text-zinc-100">
  <div class="max-w-5xl mx-auto px-4 py-8">

    <!-- Başlık -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-black text-white">📨 Gelen Mesajlar</h1>
        <p class="text-zinc-500 text-sm mt-1">İletişim formundan gelen mesajlar</p>
      </div>
      <a href="/admin" class="bg-zinc-800 hover:bg-zinc-700 text-white px-4 py-2 rounded-lg text-sm transition">← Dashboard</a>
    </div>

    <% if (messages.length === 0) { %>
    <div class="bg-zinc-900/60 rounded-xl p-12 text-center border border-zinc-800">
      <p class="text-4xl mb-3">📭</p>
      <p class="text-zinc-500">Henüz mesaj yok</p>
      <p class="text-zinc-600 text-sm mt-1">İletişim formundan gönderilen mesajlar burada listelenir.</p>
    </div>
    <% } else { %>
    <div class="space-y-4">
      <% messages.forEach(m => { %>
      <div class="bg-zinc-900 rounded-xl p-5 border <%= m.status === 'new' ? 'border-sky-500/40 shadow-lg shadow-sky-500/5' : 'border-zinc-800/80' %>" id="msg-<%= m.id %>">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-2 flex-wrap">
              <div class="w-9 h-9 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center text-white font-bold text-sm shrink-0">
                <%= m.name.charAt(0).toUpperCase() %>
              </div>
              <div class="min-w-0">
                <p class="text-white font-semibold text-sm"><%= m.name %></p>
                <a href="mailto:<%= m.email %>" class="text-zinc-500 text-xs hover:text-emerald-400 transition break-all"><%= m.email %></a>
              </div>
              <% if (m.status === 'new') { %>
              <span class="bg-sky-500/20 text-sky-400 text-[10px] font-black px-2 py-0.5 rounded-full animate-pulse">YENİ</span>
              <% } else { %>
              <span class="bg-zinc-800 text-zinc-400 text-[10px] font-bold px-2 py-0.5 rounded-full">OKUNDU</span>
              <% } %>
            </div>

            <% if (m.subject) { %>
            <p class="text-white font-bold text-sm mb-2">📌 <%= m.subject %></p>
            <% } %>

            <p class="text-zinc-300 text-sm leading-relaxed bg-zinc-950/60 border border-zinc-800/60 rounded-lg p-3.5 whitespace-pre-line"><%= m.message %></p>

            <p class="text-zinc-600 text-xs mt-2">
              🕐 <%= new Date(m.created_at).toLocaleString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </p>
          </div>

          <div class="flex items-center gap-2 shrink-0 flex-wrap">
            <% if (m.status === 'new') { %>
            <form action="/admin/iletisim/read/<%= m.id %>" method="POST" class="inline">
              <button type="submit" class="bg-zinc-700 hover:bg-zinc-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition" title="Okundu işaretle">✓ Okundu</button>
            </form>
            <% } %>
            <a href="mailto:<%= m.email %>?subject=<%= encodeURIComponent(m.subject || "Marmara'nın İncisi - Dönüş") %>"
              class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition">✉️ Yanıtla</a>
            <form action="/admin/iletisim/delete/<%= m.id %>" method="POST" class="inline" onsubmit="return confirm('Bu mesaj silinsin mi?')">
              <button type="submit" class="bg-red-600/80 hover:bg-red-500 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition">✕ Sil</button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

  </div>
</div>
