<% layout('partials/layout') %>
<% locals.pageTitle = 'Firma Yönetimi' %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
  body { font-family: 'Inter', sans-serif; }
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<div class="min-h-screen bg-zinc-950 text-zinc-100">
  <div class="max-w-7xl mx-auto px-4 py-6">

    <div class="flex items-center justify-between mb-6">
      <div>
        <a href="/admin" class="inline-flex items-center gap-2 text-zinc-400 hover:text-emerald-400 transition-colors text-sm mb-2">
          ← Yönetim Paneline Dön
        </a>
        <h1 class="text-3xl font-bold text-white">Firma Rehberi Yönetimi</h1>
      </div>
      <a href="/admin/firma-ekle" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2.5 rounded-xl text-sm transition-all">
        ➕ Yeni Firma
      </a>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg">
      <div class="p-4 border-b border-zinc-800">
        <input type="text" id="company-search" placeholder="Firma ara..."
          class="w-full max-w-md bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-zinc-300">
          <thead>
            <tr class="bg-zinc-900/80 text-zinc-400 font-semibold uppercase text-xs border-b border-zinc-800">
              <th class="p-4">Logo</th>
              <th class="p-4">Firma Adı</th>
              <th class="p-4">Kategori</th>
              <th class="p-4">Sektör</th>
              <th class="p-4">Durum</th>
              <th class="p-4 text-right">İşlemler</th>
            </tr>
          </thead>
          <tbody id="company-table-body">
            <% companies.forEach(item => { %>
            <tr class="border-b border-zinc-800/50 hover:bg-zinc-900/50 transition-colors" data-name="<%= (item.name || '').toLowerCase() %>">
              <td class="p-4">
                <% if (item.logo_url) { %>
                  <img src="<%= item.logo_url %>" alt="" class="w-12 h-12 rounded-lg object-cover border border-zinc-800">
                <% } else { %>
                  <div class="w-12 h-12 rounded-lg bg-zinc-800 flex items-center justify-center text-gray-600 text-xs">🏢</div>
                <% } %>
              </td>
              <td class="p-4">
                <a href="/admin/firma-ekle?edit=<%= item.id %>" class="text-white font-medium line-clamp-1 hover:text-emerald-400 transition-colors"><%= item.name %></a>
                <% if (item.is_featured == 1) { %>
                  <span class="inline-block bg-red-600 text-white text-[10px] font-bold px-1.5 py-0.25 rounded mt-1">🏆</span>
                <% } %>
              </td>
              <td class="p-4 text-zinc-400"><%= item.category || 'Genel' %></td>
              <td class="p-4 text-zinc-400 text-xs"><%= item.sector || '-' %></td>
              <td class="p-4">
                <% if (item.status === 'active') { %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400">🟢 Aktif</span>
                <% } else { %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-rose-500/10 text-rose-400">🔴 Pasif</span>
                <% } %>
              </td>
              <td class="p-4 text-right whitespace-nowrap space-x-1">
                <a href="/admin/firma-ekle?edit=<%= item.id %>" class="inline-flex items-center justify-center w-8 h-8 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-lg transition-all text-xs" title="Düzenle">✏️</a>
                <a href="/rehber/<%= item.slug || item.id %>" target="_blank" class="inline-flex items-center justify-center w-8 h-8 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-lg transition-all text-xs" title="Önizle">👁️</a>
                <form method="POST" action="/admin/firma-toggle/<%= item.id %>" style="display:inline"><button type="submit" class="inline-flex items-center justify-center w-8 h-8 <%= item.status === 'active' ? 'bg-amber-500/10 text-amber-400 hover:bg-amber-500/20' : 'bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20' %> rounded-lg transition-all text-xs" title="<%= item.status === 'active' ? 'Pasifleştir' : 'Aktifleştir' %>"><%= item.status === 'active' ? '⛔' : '▶️' %></button></form>
                <form method="POST" action="/admin/firma-sil/<%= item.id %>" style="display:inline"><button type="submit" onclick="return confirm('Bu firma kalıcı olarak silinsin mi?')" class="inline-flex items-center justify-center w-8 h-8 bg-red-950/50 hover:bg-red-900 text-red-400 rounded-lg border border-red-800/50 transition-all text-xs" title="Sil">🗑️</button></form>
              </td>
            </tr>
            <% }) %>
            <% if (companies.length === 0) { %>
              <tr><td colspan="6" class="p-12 text-center text-zinc-500">Henüz firma eklenmemiş.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script>
(function() {
  var search = document.getElementById('company-search');
  var rows = document.querySelectorAll('#company-table-body tr');
  if (search) {
    search.addEventListener('input', function() {
      var term = search.value.toLowerCase();
      rows.forEach(function(row) {
        var name = row.getAttribute('data-name') || '';
        row.style.display = name.includes(term) ? '' : 'none';
      });
    });
  }
})();
</script>
