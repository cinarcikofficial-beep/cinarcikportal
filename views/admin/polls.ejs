<% layout('partials/layout') %>
<% locals.pageTitle = 'Ana Sayfa Anketi' %>

<div class="min-h-screen bg-zinc-950 text-zinc-100">
  <div class="max-w-5xl mx-auto px-4 py-8">

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg mb-6">
      <div class="p-4 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-lg font-bold text-white">📊 Ana Sayfa Anketi</h3>
        <a href="/admin" class="inline-flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl text-sm font-medium transition-all">← Dashboard</a>
      </div>
      <div class="p-4 text-sm text-zinc-400 leading-relaxed">
        Ana sayfada (Haberler bölümünün altında) görünen anketi buradan yönetirsin.
        Yalnızca <strong class="text-emerald-400">tek bir anket</strong> yayında olur; yeni anket pasif eklenir.
        Her ziyaretçi bir ankette yalnızca <strong class="text-emerald-400">1 kez</strong> oy kullanır.
      </div>
    </div>

    <% if (errorQ) { %>
    <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-sm rounded-xl p-4 mb-6">Soru 3-300 karakter olmalı.</div>
    <% } %>
    <% if (errorOpt) { %>
    <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-sm rounded-xl p-4 mb-6">En az 2, en fazla 8 seçenek; her biri en fazla 120 karakter.</div>
    <% } %>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-lg mb-6">
      <div class="p-4 border-b border-zinc-800">
        <h4 class="font-bold text-white">➕ Yeni Anket</h4>
      </div>
      <form method="POST" action="/admin/anketler/ekle" id="poll-form" class="p-4 space-y-3">
        <div>
          <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Soru</label>
          <textarea name="question" rows="2" required minlength="3" maxlength="300" placeholder="Örn: Yazın Çınarcık'ta en çok neyi özledin?"
            class="w-full bg-zinc-950 text-zinc-100 border border-zinc-700 rounded-xl px-3.5 py-2 text-sm outline-none focus:border-emerald-500/60"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Seçenekler (en az 2, en fazla 8)</label>
          <div id="poll-opts" class="space-y-2">
            <input type="text" name="labels" maxlength="120" placeholder="Seçenek 1" class="poll-opt w-full bg-zinc-950 text-zinc-100 border border-zinc-700 rounded-xl px-3.5 py-2 text-sm outline-none focus:border-emerald-500/60">
            <input type="text" name="labels" maxlength="120" placeholder="Seçenek 2" class="poll-opt w-full bg-zinc-950 text-zinc-100 border border-zinc-700 rounded-xl px-3.5 py-2 text-sm outline-none focus:border-emerald-500/60">
          </div>
          <div class="flex items-center gap-2 mt-2">
            <button type="button" id="poll-add-opt" class="text-xs font-semibold text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1.5 rounded-lg hover:bg-emerald-500/20 transition">+ Seçenek Ekle</button>
            <span class="text-xs text-zinc-500">Boş seçenek alanları kayıt sırasında yok sayılır</span>
          </div>
        </div>
        <div>
          <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition">Anketi Kaydet</button>
        </div>
      </form>
    </div>

    <% if (!polls || polls.length === 0) { %>
    <div class="text-center py-12 text-zinc-500 border border-dashed border-zinc-800 rounded-2xl">
      Henüz anket yok — yukarıdaki formdan ilk anketi oluştur.
    </div>
    <% } %>

    <% polls.forEach(p => { %>
    <div class="bg-zinc-900 border <%= p.status === 'active' ? 'border-emerald-500/40' : 'border-zinc-800' %> rounded-2xl shadow-lg mb-4">
      <div class="p-4 flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 flex-wrap mb-1">
            <span class="text-xs font-mono text-zinc-500">#<%= p.id %></span>
            <% if (p.status === 'active') { %>
            <span class="text-[11px] font-bold text-emerald-300 bg-emerald-500/15 border border-emerald-500/40 px-2 py-0.5 rounded-full">🟢 Yayında</span>
            <% } else { %>
            <span class="text-[11px] font-bold text-zinc-400 bg-zinc-800 border border-zinc-700 px-2 py-0.5 rounded-full">🔴 Pasif</span>
            <% } %>
            <span class="text-[11px] font-bold text-sky-300 bg-sky-500/10 border border-sky-500/30 px-2 py-0.5 rounded-full"><%= p.votes %> oy</span>
          </div>
          <p class="font-bold text-white break-words"><%= p.question %></p>
          <p class="text-xs text-zinc-500"><%= new Date(p.created_at).toLocaleString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
        </div>
        <div class="flex items-center gap-2 flex-wrap justify-end">
          <% if (p.status === 'active') { %>
          <form method="POST" action="/admin/anketler/toggle/<%= p.id %>" data-confirm="Anket yayından kaldırılsın mı?">
            <button type="submit" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-3 py-2 rounded-lg text-xs font-bold transition" title="Yayından kaldır">⛔</button>
          </form>
          <% } else { %>
          <form method="POST" action="/admin/anketler/toggle/<%= p.id %>" data-confirm="Bu anket yayına alınsın mı? (diğer anketti otomatik gizlenir)">
            <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-2 rounded-lg text-xs font-bold transition" title="Yayına al">▶️</button>
          </form>
          <% } %>
          <form method="POST" action="/admin/anketler/oy-sifirla/<%= p.id %>" data-confirm="<%= p.votes %> oy silinecek. Emin misin?">
            <button type="submit" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-3 py-2 rounded-lg text-xs font-bold transition" title="Oyları sıfırla">🔄</button>
          </form>
          <form method="POST" action="/admin/anketler/sil/<%= p.id %>" data-confirm="Anket + seçenekleri + tüm oyları KALICI silinecek. Emin misin?">
            <button type="submit" class="bg-red-600/80 hover:bg-red-600 text-white px-3 py-2 rounded-lg text-xs font-bold transition" title="Sil">🗑️</button>
          </form>
        </div>
      </div>
      <div class="px-4 pb-4">
        <% if (p.options && p.options.length) { %>
        <ul class="text-sm text-zinc-400 space-y-1">
          <% p.options.forEach((o, i) => { %>
          <li><span class="text-zinc-600"><%= (i + 1) %>.</span> <%= o.label %> <% if (typeof o.count !== 'undefined') { %><span class="text-zinc-600">· <%= o.count %> oy</span><% } %></li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </div>
    <% }) %>

  </div>
</div>

<script>
  (function () {
    var wrap = document.getElementById('poll-opts');
    var addBtn = document.getElementById('poll-add-opt');
    if (addBtn && wrap) {
      addBtn.addEventListener('click', function () {
        if (wrap.children.length >= 8) return;
        var i = wrap.children.length;
        var inp = document.createElement('input');
        inp.type = 'text';
        inp.name = 'labels';
        inp.maxLength = 120;
        inp.placeholder = 'Seçenek ' + (i + 1);
        inp.className = 'poll-opt w-full bg-zinc-950 text-zinc-100 border border-zinc-700 rounded-xl px-3.5 py-2 text-sm outline-none focus:border-emerald-500/60';
        wrap.appendChild(inp);
        inp.focus();
      });
    }
  })();
</script>
