<% layout('partials/layout') %>
<% locals.pageTitle = 'Haber Yönetimi' %>

<div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
  <a href="/admin" class="inline-flex items-center gap-2 text-gray-400 hover:text-emerald-400 transition-colors text-sm">
    <span class="text-lg">←</span> Yönetim Paneline Dön
  </a>

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-white flex items-center gap-3">
        <span class="text-2xl">📰</span> Haber Yönetimi
      </h1>
      <p class="text-gray-400 mt-1 text-sm">Toplam <span class="text-white font-semibold"><%= news.length %></span> haber kayıtlı</p>
    </div>
    <a href="/admin/haber-ekle" class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-black font-medium px-5 py-2.5 rounded-xl transition-all">➕ Yeni Haber</a>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-zinc-800 text-gray-400 text-left">
          <th class="p-4 font-medium whitespace-nowrap">Görsel</th>
          <th class="p-4 font-medium">Başlık &amp; Rozet</th>
          <th class="p-4 font-medium whitespace-nowrap">Kategori</th>
          <th class="p-4 font-medium whitespace-nowrap">Yayın Süresi</th>
          <th class="p-4 font-medium whitespace-nowrap">Durum</th>
          <th class="p-4 font-medium text-right">İşlemler</th>
        </tr>
      </thead>
      <tbody>
        <% news.forEach(item => {
          const now = new Date().toISOString();
          const isExpired = item.expires_at && item.expires_at.trim() && item.expires_at <= now;
          let statusLabel, statusClass;
          if (item.status === 'passive') {
            statusLabel = '🔴 PASİF';
            statusClass = 'bg-rose-500/10 text-rose-400';
          } else if (isExpired) {
            statusLabel = '⏰ SÜRESİ DOLDU';
            statusClass = 'bg-amber-500/10 text-amber-400';
          } else {
            statusLabel = '🟢 YAYINDA';
            statusClass = 'bg-emerald-500/10 text-emerald-400';
          }
        %>
        <tr class="border-b border-zinc-800/50 hover:bg-zinc-800/30 transition-colors">
          <td class="p-4">
            <% if (item.main_image_url) { %>
              <img src="<%= item.main_image_url %>" alt="" class="w-12 h-12 rounded-lg object-cover border border-zinc-800" />
            <% } else { %>
              <div class="w-12 h-12 rounded-lg bg-zinc-800 flex items-center justify-center text-gray-600 text-xs">Yok</div>
            <% } %>
          </td>
          <td class="p-4">
            <p class="text-white font-medium text-sm"><%= item.title %></p>
            <% if (item.badge_text) { %>
              <span class="inline-block bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded mt-1"><%= item.badge_text %></span>
            <% } %>
            <p class="text-gray-500 text-xs mt-1"><%= new Date(item.created_at).toLocaleDateString('tr-TR') %></p>
          </td>
          <td class="p-4 whitespace-nowrap">
            <span class="inline-block bg-zinc-800 text-zinc-300 text-xs font-medium px-2.5 py-1 rounded-lg"><%= item.category || 'Gündem' %></span>
          </td>
          <td class="p-4 text-gray-400 text-xs whitespace-nowrap">
            <% if (item.expires_at && item.expires_at.trim()) { %>
              <%= new Date(item.expires_at).toLocaleDateString('tr-TR') %>
            <% } else { %>
              <span class="text-gray-600">Süresiz</span>
            <% } %>
          </td>
          <td class="p-4 whitespace-nowrap">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-medium <%= statusClass %>"><%= statusLabel %></span>
          </td>
          <td class="p-4 text-right whitespace-nowrap">
            <a href="/admin/haber-ekle?edit=<%= item.id %>" class="inline-flex items-center gap-1.5 bg-zinc-800 hover:bg-zinc-700 text-gray-300 px-3 py-1.5 rounded-lg transition-all text-xs font-medium mr-1" title="Düzenle">✏️</a>
            <a href="/haber/<%= item.slug || item.id %>" target="_blank" class="inline-flex items-center gap-1.5 bg-zinc-800 hover:bg-zinc-700 text-gray-300 px-3 py-1.5 rounded-lg transition-all text-xs font-medium mr-1" title="Önizle">👁️</a>
            <form method="POST" action="/admin/haberler/toggle/<%= item.id %>" style="display:inline"><button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-all text-xs font-medium mr-1 <%= item.status === 'active' ? 'bg-amber-500/10 text-amber-400 hover:bg-amber-500/20' : 'bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20' %>" title="<%= item.status === 'active' ? 'Yayından Kaldır' : 'Yayınla' %>"><%= item.status === 'active' ? '⛔' : '▶️' %></button></form>
            <form method="POST" action="/admin/haber-sil/<%= item.id %>" style="display:inline"><button type="submit" onclick="return confirm('Bu haber kalıcı olarak silinsin mi?')" class="inline-flex items-center gap-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 px-3 py-1.5 rounded-lg transition-all text-xs font-medium" title="Sil">🗑️</button></form>
          </td>
        </tr>
        <% }) %>
        <% if (news.length === 0) { %>
        <tr><td colspan="6" class="p-12 text-center text-gray-500">Henüz haber eklenmemiş.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>