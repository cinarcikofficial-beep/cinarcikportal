                  <form method="POST" action="/admin/firma-sil/<%= item.id %>" style="display:inline"><button type="submit" data-confirm="Silinsin mi?" class="inline-flex items-center justify-center w-8 h-8 bg-red-950/50 hover:bg-red-900 text-red-400 rounded-lg border border-red-800/50 transition-all text-xs" title="Sil">🗑️</button></form>
                </td>
              </tr>
              <% }) %>
              <% if (companies.length === 0) { %>
                <tr><td colspan="7" class="p-8 text-center text-zinc-500">Henüz firma eklenmemiş.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 5: GEZİLECEK YERLER YÖNETİMİ -->
    <div id="tab-sightseeing" class="tab-content hidden">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg">
        <div class="p-4 border-b border-zinc-800 flex flex-col sm:flex-row gap-3 items-center justify-between">
          <div class="relative flex-1 max-w-md">
            <input type="text" id="sightseeing-search" placeholder="Gezilecek yer ara..."
              class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
          </div>
          <select id="sightseeing-filter"
            class="bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-2.5 text-sm focus:border-emerald-500 focus:outline-none">
            <option value="all">Tümü</option>
            <option value="active">Aktif</option>
            <option value="passive">Pasif</option>
          </select>
          <a href="/admin/gezilecek-yer-ekle" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2.5 rounded-xl text-sm transition-all">
            ➕ Yeni Gezilecek Yer
          </a>
          <form method="POST" action="/admin/gezilecek-yerler/goruntulenme-sifirla"
            data-confirm="Tüm gezilecek yerlerin görüntülenme sayıları sıfırlansın mı?">
            <button type="submit" class="inline-flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl text-sm font-medium transition-all">
              🔄 Görüntülenmeleri Sıfırla
            </button>
          </form>
          <span class="text-zinc-500 text-xs whitespace-nowrap">Bugün: <span class="text-emerald-400 font-semibold"><%= typeof sightseeingTodayViews !== 'undefined' ? sightseeingTodayViews : 0 %></span> görüntülenme</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300">
            <thead>
              <tr class="bg-zinc-900/80 text-zinc-400 font-semibold uppercase text-xs border-b border-zinc-800">
                <th class="p-4 text-center whitespace-nowrap">Sıra</th>
                <th class="p-4">Görsel</th>
                <th class="p-4">Başlık & Konum</th>
                <th class="p-4">Kategori</th>
                <th class="p-4 text-center whitespace-nowrap">👁 Görüntülenme</th>
                <th class="p-4">Durum</th>
                <th class="p-4 text-right">İşlemler</th>
              </tr>
            </thead>
            <tbody id="sightseeing-table-body">
              <% (typeof sightseeing !== 'undefined' ? sightseeing : []).forEach((item, idx, arr) => {
                const statusLabel = item.status === 'passive' ? '🔴 Pasif' : '🟢 Aktif';
                const statusClass = item.status === 'passive' ? 'bg-rose-500/10 text-rose-400' : 'bg-emerald-500/10 text-emerald-400';
              %>
              <tr class="border-b border-zinc-800/50 hover:bg-zinc-900/50 transition-colors" data-status="<%= item.status || 'active' %>" data-title="<%= (item.title || '').toLowerCase() %>" data-category="<%= (item.category || '').toLowerCase() %>">
                <td class="p-4 text-center whitespace-nowrap">
                  <span class="inline-block px-2 py-1 rounded-lg bg-zinc-800 text-zinc-300 text-xs font-semibold mr-1"><%= idx + 1 %></span>
                  <form method="POST" action="/admin/sirala" style="display:inline">
                    <input type="hidden" name="tablo" value="sightseeing">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <input type="hidden" name="yon" value="yukari">
                    <button type="submit" <%= idx === 0 ? 'disabled' : '' %> class="inline-flex items-center justify-center w-6 h-6 align-middle bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed text-zinc-400 rounded transition-all text-[10px] ml-0.5" title="Yukarı Taşı">▲</button>
                  </form>
                  <form method="POST" action="/admin/sirala" style="display:inline">
                    <input type="hidden" name="tablo" value="sightseeing">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <input type="hidden" name="yon" value="asagi">
                    <button type="submit" <%= idx === arr.length - 1 ? 'disabled' : '' %> class="inline-flex items-center justify-center w-6 h-6 align-middle bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed text-zinc-400 rounded transition-all text-[10px]" title="Aşağı Taşı">▼</button>
                  </form>
                </td>
                <td class="p-4">
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" alt="" class="w-12 h-12 rounded-lg object-cover border border-zinc-800">
                  <% } else { %>
                    <div class="w-12 h-12 rounded-lg bg-zinc-800 flex items-center justify-center text-gray-600 text-xs">Yok</div>
                  <% } %>
                </td>
                <td class="p-4">
                  <p class="text-white font-medium text-sm line-clamp-1"><%= item.title %></p>
                  <% if (item.location) { %>
                    <p class="text-zinc-400 text-xs mt-0.5">📍 <%= item.location %></p>
                  <% } %>
                  <% if (item.created_at) { %>
                    <p class="text-zinc-500 text-xs mt-0.5"><%= new Date(item.created_at).toLocaleDateString('tr-TR') %></p>
                  <% } %>
                </td>
                <td class="p-4 text-zinc-400 text-xs"><%= item.category || 'Genel' %></td>
                <td class="p-4 text-center whitespace-nowrap">
                  <span class="inline-block px-2.5 py-1 rounded-lg bg-zinc-800 text-zinc-200 text-xs font-semibold"><%= Number(item.views_count) || 0 %></span>
                  <span class="inline-block px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 text-[10px] font-semibold ml-1" title="Bugünkü görüntülenme">↗ <%= Number(item.views_today) || 0 %></span>
                  <form method="POST" action="/admin/gezilecek-yerler/<%= item.id %>/goruntulenme-sifirla" style="display:inline">
                    <button type="submit" data-confirm="Bu gezilecek yerin görüntülenme sayısı sıfırlansın mı?" class="inline-flex items-center justify-center w-7 h-7 align-middle bg-zinc-800 hover:bg-zinc-700 text-zinc-400 rounded-lg transition-all text-xs ml-1" title="Görüntülenmeyi Sıfırla">🔄</button>
                  </form>
                </td>
                <td class="p-4 whitespace-nowrap">
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-medium <%= statusClass %>"><%= statusLabel %></span>
                </td>
                <td class="p-4 text-right whitespace-nowrap space-x-1">
                  <a href="/admin/gezilecek-yer-ekle?edit=<%= item.id %>" class="inline-flex items-center justify-center w-8 h-8 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-lg transition-all text-xs" title="Düzenle">✏️</a>
                  <a href="/gezilecek-yer/<%= item.slug || item.id %>" target="_blank" class="inline-flex items-center justify-center w-8 h-8 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-lg transition-all text-xs" title="Önizle">👁️</a>
                  <form method="POST" action="/admin/gezilecek-yer-toggle/<%= item.id %>" style="display:inline"><button type="submit" class="inline-flex items-center justify-center w-8 h-8 <%= item.status === 'active' ? 'bg-amber-500/10 text-amber-400 hover:bg-amber-500/20' : 'bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20' %> rounded-lg transition-all text-xs" title="<%= item.status === 'active' ? 'Yayından Kaldır' : 'Yayınla' %>"><%= item.status === 'active' ? '⛔' : '▶️' %></button></form>
                  <form method="POST" action="/admin/gezilecek-yer-sil/<%= item.id %>" style="display:inline"><button type="submit" data-confirm="Bu gezilecek yer kalıcı olarak silinsin mi?" class="inline-flex items-center justify-center w-8 h-8 bg-red-950/50 hover:bg-red-900 text-red-400 rounded-lg border border-red-800/50 transition-all text-xs" title="Sil">🗑️</button></form>
                </td>
              </tr>
              <% }) %>
              <% if (!sightseeing || sightseeing.length === 0) { %>
              <tr>
                <td colspan="7" class="p-8 text-center text-zinc-500 text-sm">Henüz gezilecek yer kaydı bulunmuyor.</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 6: DİĞER HABERLER (Google News RSS) -->
    <div id="tab-othernews" class="tab-content hidden">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg">
        <div class="p-4 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 class="text-lg font-bold text-white">🌐 Diğer Haberler</h3>
            <p class="text-zinc-500 text-xs mt-0.5">Google News akışı — "Çınarcık" ile ilgili dış haberler (30 dk önbellek)</p>
          </div>
          <button type="button" id="othernews-refresh"
            class="inline-flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl text-sm font-medium transition-all">
            🔄 Yenile
          </button>
        </div>
        <div id="othernews-list" class="p-4 divide-y divide-zinc-800/60">
          <div class="text-zinc-500 text-sm py-6 text-center">Yükleniyor...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Preview Modal -->
<div id="preview-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closePreviewModal()"></div>
  <div class="absolute inset-4 sm:inset-8 md:inset-12 lg:inset-16 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl flex flex-col">
    <div class="flex items-center justify-between p-4 border-b border-zinc-800">
      <h3 id="modal-title" class="text-lg font-bold text-white"></h3>
      <button onclick="closePreviewModal()" class="w-8 h-8 flex items-center justify-center rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-400 hover:text-white transition-all text-lg">✕</button>
    </div>
    <div id="modal-body" class="flex-1 overflow-y-auto p-4 space-y-4"></div>
  </div>
</div>

<script>
var placesData = <%- JSON.stringify(places).replace(/</g, '\\u003c') %>;

function openPreviewModal(placeId) {
  var place = placesData.find(function(p) { return p.id === placeId; });
  if (!place) return;

  document.getElementById('modal-title').textContent = place.name;

  var gallery = [];
  try { gallery = JSON.parse(place.gallery_images || '[]'); } catch(e) { gallery = []; }
  var allImages = [place.main_image_url].concat(gallery).filter(Boolean);
  var features = [];
  try { features = JSON.parse(place.features || '[]'); } catch(e) { features = []; }
  var estType = [];
  try { estType = JSON.parse(place.establishment_type || '[]'); } catch(e) { estType = []; }
  var mealType = [];
  try { mealType = JSON.parse(place.meal_type || '[]'); } catch(e) { mealType = []; }

  var html = '';

  if (allImages.length > 0) {
    html += '<div class="grid grid-cols-2 sm:grid-cols-3 gap-2">';
    allImages.slice(0, 6).forEach(function(img) {
      html += '<img src="' + img + '" alt="" class="w-full h-32 object-cover rounded-lg border border-zinc-800">';
    });
    html += '</div>';
  }

  html += '<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">';
  html += '<div class="space-y-3">';
  html += '<div><span class="text-xs text-zinc-500 uppercase">Kategori</span><p class="text-white font-medium">' + (place.category || '-') + '</p></div>';
  if (place.cuisine_type) html += '<div><span class="text-xs text-zinc-500 uppercase">Mutfak</span><p class="text-white font-medium">' + place.cuisine_type + '</p></div>';
  if (place.phone) html += '<div><span class="text-xs text-zinc-500 uppercase">Telefon</span><p class="text-emerald-400 font-medium">' + place.phone + '</p></div>';
  if (place.working_hours) html += '<div><span class="text-xs text-zinc-500 uppercase">Çalışma Saatleri</span><p class="text-white font-medium">' + place.working_hours + '</p></div>';
  if (place.address) html += '<div><span class="text-xs text-zinc-500 uppercase">Adres</span><p class="text-zinc-300 text-sm">' + place.address + '</p></div>';
  html += '</div>';
  html += '<div class="space-y-3">';
  if (place.description) html += '<div><span class="text-xs text-zinc-500 uppercase">Açıklama</span><p class="text-zinc-300 text-sm leading-relaxed">' + String(place.description).replace(/<[^>]*>/g, ' ') + '</p></div>';
  if (estType.length) html += '<div><span class="text-xs text-zinc-500 uppercase">Kuruluş Türü</span><div class="flex flex-wrap gap-1 mt-1">' + estType.map(function(t){ return '<span class="text-[10px] bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full">' + t + '</span>'; }).join('') + '</div></div>';
  if (mealType.length) html += '<div><span class="text-xs text-zinc-500 uppercase">Yemek Türü</span><div class="flex flex-wrap gap-1 mt-1">' + mealType.map(function(t){ return '<span class="text-[10px] bg-amber-500/10 text-amber-400 px-2 py-0.5 rounded-full">' + t + '</span>'; }).join('') + '</div></div>';
  if (features.length) html += '<div><span class="text-xs text-zinc-500 uppercase">Özellikler</span><div class="flex flex-wrap gap-1 mt-1">' + features.map(function(f){ return '<span class="text-[10px] bg-zinc-800 text-zinc-300 px-2 py-0.5 rounded">✓ ' + f + '</span>'; }).join('') + '</div></div>';
  html += '</div>';
  html += '</div>';

  if (place.google_reviews_url) {
    html += '<a href="' + place.google_reviews_url + '" target="_blank" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold px-4 py-2 rounded-xl text-sm transition-all">🌐 Google Yorumları</a>';
  }
  if (place.map_link) {
    html += '<a href="' + place.map_link + '" target="_blank" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-xl text-sm transition-all">📍 Haritada Gör</a>';
  }

  document.getElementById('modal-body').innerHTML = html;
  document.getElementById('preview-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closePreviewModal() {
  document.getElementById('preview-modal').classList.add('hidden');
  document.body.style.overflow = '';
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closePreviewModal();
});
</script>
<script>
function switchTab(tabName) {
  var tabs = document.querySelectorAll('.tab-btn');
  var contents = document.querySelectorAll('.tab-content');
  tabs.forEach(function(b) {
    b.classList.remove('active', 'bg-red-600', 'text-white');
    b.classList.add('bg-transparent', 'text-zinc-400');
  });
  var targetBtn = document.querySelector('.tab-btn[data-tab="' + tabName + '"]');
  if (targetBtn) {
    targetBtn.classList.remove('bg-transparent', 'text-zinc-400');
    targetBtn.classList.add('active', 'bg-red-600', 'text-white');
  }
  contents.forEach(function(c) { c.classList.add('hidden'); });
  var targetContent = document.getElementById('tab-' + tabName);
  if (targetContent) targetContent.classList.remove('hidden');
  if (window.history && window.history.replaceState) {
    window.history.replaceState(null, '', '/admin?tab=' + encodeURIComponent(tabName));
  }
}

(function() {
  var urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('tab')) {
    switchTab(urlParams.get('tab'));
  }

  var tabs = document.querySelectorAll('.tab-btn');
  var contents = document.querySelectorAll('.tab-content');

  tabs.forEach(function(btn) {
    btn.addEventListener('click', function() {
      // Update active tab button
      tabs.forEach(function(b) {
        b.classList.remove('active', 'bg-red-600', 'text-white');
        b.classList.add('bg-transparent', 'text-zinc-400');
        b.classList.remove('hover:bg-zinc-800/50');
      });
      btn.classList.remove('bg-transparent', 'text-zinc-400');
      btn.classList.add('active', 'bg-red-600', 'text-white');

      // Show corresponding content
      var target = btn.getAttribute('data-tab');
      contents.forEach(function(c) {
        c.classList.add('hidden');
      });
      document.getElementById('tab-' + target).classList.remove('hidden');
      if (window.history && window.history.replaceState) {
        window.history.replaceState(null, '', '/admin?tab=' + encodeURIComponent(target));
      }
    });
  });

  // Live search for news table
  var searchInput = document.getElementById('news-search');
  var filterSelect = document.getElementById('news-filter');
  var tableBody = document.getElementById('news-table-body');

  function filterNews() {
    if (!tableBody) return;
    var searchTerm = searchInput.value.toLowerCase();
    var filterVal = filterSelect.value;
    var rows = tableBody.querySelectorAll('tr');

    rows.forEach(function(row) {
      var title = row.cells[1].textContent.toLowerCase();
      var status = row.getAttribute('data-status') || '';
      var expired = row.getAttribute('data-expired') === 'true';

      var matchesSearch = title.includes(searchTerm);
      var matchesFilter = true;

      if (filterVal === 'active') matchesFilter = status === 'active' && !expired;
      else if (filterVal === 'passive') matchesFilter = status === 'passive';
      else if (filterVal === 'expired') matchesFilter = expired && status === 'active';

      row.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
    });
  }

  if (searchInput) searchInput.addEventListener('input', filterNews);
  if (filterSelect) filterSelect.addEventListener('change', filterNews);

  // Live search for sightseeing table
  var sSearchInput = document.getElementById('sightseeing-search');
  var sFilterSelect = document.getElementById('sightseeing-filter');
  var sTableBody = document.getElementById('sightseeing-table-body');

  function filterSightseeing() {
    if (!sTableBody) return;
    var searchTerm = sSearchInput ? sSearchInput.value.toLowerCase() : '';
    var filterVal = sFilterSelect ? sFilterSelect.value : 'all';
    var rows = sTableBody.querySelectorAll('tr[data-status]');

    rows.forEach(function(row) {
      var title = row.getAttribute('data-title') || '';
      var cat = row.getAttribute('data-category') || '';
      var status = row.getAttribute('data-status') || '';

      var matchesSearch = title.includes(searchTerm) || cat.includes(searchTerm);
      var matchesFilter = filterVal === 'all' || status === filterVal;

      row.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
    });
  }

  if (sSearchInput) sSearchInput.addEventListener('input', filterSightseeing);
  if (sFilterSelect) sFilterSelect.addEventListener('change', filterSightseeing);
})();
</script>
<script>
(function() {
  var list = document.getElementById('othernews-list');
  var refreshBtn = document.getElementById('othernews-refresh');
  if (!list) return;
  var loaded = false;

  function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }

  function load() {
    list.innerHTML = '<div class="text-zinc-500 text-sm py-6 text-center">Yükleniyor...</div>';
    fetch('/api/trending-news')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.success || !data.news || data.news.length === 0) {
          list.innerHTML = '<div class="text-zinc-500 text-sm py-6 text-center">Haber bulunamadı.</div>';
          return;
        }
        var h = '';
        data.news.forEach(function(item, i) {
          var dateStr = '';
          if (item.pubDate) {
            try {
              var d = new Date(item.pubDate);
              dateStr = d.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' });
            } catch(e) {}
          }
          h += '<a href="' + esc(item.link) + '" target="_blank" rel="noopener" class="flex items-start gap-3 py-3 px-2 rounded-lg hover:bg-zinc-800/50 transition-all group">';
          h += '  <span class="flex-shrink-0 w-7 h-7 rounded-lg bg-blue-600/10 text-blue-500 font-bold text-xs flex items-center justify-center mt-0.5">' + (i + 1) + '</span>';
          h += '  <div class="flex-1 min-w-0">';
          h += '    <h4 class="text-zinc-200 font-semibold text-sm line-clamp-2 group-hover:text-blue-400 transition-colors">' + esc(item.title) + '</h4>';
          h += '    <div class="flex items-center gap-2 text-[11px] text-zinc-500 mt-1">';
          if (item.source) h += '      <span>' + esc(item.source) + '</span>';
          if (dateStr) h += '      <span>•</span><span>' + dateStr + '</span>';
          h += '    </div>';
          if (item.description) h += '    <p class="text-zinc-500 text-xs line-clamp-2 mt-1">' + esc(item.description) + '</p>';
          h += '  </div>';
          h += '  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 text-zinc-600 group-hover:text-blue-400 transition-colors mt-1"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>';
          h += '</a>';
        });
        list.innerHTML = h;
      })
      .catch(function() {
        list.innerHTML = '<div class="text-zinc-500 text-sm py-6 text-center">Haberler yüklenemedi.</div>';
      });
  }

  var newsTabBtn = document.querySelector('.tab-btn[data-tab="othernews"]');
  if (newsTabBtn) {
    newsTabBtn.addEventListener('click', function() {
      if (!loaded) { loaded = true; load(); }
    });
  }
  if (refreshBtn) refreshBtn.addEventListener('click', function() { loaded = true; load(); });

  var urlTab = new URLSearchParams(window.location.search).get('tab');
  if (urlTab === 'othernews') { loaded = true; load(); }
})();
</script>
