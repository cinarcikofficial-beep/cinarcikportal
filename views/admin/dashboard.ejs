<% layout('partials/layout') %>
<% locals.pageTitle = 'Yönetim Merkezi' %>

<style>
  body { font-family: 'Inter', sans-serif; }
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<div class="min-h-screen bg-zinc-950 text-zinc-100">
  <div class="max-w-7xl mx-auto px-4 py-6">

    <!-- Header -->
<div class="flex items-center justify-between mb-6">
       <div>
         <h1 class="text-3xl font-bold text-white">Yönetim Merkezi</h1>
         <p class="text-zinc-400 mt-1">Sitenizin tüm içeriklerini buradan yönetin</p>
       </div>
     </div>

     <!-- 1. ÜST İSTATİSTİK KARTLARI -->
    <div class="flex items-center gap-3 mb-4">
      <h2 class="text-lg font-bold text-white">📊 Genel Bakış</h2>
      <span class="text-xs text-zinc-500">Sitenizin güncel durumu ve hızlı erişim</span>
      <div class="flex-1 h-px bg-gradient-to-r from-zinc-800 to-transparent"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class="relative overflow-hidden bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-emerald-500/60 hover:-translate-y-0.5 transition-all shadow-lg cursor-pointer" onclick="switchTab('news')">
        <span class="absolute inset-x-0 top-0 h-1 bg-emerald-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-2xl">📰</div>
          <a href="/admin/haber-ekle" class="text-[11px] font-bold text-emerald-400 hover:text-emerald-300 border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1.5 rounded-lg transition-colors" onclick="event.stopPropagation()">+ Yeni Ekle</a>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2"><%= typeof newsCount === 'number' ? newsCount : 0 %></p>
        <p class="text-sm font-bold text-zinc-100">Toplam Haber</p>
        <p class="text-xs text-zinc-500 mt-0.5">Sitede yayınlanan tüm haberler</p>
      </div>

      <div class="relative overflow-hidden bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-amber-500/60 hover:-translate-y-0.5 transition-all shadow-lg cursor-pointer" onclick="switchTab('announcements')">
        <span class="absolute inset-x-0 top-0 h-1 bg-amber-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-2xl">📢</div>
          <a href="/admin/duyuru-ekle" class="text-[11px] font-bold text-amber-400 hover:text-amber-300 border border-amber-500/30 bg-amber-500/10 px-2.5 py-1.5 rounded-lg transition-colors" onclick="event.stopPropagation()">+ Yeni Ekle</a>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2"><%= announcements.length %></p>
        <p class="text-sm font-bold text-zinc-100">Aktif Duyuru</p>
        <p class="text-xs text-zinc-500 mt-0.5">Toplam ilan ve duyuru (onay bekleyenler dahil)</p>
      </div>

      <div class="relative overflow-hidden bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-sky-500/60 hover:-translate-y-0.5 transition-all shadow-lg cursor-pointer" onclick="switchTab('places')">
        <span class="absolute inset-x-0 top-0 h-1 bg-sky-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-2xl">📍</div>
          <a href="/admin/mekan-ekle" class="text-[11px] font-bold text-sky-400 hover:text-sky-300 border border-sky-500/30 bg-sky-500/10 px-2.5 py-1.5 rounded-lg transition-colors" onclick="event.stopPropagation()">+ Yeni Ekle</a>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2"><%= places.length %></p>
        <p class="text-sm font-bold text-zinc-100">Kayıtlı Mekan</p>
        <p class="text-xs text-zinc-500 mt-0.5">Rehberdeki kafe, restoran vb. mekanlar</p>
      </div>

      <a href="/admin/comments" class="relative overflow-hidden block bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-rose-500/60 hover:-translate-y-0.5 transition-all shadow-lg">
        <span class="absolute inset-x-0 top-0 h-1 bg-rose-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-rose-500/15 border border-rose-500/30 flex items-center justify-center text-2xl">💬</div>
          <% if (typeof pendingCommentsCount !== 'undefined' && pendingCommentsCount > 0) { %>
            <span class="bg-red-600 text-white text-[11px] font-black px-2.5 py-1.5 rounded-full shadow-lg shadow-red-600/30 animate-pulse"><%= pendingCommentsCount %> yeni</span>
          <% } else { %>
            <span class="text-[11px] font-bold text-rose-400 border border-rose-500/30 bg-rose-500/10 px-2.5 py-1.5 rounded-lg">Yönet →</span>
          <% } %>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2">
          <%= typeof pendingCommentsCount !== 'undefined' ? pendingCommentsCount : 0 %>
          <span class="text-sm font-semibold text-zinc-500 ml-1">bekleyen</span>
        </p>
        <p class="text-sm font-bold text-zinc-100">Onay Bekleyen Yorum</p>
        <p class="text-xs text-zinc-500 mt-0.5">Moderasyon sırasındaki yorumlar · Toplam <%= typeof totalCommentsCount !== 'undefined' ? totalCommentsCount : 0 %></p>
      </a>

      <a href="/admin/fotograflar" class="relative overflow-hidden block bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-violet-500/60 hover:-translate-y-0.5 transition-all shadow-lg">
        <span class="absolute inset-x-0 top-0 h-1 bg-violet-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-violet-500/15 border border-violet-500/30 flex items-center justify-center text-2xl">📷</div>
          <% if (typeof pendingPhotosCount !== 'undefined' && pendingPhotosCount > 0) { %>
            <span class="bg-violet-600 text-white text-[11px] font-black px-2.5 py-1.5 rounded-full shadow-lg shadow-violet-600/30 animate-pulse"><%= pendingPhotosCount %> yeni</span>
          <% } else { %>
            <span class="text-[11px] font-bold text-violet-400 border border-violet-500/30 bg-violet-500/10 px-2.5 py-1.5 rounded-lg">Yönet →</span>
          <% } %>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2">
          <%= typeof pendingPhotosCount !== 'undefined' ? pendingPhotosCount : 0 %>
          <span class="text-sm font-semibold text-zinc-500 ml-1">bekleyen</span>
        </p>
        <p class="text-sm font-bold text-zinc-100">Sizlerden Gelen Fotoğraf</p>
        <p class="text-xs text-zinc-500 mt-0.5">Kullanıcı paylaşımlarını onaylayın · Toplam <%= typeof totalPhotosCount !== 'undefined' ? totalPhotosCount : 0 %></p>
      </a>

      <a href="/admin/anketler" class="relative overflow-hidden block bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-sky-500/60 hover:-translate-y-0.5 transition-all shadow-lg">
        <span class="absolute inset-x-0 top-0 h-1 bg-sky-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-2xl">📊</div>
          <span class="text-[11px] font-bold text-sky-400 border border-sky-500/30 bg-sky-500/10 px-2.5 py-1.5 rounded-lg">Yönet →</span>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2">
          <%= typeof pollTotalVotes !== 'undefined' ? pollTotalVotes : 0 %>
          <span class="text-sm font-semibold text-zinc-500 ml-1">oy</span>
        </p>
        <p class="text-sm font-bold text-zinc-100"><%= typeof pollCount !== 'undefined' && pollCount === 0 ? 'Henüz anket yok' : 'Ana Sayfa Anketi' %></p>
        <p class="text-xs text-zinc-500 mt-0.5"><%= typeof pollActiveQuestion !== 'undefined' && pollActiveQuestion ? pollActiveQuestion : 'Soru oluşturup yayına alın' %></p>
      </a>

      <a href="/admin/iletisim" class="relative overflow-hidden block bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-cyan-500/60 hover:-translate-y-0.5 transition-all shadow-lg">
        <span class="absolute inset-x-0 top-0 h-1 bg-cyan-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-2xl">📨</div>
          <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
            <span class="bg-cyan-500 text-white text-[11px] font-black px-2.5 py-1.5 rounded-full shadow-lg shadow-cyan-500/30 animate-pulse"><%= unreadMessagesCount %> yeni</span>
          <% } else { %>
            <span class="text-[11px] font-bold text-cyan-400 border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1.5 rounded-lg">Gelen Kutusu →</span>
          <% } %>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2">
          <%= typeof unreadMessagesCount !== 'undefined' ? unreadMessagesCount : 0 %>
          <span class="text-sm font-semibold text-zinc-500 ml-1">okunmamış</span>
        </p>
        <p class="text-sm font-bold text-zinc-100">Gelen Mesajlar</p>
        <p class="text-xs text-zinc-500 mt-0.5">İletişim formundan gelen mesajlar</p>
      </a>

      <div class="relative overflow-hidden bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-orange-500/60 hover:-translate-y-0.5 transition-all shadow-lg cursor-pointer" onclick="switchTab('sightseeing')">
        <span class="absolute inset-x-0 top-0 h-1 bg-orange-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-orange-500/15 border border-orange-500/30 flex items-center justify-center text-2xl">🧳</div>
          <a href="/admin/gezilecek-yer-ekle" class="text-[11px] font-bold text-orange-400 hover:text-orange-300 border border-orange-500/30 bg-orange-500/10 px-2.5 py-1.5 rounded-lg transition-colors" onclick="event.stopPropagation()">+ Yeni Ekle</a>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2">
          <%= typeof sightseeingCount !== 'undefined' ? sightseeingCount : 0 %>
          <span class="text-sm font-semibold text-zinc-500 ml-1">kayıt</span>
        </p>
        <p class="text-sm font-bold text-zinc-100">Gezilecek Yerler</p>
        <p class="text-xs text-zinc-500 mt-0.5">Gezi rehberi tanıtım içerikleri</p>
      </div>

      <a href="/admin/hakkinda" class="relative overflow-hidden block bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-teal-500/60 hover:-translate-y-0.5 transition-all shadow-lg">
        <span class="absolute inset-x-0 top-0 h-1 bg-teal-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-teal-500/15 border border-teal-500/30 flex items-center justify-center text-2xl">ℹ️</div>
          <span class="text-[11px] font-bold text-teal-400 border border-teal-500/30 bg-teal-500/10 px-2.5 py-1.5 rounded-lg">Düzenle →</span>
        </div>
        <p class="text-xl font-black text-white leading-none mb-2">Hakkında Sayfası</p>
        <p class="text-xs text-zinc-500 mt-0.5">Çınarcık hakkında tanıtım içeriği</p>
      </a>

      <a href="/admin/raporlar" class="relative overflow-hidden block bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-sky-500/60 hover:-translate-y-0.5 transition-all shadow-lg">
        <span class="absolute inset-x-0 top-0 h-1 bg-sky-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-2xl">📊</div>
          <span class="text-[11px] font-bold text-sky-400 border border-sky-500/30 bg-sky-500/10 px-2.5 py-1.5 rounded-lg">Aç →</span>
        </div>
        <p class="text-xl font-black text-white leading-none mb-2">Raporlar</p>
        <p class="text-xs text-zinc-500 mt-0.5">Sayfa trafiği ve ziyaretçi IP'leri</p>
      </a>

      <div class="relative overflow-hidden bg-zinc-900 border border-zinc-800 rounded-2xl p-5 hover:border-violet-500/60 hover:-translate-y-0.5 transition-all shadow-lg cursor-pointer" onclick="switchTab('companies')">
        <span class="absolute inset-x-0 top-0 h-1 bg-violet-500"></span>
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-violet-500/15 border border-violet-500/30 flex items-center justify-center text-2xl">🏢</div>
          <a href="/admin/firma-ekle" class="text-[11px] font-bold text-violet-400 hover:text-violet-300 border border-violet-500/30 bg-violet-500/10 px-2.5 py-1.5 rounded-lg transition-colors" onclick="event.stopPropagation()">+ Yeni Ekle</a>
        </div>
        <p class="text-4xl font-black text-white leading-none mb-2"><%= companies.length %></p>
        <p class="text-sm font-bold text-zinc-100">Kayıtlı Firma</p>
        <p class="text-xs text-zinc-500 mt-0.5">Rehbere kayıtlı firmalar</p>
      </div>
    </div>

    <!-- 2. MODÜLER SEKMELİ GEZİNTİ -->
    <div class="mb-6">
      <div class="flex items-center gap-3 mb-4">
        <h2 class="text-lg font-bold text-white">🗂️ İçerik Yönetimi</h2>
        <span class="text-xs text-zinc-500">Aşağıdaki sekmelerden içeriklerinizi düzenleyin</span>
        <div class="flex-1 h-px bg-gradient-to-r from-zinc-800 to-transparent"></div>
      </div>
      <nav class="flex flex-wrap gap-2 bg-zinc-900/50 p-1.5 rounded-xl border border-zinc-800">
        <button type="button" data-tab="news"
          class="tab-btn active bg-red-600 text-white font-bold px-4 py-2.5 rounded-lg text-sm transition-all">
          📰 Haber Yönetimi
        </button>
        <button type="button" data-tab="announcements"
          class="tab-btn bg-transparent text-zinc-400 hover:bg-zinc-800/50 font-medium px-4 py-2.5 rounded-lg text-sm transition-all">
          📢 Duyuru Yönetimi
        </button>
        <button type="button" data-tab="places"
          class="tab-btn bg-transparent text-zinc-400 hover:bg-zinc-800/50 font-medium px-4 py-2.5 rounded-lg text-sm transition-all">
          📍 Mekan Yönetimi
        </button>
        <button type="button" data-tab="companies"
          class="tab-btn bg-transparent text-zinc-400 hover:bg-zinc-800/50 font-medium px-4 py-2.5 rounded-lg text-sm transition-all">
          🏢 Firma Yönetimi
        </button>
        <button type="button" data-tab="sightseeing"
          class="tab-btn bg-transparent text-zinc-400 hover:bg-zinc-800/50 font-medium px-4 py-2.5 rounded-lg text-sm transition-all">
          🧳 Gezilecek Yerler
        </button>
        <button type="button" data-tab="othernews"
          class="tab-btn bg-transparent text-zinc-400 hover:bg-zinc-800/50 font-medium px-4 py-2.5 rounded-lg text-sm transition-all">
          🌐 Diğer Haberler
        </button>
      </nav>
    </div>

    <!-- 3. SEKMELERİN İÇERİKLERİ -->

    <!-- TAB 1: HABER YÖNETİMİ -->
    <div id="tab-news" class="tab-content">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg">
        <div class="p-4 border-b border-zinc-800 flex flex-col sm:flex-row gap-3 items-center justify-between">
          <div class="relative flex-1 max-w-md">
            <input type="text" id="news-search" placeholder="Haber ara..."
              class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
          </div>
          <select id="news-filter"
            class="bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-2.5 text-sm focus:border-emerald-500 focus:outline-none">
            <option value="all">Tümü</option>
            <option value="active">Aktif</option>
            <option value="passive">Pasif</option>
            <option value="expired">Süresi Dolmuş</option>
          </select>
          <a href="/admin/haber-ekle" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2.5 rounded-xl text-sm transition-all">
            ➕ Yeni Haber
          </a>
          <form method="POST" action="/admin/haberler/goruntulenme-sifirla"
            data-confirm="Tüm haberlerin görüntelenme sayıları sıfırlansın mı?">
            <button type="submit" class="inline-flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl text-sm font-medium transition-all">
              🔄 Görüntelenmeleri Sıfırla
            </button>
          </form>
          <span class="text-zinc-500 text-xs whitespace-nowrap">Bugün: <span class="text-emerald-400 font-semibold"><%= newsTodayViews || 0 %></span> görüntülenme</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-300">
            <thead>
              <tr class="bg-zinc-900/80 text-zinc-400 font-semibold uppercase text-xs border-b border-zinc-800">
                <th class="p-4 text-center whitespace-nowrap">Sıra</th>
                <th class="p-4">Görsel</th>
                <th class="p-4">Başlık & Rozet</th>
                <th class="p-4">Kategori</th>
                <th class="p-4">Yayın Süresi</th>
                <th class="p-4 text-center whitespace-nowrap">👁 Görüntelenme</th>
                <th class="p-4">Durum</th>
                <th class="p-4 text-right">İşlemler</th>
              </tr>
            </thead>
            <tbody id="news-table-body">
              <% news.forEach((item, idx) => { 
                const now = new Date().toISOString();
                const isExpired = item.expires_at && item.expires_at.trim() && item.expires_at <= now;
                let statusLabel, statusClass;
                if (isExpired && item.status === 'active') {
                  statusLabel = '⏰ Süresi Doldu';
                  statusClass = 'bg-amber-500/10 text-amber-400';
                } else if (item.status === 'passive') {
                  statusLabel = '🔴 Pasif';
                  statusClass = 'bg-rose-500/10 text-rose-400';
                } else {
                  statusLabel = '🟢 Aktif';
                  statusClass = 'bg-emerald-500/10 text-emerald-400';
                }
              %>
              <tr class="border-b border-zinc-800/50 hover:bg-zinc-900/50 transition-colors" data-status="<%= item.status %>" data-expired="<%= isExpired %>">
                <td class="p-4 text-center whitespace-nowrap">
                  <span class="inline-block px-2 py-1 rounded-lg bg-zinc-800 text-zinc-300 text-xs font-semibold mr-1"><%= idx + 1 %></span>
                  <form method="POST" action="/admin/sirala" style="display:inline">
                    <input type="hidden" name="tablo" value="news">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <input type="hidden" name="yon" value="yukari">
                    <button type="submit" <%= idx === 0 ? 'disabled' : '' %> class="inline-flex items-center justify-center w-6 h-6 align-middle bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed text-zinc-400 rounded transition-all text-[10px] ml-0.5" title="Yukarı Taşı">▲</button>
                  </form>
                  <form method="POST" action="/admin/sirala" style="display:inline">
                    <input type="hidden" name="tablo" value="news">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <input type="hidden" name="yon" value="asagi">
                    <button type="submit" <%= idx === news.length - 1 ? 'disabled' : '' %> class="inline-flex items-center justify-center w-6 h-6 align-middle bg-zinc-800 hover:bg-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed text-zinc-400 rounded transition-all text-[10px]" title="Aşağı Taşı">▼</button>
                  </form>
                </td>
                <td class="p-4">
                  <% if (item.main_image_url) { %>
                    <img src="<%= item.main_image_url %>" alt="" class="w-12 h-12 rounded-lg object-cover border border-zinc-800">
                  <% } else { %>
                    <div class="w-12 h-12 rounded-lg bg-zinc-800 flex items-center justify-center text-gray-600 text-xs">Yok</div>
                  <% } %>
                </td>
                <td class="p-4">
                  <p class="text-white font-medium text-sm line-clamp-1"><%= item.title %></p>
                  <% if (item.badge_text) { %>
                    <span class="inline-block bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded mt-1"><%= item.badge_text %></span>
                  <% } %>
                  <p class="text-zinc-500 text-xs mt-1"><%= new Date(item.created_at).toLocaleDateString('tr-TR') %></p>
                </td>
                <td class="p-4 text-zinc-400 text-xs"><%= item.category || 'Genel' %></td>
                <td class="p-4 text-zinc-400 text-xs whitespace-nowrap">
                  <% if (item.expires_at && item.expires_at.trim()) { %>
                    <%= new Date(item.expires_at).toLocaleDateString('tr-TR') %>
                  <% } else { %>
                    <span class="text-zinc-600">Süresiz</span>
                  <% } %>
                </td>
                <td class="p-4 text-center whitespace-nowrap">
                  <span class="inline-block px-2.5 py-1 rounded-lg bg-zinc-800 text-zinc-200 text-xs font-semibold"><%= Number(item.views_count) || 0 %></span>
                  <span class="inline-block px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 text-[10px] font-semibold ml-1" title="Bugünkü görüntülenme">↗ <%= Number(item.views_today) || 0 %></span>
                  <form method="POST" action="/admin/haberler/<%= item.id %>/goruntulenme-sifirla" style="display:inline">
                    <button type="submit" data-confirm="Bu haberin görüntelenme sayısı sıfırlansın mı?" class="inline-flex items-center justify-center w-7 h-7 align-middle bg-zinc-800 hover:bg-zinc-700 text-zinc-400 rounded-lg transition-all text-xs ml-1" title="Görüntilenmeyi Sıfırla">🔄</button>
                  </form>
                </td>
                <td class="p-4 whitespace-nowrap">
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-medium <%= statusClass %>"><%= statusLabel %></span>
                </td>
                <td class="p-4 text-right whitespace-nowrap space-x-1">
