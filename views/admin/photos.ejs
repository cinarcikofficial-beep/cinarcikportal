<% layout('partials/layout') %>
<% locals.pageTitle = 'Fotoğraf Gönderileri' %>

<div class="min-h-screen bg-zinc-950 text-zinc-100">
  <div class="max-w-6xl mx-auto px-4 py-8">

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg">
      <div class="p-4 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-lg font-bold text-white">📷 Fotoğraf Gönderileri</h3>
        <div class="flex items-center gap-2">
          <form method="POST" action="/admin/fotograflar/goruntulenme-sifirla"
            data-confirm="Tüm fotoğrafların görüntülenme sayıları sıfırlansın mı?">
            <button type="submit" class="inline-flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl text-sm font-medium transition-all">
              🔄 Görüntülenmeleri Sıfırla
            </button>
          </form>
          <a href="/sizlerden-gelen" target="_blank" class="inline-flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl text-sm font-medium transition-all">Sayfayı Gör ↗</a>
          <a href="/admin" class="inline-flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl text-sm font-medium transition-all">← Dashboard</a>
        </div>
        <span class="text-zinc-500 text-xs whitespace-nowrap">Bugün: <span class="text-emerald-400 font-semibold"><%= photosTodayViews || 0 %></span> görüntülenme</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-zinc-300">
          <thead>
            <tr class="bg-zinc-900/80 text-zinc-400 font-semibold uppercase text-xs border-b border-zinc-800">
              <th class="p-4 text-center whitespace-nowrap">Sıra</th>
              <th class="p-4">Görsel</th>
              <th class="p-4">Başlık</th>
              <th class="p-4">Tarih</th>
              <th class="p-4 text-center whitespace-nowrap">👁 Görüntülenme</th>
              <th class="p-4">Durum</th>
              <th class="p-4 text-right">İşlemler</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach((item, idx) => { %>
            <%
              const isPending = item.status === 'pending';
            %>
            <tr class="border-b border-zinc-800/50 hover:bg-zinc-900/50 transition-colors <%= isPending ? 'bg-amber-950/20' : '' %>">
              <td class="p-4 text-center whitespace-nowrap">
                <span class="inline-block px-2 py-1 rounded-lg bg-zinc-800 text-zinc-300 text-xs font-semibold"><%= idx + 1 %></span>
              </td>
              <td class="p-4 whitespace-nowrap">
                <% if (item.image) { %>
                  <a href="<%= item.image %>" target="_blank"><img src="<%= item.image %>" alt="" class="w-12 h-12 object-cover rounded-lg border border-zinc-800 hover:opacity-80 transition"></a>
                <% } else { %>
                  <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-zinc-800 text-zinc-500">📷</span>
                <% } %>
              </td>
              <td class="p-4 max-w-xs">
                <span class="text-white font-medium line-clamp-1 block"><%= item.title %></span>
                <span class="text-xs text-zinc-500 block mt-0.5">👤 <%= item.author_name || '—' %> · ✉️ <%= item.author_email || '—' %></span>
                <% if (item.description) { %>
                  <span class="text-xs text-zinc-500 line-clamp-1 block mt-0.5"><%= item.description %></span>
                <% } %>
              </td>
              <td class="p-4 text-zinc-400 whitespace-nowrap"><%= new Date(item.created_at).toLocaleDateString('tr-TR') %></td>
              <td class="p-4 text-center whitespace-nowrap">
                <span class="inline-block px-2.5 py-1 rounded-lg bg-zinc-800 text-zinc-200 text-xs font-semibold"><%= Number(item.views_count) || 0 %></span>
                <span class="inline-block px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 text-[10px] font-semibold ml-1" title="Bugünkü görüntülenme">↗ <%= Number(item.views_today) || 0 %></span>
                <form method="POST" action="/admin/fotograflar/<%= item.id %>/goruntulenme-sifirla" style="display:inline">
                  <button type="submit" data-confirm="Bu fotoğrafın görüntülenme sayısı sıfırlansın mı?" class="inline-flex items-center justify-center w-7 h-7 align-middle bg-zinc-800 hover:bg-zinc-700 text-zinc-400 rounded-lg transition-all text-xs ml-1" title="Görüntülenmeyi Sıfırla">🔄</button>
                </form>
              </td>
              <td class="p-4 whitespace-nowrap">
                <% if (isPending) { %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30">⏳ Onay Bekliyor</span>
                <% } else if (item.status === 'passive') { %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-rose-500/10 text-rose-400">🔴 Pasif</span>
                <% } else { %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400">🟢 Aktif</span>
                <% } %>
              </td>
              <td class="p-4 text-right whitespace-nowrap space-x-1">
                <% if (isPending) { %>
                  <form method="POST" action="/admin/fotograflar/onayla/<%= item.id %>" style="display:inline"><button type="submit" class="inline-flex items-center justify-center h-8 px-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition-all text-xs font-bold" title="Onayla">✓ Onayla</button></form>
                  <form method="POST" action="/admin/fotograflar/reddet/<%= item.id %>" style="display:inline"><button type="submit" data-confirm="Fotoğraf reddedilsin mi? Silinecek." class="inline-flex items-center justify-center h-8 px-3 bg-red-950/60 hover:bg-red-900 text-red-300 rounded-lg border border-red-800/50 transition-all text-xs font-bold" title="Reddet">✕ Reddet</button></form>
                <% } else { %>
                  <form method="POST" action="/admin/fotograflar/toggle/<%= item.id %>" style="display:inline"><button type="submit" class="inline-flex items-center justify-center w-8 h-8 <%= item.status === 'active' ? 'bg-amber-500/10 text-amber-400 hover:bg-amber-500/20' : 'bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20' %> rounded-lg transition-all text-xs" title="<%= item.status === 'active' ? 'Yayından Kaldır (Gizle)' : 'Yayınla' %>"><%= item.status === 'active' ? '⛔' : '▶️' %></button></form>
                  <a href="/sizlerden-gelen" target="_blank" class="inline-flex items-center justify-center w-8 h-8 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-lg transition-all text-xs" title="Sayfa">🌐</a>
                  <form method="POST" action="/admin/fotograflar/sil/<%= item.id %>" style="display:inline"><button type="submit" data-confirm="Silinsin mi?" class="inline-flex items-center justify-center w-8 h-8 bg-red-950/50 hover:bg-red-900 text-red-400 rounded-lg border border-red-800/50 transition-all text-xs" title="Sil">🗑️</button></form>
                <% } %>
              </td>
            </tr>
            <% }) %>
            <% if (items.length === 0) { %>
              <tr><td colspan="7" class="p-12 text-center text-zinc-500">Henüz fotoğraf gönderisi yok.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <p class="text-zinc-600 text-xs mt-4 text-center">Fotoğraflar "Sizlerden Gelen" sayfasında en yeniden eskiye doğru sıralanır (özel sıralama yoktur).</p>
  </div>
</div>
