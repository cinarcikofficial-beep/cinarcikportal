<script>
(function () {
  var wrap = document.getElementById('galleryWrap');
  if (!wrap) return;
  var list = document.getElementById('galleryPreviewContainer');
  var input = document.getElementById('galleryInput');
  var dropzone = document.getElementById('galleryDropzone');
  var counter = document.getElementById('gallery-counter');
  var orderField = document.getElementById('gallery_order');
  var form = (input && input.form) || document.getElementById('admin-form');
  var selectedCountEl = document.getElementById('selected-preview-count');
  var max = parseInt(wrap.getAttribute('data-max') || '0', 10) || 0;
  var tpl = wrap.getAttribute('data-counter-format') || '(Toplam: %d)';
  var dt = new DataTransfer();

  // Dosya seçici olarak kullanılan geçici gizli picker input
  // Gerçek form inputunun (.files) sıfırlanmasını veya tarayıcı tarafından yutulmasını önler
  var picker = document.createElement('input');
  picker.type = 'file';
  picker.multiple = true;
  picker.accept = 'image/*';
  picker.style.display = 'none';
  wrap.appendChild(picker);

  function existingCount() {
    return list ? list.querySelectorAll('[data-kind="existing"]').length : 0;
  }

  function updateCounter() {
    if (counter) counter.textContent = tpl.replace('%d', existingCount() + dt.files.length);
    if (selectedCountEl) {
      var n = selectedCountEl.querySelector('.selected-count');
      if (dt.files.length > 0) {
        selectedCountEl.classList.remove('hidden');
        if (n) n.textContent = dt.files.length;
      } else {
        selectedCountEl.classList.add('hidden');
      }
    }
  }

  function makeNewNode(idx) {
    var el = document.createElement('div');
    el.className = 'relative gallery-preview-item group';
    el.setAttribute('data-kind', 'new');
    el.setAttribute('data-idx', idx);
    el.setAttribute('draggable', 'true');
    var im = document.createElement('img');
    im.className = 'w-20 h-20 rounded-lg object-cover border border-zinc-700';
    try {
      im.src = URL.createObjectURL(dt.files[idx]);
    } catch (_) {
      im.src = '';
    }
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'remove-preview absolute -top-2 -right-2 w-5 h-5 bg-rose-500 hover:bg-rose-600 text-white text-xs rounded-full flex items-center justify-center opacity-70 group-hover:opacity-100 transition-opacity';
    btn.title = 'Kaldır';
    btn.innerHTML = '&times;';
    el.appendChild(im);
    el.appendChild(btn);
    return el;
  }

  // DOM'daki yeni görsel sırasını DataTransfer'e ve form inputuna yansıtır
  function resyncNew() {
    if (!list) return;
    var nodes = Array.prototype.slice.call(list.querySelectorAll('[data-kind="new"]'));
    var ndt = new DataTransfer();
    nodes.forEach(function (el) {
      var i = parseInt(el.getAttribute('data-idx'), 10);
      if (!isNaN(i) && dt.files[i]) ndt.items.add(dt.files[i]);
    });
    dt = ndt;
    nodes.forEach(function (el, k) { el.setAttribute('data-idx', k); });
    if (input) {
      try {
        input.files = dt.files;
      } catch (err) {
        console.warn('input.files atanamadi:', err);
      }
    }
  }

  function addFiles(files) {
    var arr = files ? Array.prototype.slice.call(files) : [];
    var accepted = arr.filter(function (f) { return f.type && f.type.indexOf('image/') === 0; });
    if (!accepted.length) return;
    if (max > 0 && existingCount() + dt.files.length + accepted.length > max) {
      var room = Math.max(max - (existingCount() + dt.files.length), 0);
      accepted = accepted.slice(0, room);
      if (!accepted.length) {
        if (window.adminAlert) adminAlert('En fazla ' + max + ' görsel ekleyebilirsiniz.', 'Galeri limiti');
        else alert('En fazla ' + max + ' görsel ekleyebilirsiniz.');
        return;
      }
      if (window.adminAlert) adminAlert('Galeri limiti ' + max + ' görsel, fazlası eklenmedi.', 'Galeri limiti');
      else alert('Galeri limiti ' + max + ' görsel, fazlası eklenmedi.');
    }
    accepted.forEach(function (f) {
      dt.items.add(f);
      if (list) list.appendChild(makeNewNode(dt.files.length - 1));
    });
    if (input) {
      try {
        input.files = dt.files;
      } catch (err) {
        console.warn('input.files atanamadi:', err);
      }
    }
    serializeOrder();
    updateCounter();
  }

  // Dropzone tıklanınca temiz picker açılır
  if (dropzone) {
    dropzone.addEventListener('click', function () {
      picker.click();
    });
    ['dragover', 'dragenter'].forEach(function (ev) {
      dropzone.addEventListener(ev, function (e) {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-emerald-400', 'bg-zinc-900');
      });
    });
    ['dragleave', 'drop'].forEach(function (ev) {
      dropzone.addEventListener(ev, function (e) {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-emerald-400', 'bg-zinc-900');
      });
    });
    dropzone.addEventListener('drop', function (e) {
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
        addFiles(e.dataTransfer.files);
      }
    });
  }

  // Picker değiştiğinde dosyaları aktar ve picker'ı sıfırla (aynı dosya tekrar seçilebilsin)
  picker.addEventListener('change', function (e) {
    if (e.target.files && e.target.files.length) {
      addFiles(e.target.files);
    }
    picker.value = '';
  });

  // Eğer doğrudan input tetiklenirse (fallback)
  if (input) {
    input.addEventListener('change', function (e) {
      if (e.target.files && e.target.files.length) {
        addFiles(e.target.files);
      }
      // DİKKAT: input.value ASLA sıfırlanmamalı, form gönderiminde bu dosya listesi gidecek!
    });
  }

  if (list) {
    list.addEventListener('click', function (e) {
      var ex = e.target.closest('.gallery-remove');
      if (ex) {
        var item = ex.closest('[data-kind="existing"]');
        if (item) item.remove();
        serializeOrder();
        updateCounter();
        return;
      }
      var rm = e.target.closest('.remove-preview');
      if (rm) {
        var node = rm.closest('[data-kind="new"]');
        if (!node) return;
        var im = node.querySelector('img');
        if (im && im.src.indexOf('blob:') === 0) URL.revokeObjectURL(im.src);
        node.remove();
        resyncNew();
        serializeOrder();
        updateCounter();
      }
    });

    var dragged = null;
    list.addEventListener('dragstart', function (e) {
      var item = e.target.closest('[data-kind]');
      if (!item) return;
      dragged = item;
      item.classList.add('opacity-50');
      try {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', '');
      } catch (_) {}
    });
    list.addEventListener('dragend', function () {
      if (!dragged) return;
      dragged.classList.remove('opacity-50');
      dragged = null;
      resyncNew();
      serializeOrder();
    });
    list.addEventListener('dragover', function (e) {
      if (!dragged) return;
      e.preventDefault();
      var over = e.target.closest('[data-kind]');
      if (!over || over === dragged) return;
      var rect = over.getBoundingClientRect();
      var horizontal = Math.abs(e.clientY - (rect.top + rect.height / 2)) < rect.height / 2;
      var before = horizontal
        ? e.clientX < rect.left + rect.width / 2
        : e.clientY < rect.top + rect.height / 2;
      if (before) {
        if (over.previousSibling !== dragged) list.insertBefore(dragged, over);
      } else {
        if (over.nextSibling !== dragged) list.insertBefore(dragged, over.nextSibling);
      }
    });
    list.addEventListener('drop', function (e) {
      if (dragged) e.preventDefault();
    });
  }

  function serializeOrder() {
    if (!orderField || !list) return;
    var order = [];
    Array.prototype.forEach.call(list.querySelectorAll('[data-kind]'), function (el) {
      if (el.getAttribute('data-kind') === 'existing') {
        var url = el.getAttribute('data-url');
        if (url) order.push(['e', url]);
      } else {
        var i = parseInt(el.getAttribute('data-idx'), 10);
        if (!isNaN(i)) order.push(['n', i]);
      }
    });
    orderField.value = JSON.stringify(order);
  }

  if (form) {
    form.addEventListener('submit', function () {
      resyncNew();
      serializeOrder();
    });
  }

  // Başlangıçta mevcut sırayı serialize et ve sayacı güncelle
  serializeOrder();
  updateCounter();
})();
</script>
