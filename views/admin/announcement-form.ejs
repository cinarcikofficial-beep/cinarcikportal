<% layout('partials/layout') %>
<% locals.pageTitle = edit ? 'Duyuru Düzenle' : 'Yeni Duyuru' %>

<div class="container mx-auto px-4 py-8 max-w-2xl space-y-6">
  <a href="/admin" class="inline-flex items-center gap-2 text-gray-400 hover:text-emerald-400 transition-colors text-sm">
    <span class="text-lg">←</span> Yönetim Paneline Dön
  </a>

  <div>
    <h1 class="text-3xl font-bold text-white flex items-center gap-3">
      <span class="text-2xl">📢</span>
      <%= edit ? 'Duyuru Düzenle' : 'Yeni Duyuru Oluştur' %>
    </h1>
    <p class="text-gray-400 mt-1 text-sm">Duyuru veya ilan içeriğini ekleyin</p>
  </div>

  <% if (error) { %>
  <div class="bg-rose-500/10 border border-rose-500/30 text-rose-400 rounded-xl px-4 py-3 text-sm flex items-center gap-2">
    <span class="text-lg">⚠️</span> <%= error %>
  </div>
  <% } %>

  <form action="/admin/duyuru-ekle" method="POST" enctype="multipart/form-data" id="admin-form" class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-5">
    <% if (edit) { %>
      <input type="hidden" name="edit_id" value="<%= edit.id %>" />
      <input type="hidden" name="existing_image" value="<%= edit.image || '' %>" />
    <% } %>

    <div>
      <label class="block text-sm font-medium text-gray-300 mb-2">Görsel</label>
      <% if (edit && edit.image) { %>
        <img src="<%= edit.image %>" alt="Mevcut görsel" class="max-h-32 rounded-lg border border-zinc-800 mb-3" />
      <% } %>
      <input type="file" name="image" accept="image/*"
        class="block w-full text-sm text-zinc-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:bg-zinc-800 file:text-zinc-200 hover:file:bg-zinc-700 file:cursor-pointer" />
      <p class="text-xs text-zinc-500 mt-1">JPEG, PNG veya WebP, en fazla 10 MB</p>
    </div>

    <div>
      <label for="title" class="block text-sm font-medium text-gray-300 mb-2">Başlık</label>
      <input type="text" id="title" name="title" value="<%= edit ? edit.title : '' %>"
        class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors"
        placeholder="Duyuru başlığını girin" />
    </div>

    <div>
      <label for="content" class="block text-sm font-medium text-gray-300 mb-2">İçerik</label>
      <div id="ann-editor" class="ql-wrapbox bg-zinc-950 border border-zinc-800 rounded-xl overflow-hidden"></div>
      <textarea id="content" name="content" hidden><%= edit ? edit.content : '' %></textarea>
    </div>

    <div>
      <label for="category" class="block text-sm font-medium text-gray-300 mb-2">Kategori</label>
      <select id="category" name="category"
        class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
        <option value="duyuru" <%= edit && edit.category === 'duyuru' ? 'selected' : '' %>>📢 Duyuru</option>
        <option value="ilan" <%= edit && edit.category === 'ilan' ? 'selected' : '' %>>📋 İlan</option>
      </select>
    </div>

    <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-800">
      <a href="/admin" class="px-5 py-3 rounded-xl text-gray-300 hover:text-white border border-zinc-700 hover:bg-zinc-800 transition-all text-sm font-medium">İptal</a>
      <button type="submit" id="submit-btn" class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold px-6 py-3 rounded-xl transition-all">
        <svg id="spinner" class="hidden animate-spin h-5 w-5 text-zinc-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
        <span id="submit-text"><%= edit ? 'Güncelle' : 'Kaydet & Yayınla' %></span>
      </button>
    </div>
  </form>
</div>

<%- include('partials/quill') %>
<script>
  initQuillEditor('#ann-editor', 'content', 'Duyuru içeriğini yazın', false);
</script>

<script>
(function() {
  var form = document.getElementById('admin-form');
  var btn = document.getElementById('submit-btn');
  var spinner = document.getElementById('spinner');
  var txt = document.getElementById('submit-text');
  form.addEventListener('submit', function() {
    spinner.classList.remove('hidden');
    txt.textContent = 'Kaydediliyor...';
    btn.disabled = true;
    btn.classList.add('opacity-75');
  });
})();
</script>