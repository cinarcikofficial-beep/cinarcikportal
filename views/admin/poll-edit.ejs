<% layout('partials/layout') %>
<% locals.pageTitle = 'Anket Düzenle' %>

<div class="min-h-screen bg-zinc-950 text-zinc-100">
  <div class="max-w-3xl mx-auto px-4 py-8">

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg mb-6">
      <div class="p-4 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-lg font-bold text-white">✏️ Anket Düzenle <span class="text-xs font-mono text-zinc-500">#<%= poll.id %></span></h3>
        <a href="/admin/anketler" class="inline-flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 px-4 py-2.5 rounded-xl text-sm font-medium transition-all">← Anketler</a>
      </div>
      <div class="p-4 text-sm text-zinc-400 leading-relaxed">
        Seçenek sırası aynı kaldığı sürece mevcut oylar korunur. Seçenek silersen o seçeneğe verilmiş oylar da silinir.
      </div>
    </div>

    <% if (errorQ) { %>
    <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-sm rounded-xl p-4 mb-6">Soru 3-300 karakter olmalı.</div>
    <% } %>
    <% if (errorOpt) { %>
    <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-sm rounded-xl p-4 mb-6">En az 2, en fazla 8 seçenek; her biri en fazla 120 karakter.</div>
    <% } %>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-lg">
      <form method="POST" action="/admin/anketler/guncelle/<%= poll.id %>" class="p-4 space-y-3">
        <div>
          <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Soru</label>
          <textarea name="question" rows="2" required minlength="3" maxlength="300"
            class="w-full bg-zinc-950 text-zinc-100 border border-zinc-700 rounded-xl px-3.5 py-2 text-sm outline-none focus:border-emerald-500/60"><%= poll.question %></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Seçenekler (en az 2, en fazla 8)</label>
          <div id="poll-opts" class="space-y-2">
            <% (options || []).forEach((o, i) => { %>
            <input type="text" name="labels" value="<%= o.label %>" maxlength="120" placeholder="Seçenek <%= i + 1 %>" class="poll-opt w-full bg-zinc-950 text-zinc-100 border border-zinc-700 rounded-xl px-3.5 py-2 text-sm outline-none focus:border-emerald-500/60">
            <% }) %>
          </div>
          <div class="flex items-center gap-2 mt-2">
            <button type="button" id="poll-add-opt" class="text-xs font-semibold text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1.5 rounded-lg hover:bg-emerald-500/20 transition">+ Seçenek Ekle</button>
            <span class="text-xs text-zinc-500">Boş seçenek alanları kayıt sırasında yok sayılır</span>
          </div>
        </div>
        <div>
          <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition">Değişiklikleri Kaydet</button>
        </div>
      </form>
    </div>

  </div>
</div>

<script>
  (function () {
    var wrap = document.getElementById('poll-opts');
    var addBtn = document.getElementById('poll-add-opt');
    if (addBtn && wrap) {
      addBtn.addEventListener('click', function () {
        if (wrap.children.length >= 8) return;
        var i = wrap.children.length;
        var inp = document.createElement('input');
        inp.type = 'text';
        inp.name = 'labels';
        inp.maxLength = 120;
        inp.placeholder = 'Seçenek ' + (i + 1);
        inp.className = 'poll-opt w-full bg-zinc-950 text-zinc-100 border border-zinc-700 rounded-xl px-3.5 py-2 text-sm outline-none focus:border-emerald-500/60';
        wrap.appendChild(inp);
        inp.focus();
      });
    }
  })();
</script>
