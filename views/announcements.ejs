<% layout('partials/layout') %>
<% locals.pageTitle = t('annList') %>

<div class="page-banner">
  <h1>📢 <%= t('annList') %></h1>
  <p><%= t('annSubtitle') %></p>
</div>

<section class="section">
  <% if (announcements.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📢</div>
    <h3><%= t('noAnnouncements') %></h3>
    <p><%= t('annSoon') %></p>
  </div>
  <% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% announcements.forEach(a => { %>
    <div class="card announcement-card">
      <span class="announce-tag <%= a.category === 'ilan' ? 'tag-ilan' : 'tag-duyuru' %>"><%= a.category === 'ilan' ? t('ad') : t('announcement') %></span>
      <% if (a.image) { %><img src="<%= a.image %>" alt="<%= a.title %>" class="w-full h-48 object-cover rounded-xl mb-3 cursor-pointer hover:opacity-90 transition" onclick="openAnnDetail(this)" data-title="<%= a.title %>" data-content="<%= String(a.content || '').replace(/<[^>]*>/g, ' ') %>" data-date="<%= new Date(a.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' }) %>" data-category="<%= a.category === 'ilan' ? t('ad') : t('announcement') %>" /><% } %>
      <h3><%= a.title %></h3>
      <p><%= String(a.content || '').replace(/<[^>]*>/g, ' ').substring(0, 300) %></p>
      <span class="card-date"><%= new Date(a.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
    </div>
    <% }) %>
  </div>
  <% } %>
</section>

<div id="ann-modal" class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4" onclick="closeAnnDetail()">
  <div class="relative max-w-3xl w-full bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden max-h-[90vh] flex flex-col" onclick="event.stopPropagation()">
    <button class="absolute top-3 right-3 text-white text-2xl bg-black/50 w-9 h-9 rounded-full z-10" onclick="closeAnnDetail()">&times;</button>
    <img id="ann-modal-img" src="" alt="" class="w-full max-h-[55vh] object-contain bg-black" />
    <div class="p-5 overflow-y-auto">
      <span id="ann-modal-cat" class="announce-tag tag-duyuru"></span>
      <h3 id="ann-modal-title" class="text-xl font-bold text-white mt-2"></h3>
      <p id="ann-modal-content" class="text-zinc-400 text-sm mt-2 whitespace-pre-line"></p>
      <span id="ann-modal-date" class="card-date mt-3 inline-block"></span>
    </div>
  </div>
</div>

<script>
function openAnnDetail(el) {
  document.getElementById('ann-modal-img').src = el.src;
  document.getElementById('ann-modal-title').textContent = el.dataset.title;
  document.getElementById('ann-modal-content').textContent = el.dataset.content;
  document.getElementById('ann-modal-date').textContent = el.dataset.date;
  document.getElementById('ann-modal-cat').textContent = el.dataset.category;
  var m = document.getElementById('ann-modal');
  m.classList.remove('hidden');
  m.classList.add('flex');
  document.body.style.overflow = 'hidden';
}
function closeAnnDetail() {
  var m = document.getElementById('ann-modal');
  m.classList.add('hidden');
  m.classList.remove('flex');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeAnnDetail(); });
</script>