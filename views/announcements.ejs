<% layout('partials/layout') %>
<% locals.pageTitle = t('annList') %>

<style>
  .ann-full .rich-desc img { max-width: 100%; height: auto; border-radius: 0.75rem; margin: 0.5rem 0; }
  .ann-full .rich-desc a { position: relative; z-index: 10; color: #34d399; text-decoration: underline; font-weight: 600; word-break: break-word; }
  .ann-full .rich-desc a:hover { color: #6ee7b7; }
  .cat-pill { border: 1px solid #3f3f46; color: #a1a1aa; transition: all .2s ease; cursor: pointer; }
  .cat-pill:hover { border-color: #10b981; color: #34d399; }
  .cat-pill.active { background: rgba(16,185,129,.12); border-color: rgba(16,185,129,.45); color: #34d399; }
  @keyframes ilanFlash {
    0%, 100% { box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.25), 0 0 0 0 rgba(52, 211, 153, 0); filter: brightness(1); }
    50% { box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3), 0 0 22px 6px rgba(52, 211, 153, 0.6); filter: brightness(1.4); }
  }
  .ilan-flash { animation: ilanFlash 1s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) { .ilan-flash { animation: none; } }
  #ilan-modal.show { display: flex; }
  html.light #ilan-modal .modal-card { background: #ffffff !important; border-color: #e2e8f0 !important; color: #0f172a !important; }
  html.light #ilan-modal input, html.light #ilan-modal textarea, html.light #ilan-modal select { background-color: #ffffff !important; color: #0f172a !important; border-color: #cbd5e1 !important; }
</style>

<section class="section pt-6 sm:pt-8">
  <div class="section-header">
    <h2>📢 <%= t('annList') %></h2>
    <button type="button" id="open-ilan-modal-btn" class="ilan-flash inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition-all cursor-pointer shadow-lg shadow-emerald-950/40">
      ✏️ <%= t('postListing') %>
    </button>
  </div>

  <div class="flex flex-wrap gap-2 mb-6" id="annCatPills">
    <button type="button" class="cat-pill active rounded-full px-4 py-1.5 text-xs font-bold" data-cat="all"><%= t('catAll') %></button>
    <button type="button" class="cat-pill rounded-full px-4 py-1.5 text-xs font-bold" data-cat="duyuru"><%= t('announcement') %></button>
    <button type="button" class="cat-pill rounded-full px-4 py-1.5 text-xs font-bold" data-cat="ilan"><%= t('ad') %></button>
    <button type="button" class="cat-pill rounded-full px-4 py-1.5 text-xs font-bold" data-cat="etkinlik"><%= t('event') %></button>
  </div>

  <% if (typeof submitted !== 'undefined' && submitted) { %>
    <div class="bg-emerald-950/60 border border-emerald-800/60 text-emerald-300 text-sm rounded-xl px-4 py-3 mb-6 flex items-center gap-2.5">
      <span class="text-lg">✓</span>
      <span><%= t('listingSubmitted') %></span>
    </div>
  <% } %>
  <% if (announcements.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📢</div>
    <h3><%= t('noAnnouncements') %></h3>
    <p><%= t('annSoon') %></p>
  </div>
  <% } else { %>
  <div id="annCatEmpty" style="display:none;" class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-10 text-center mb-6">
    <p class="text-3xl mb-2">📢</p>
    <p class="text-zinc-400 text-sm"><%= t('noAnnouncements') %></p>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch" id="announcementsGrid">
    <% announcements.forEach((a, idx) => { %>
    <%
      const isRich = /<[a-z][\s\S]*>/i.test(a.content || '');
      const dateStr = new Date(a.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' });
      const cleanContent = String(a.content || '').replace(/\s+target=["']_blank["']/gi, '').replace(/\s+rel=["']noopener\s*noreferrer["']/gi, '');
    %>
    <div class="card announcement-card ann-full ann-card-item relative flex flex-col" data-cat="<%= a.category || 'duyuru' %>" <%- idx >= 6 ? 'style="display:none;"' : '' %>>
      <span class="announce-tag <%= a.category === 'ilan' ? 'tag-ilan' : a.category === 'etkinlik' ? 'tag-etkinlik' : 'tag-duyuru' %>"><%= a.category === 'ilan' ? t('ad') : a.category === 'etkinlik' ? t('event') : t('announcement') %></span>
      <% if (a.image) { %><img src="<%= img(a.image) %>" alt="<%= a.title %>" loading="lazy" decoding="async" class="w-full h-64 object-cover ann-img-frame rounded-xl mb-3" /><% } %>
      <h3 class="text-lg font-bold text-white mb-1 line-clamp-2 min-h-[3.5rem]"><%= a.title %></h3>
      <span class="card-date block mb-3"><%= dateStr %></span>
      <div class="article-body flex-1 text-sm text-zinc-300 leading-relaxed">
        <% if (isRich) { %>
        <div class="rich-desc"><%- cleanContent %></div>
        <% } else { %>
        <div class="whitespace-pre-line"><%= a.content %></div>
        <% } %>
      </div>
      <a href="/duyuru/<%= a.slug || a.id %>" class="absolute inset-0 rounded-2xl" aria-label="<%= a.title %>"></a>
    </div>
    <% }) %>
  </div>

  <%
    const safeLang = typeof lang !== 'undefined' ? lang : 'tr';
    const loadMoreAnnTxt = (typeof t === 'function' && t('loadMoreAnnouncements') && t('loadMoreAnnouncements') !== 'loadMoreAnnouncements')
      ? t('loadMoreAnnouncements')
      : ({ tr: 'Daha Fazla Duyuru Göster', en: 'Load More Announcements', ru: 'Показать больше объявлений', ar: 'عرض المزيد من الإعلانات', de: 'Mehr Ankündigungen anzeigen' })[safeLang] || 'Daha Fazla Duyuru Göster';
    const allAnnLoadedTxt = (typeof t === 'function' && t('allAnnouncementsLoaded') && t('allAnnouncementsLoaded') !== 'allAnnouncementsLoaded')
      ? t('allAnnouncementsLoaded')
      : ({ tr: 'Tüm duyurular görüntülendi', en: 'All announcements displayed', ru: 'Все объявления показаны', ar: 'تم عرض جميع الإعلانات', de: 'Alle Ankündigungen angezeigt' })[safeLang] || 'Tüm duyurular görüntülendi';
  %>
  <div class="flex flex-col items-center justify-center mt-10 mb-6 gap-3" id="loadMoreAnnContainer">
    <button type="button" id="loadMoreAnnBtn"
      style="<%= announcements.length > 6 ? '' : 'display:none;' %>"
      class="group relative inline-flex items-center gap-3 px-8 py-3.5 rounded-full font-bold text-sm text-white bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 hover:from-emerald-500 hover:via-teal-500 hover:to-emerald-600 shadow-[0_4px_20px_rgba(16,185,129,0.35)] hover:shadow-[0_6px_28px_rgba(16,185,129,0.5)] border border-emerald-400/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-300 cursor-pointer select-none">
      <span class="flex items-center justify-center w-6 h-6 rounded-full bg-black/20 text-white text-xs transition-transform duration-300 group-hover:translate-y-0.5">
        ↓
      </span>
      <span class="tracking-wide"><%= loadMoreAnnTxt %></span>
      <span class="text-[11px] font-black uppercase tracking-wider bg-white/20 px-2.5 py-0.5 rounded-full backdrop-blur-sm group-hover:bg-white group-hover:text-emerald-700 transition-colors">
        +3
      </span>
    </button>

    <div id="allAnnLoadedNotice" style="<%= announcements.length <= 6 ? 'display:inline-flex;' : 'display:none;' %>" class="items-center gap-2 px-5 py-2 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-medium text-zinc-400">
      <span class="text-emerald-400 font-bold">✓</span>
      <span><%= allAnnLoadedTxt %></span>
    </div>
  </div>
  <% } %>
</section>

<!-- 📝 İlan Verme Modal / Popup -->
<div id="ilan-modal" class="fixed inset-0 z-[120] hidden items-center justify-center p-3 sm:p-4 overflow-y-auto bg-black/80 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="ilan-modal-title">
  <div class="modal-card max-w-xl w-full bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl p-5 sm:p-7 relative my-8 transition-all transform scale-95 opacity-0 duration-200" id="ilan-modal-box">
    
    <!-- Modal Header -->
    <div class="flex items-start justify-between gap-4 pb-4 border-b border-zinc-800/80">
      <div>
        <h2 id="ilan-modal-title" class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>📝</span>
          <span><%= t('postListing') %></span>
        </h2>
        <p class="text-zinc-400 text-xs sm:text-sm mt-1"><%= t('postListingSub') %></p>
      </div>
      <button type="button" id="close-ilan-modal-btn" class="text-zinc-400 hover:text-white bg-zinc-800 hover:bg-zinc-700 w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-base font-bold cursor-pointer" aria-label="<%= t('cancel') %>">✕</button>
    </div>

    <!-- Alert Box (Hata / Başarı mesajları için) -->
    <div id="ilan-modal-alert" class="hidden my-4 p-3.5 rounded-xl text-sm font-medium"></div>

    <!-- Form -->
    <form id="ilan-modal-form" data-i18n-validate enctype="multipart/form-data" class="space-y-4 pt-3">
      <!-- Kullanıcı Bilgileri -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div>
          <label for="modal-user-name" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('nameLabel') %></label>
          <input type="text" id="modal-user-name" name="user_name" required minlength="2" maxlength="80"
            value="<%= (locals.googleUser && locals.googleUser.name) ? locals.googleUser.name : '' %>"
            placeholder="Adınız Soyadınız"
            class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
        </div>
        <div>
          <label for="modal-user-email" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('emailLabel') %> <span class="text-red-400">*</span></label>
          <input type="email" id="modal-user-email" name="user_email" required maxlength="120"
            value="<%= (locals.googleUser && locals.googleUser.email) ? locals.googleUser.email : '' %>"
            placeholder="ornek@email.com"
            class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div>
          <label for="modal-phone" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('phoneLabel') %> <span class="text-zinc-500 text-[11px] font-normal">(Opsiyonel)</span></label>
          <input type="tel" id="modal-phone" name="phone" maxlength="30"
            placeholder="05XX XXX XX XX"
            class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
        </div>
        <div>
          <label for="modal-category" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('categoryLabel') %></label>
          <select id="modal-category" name="category" class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
            <option value="ilan">🏷️ <%= t('ad') %></option>
            <option value="duyuru">📢 <%= t('announcement') %></option>
            <option value="etkinlik">🎉 <%= t('event') %></option>
          </select>
        </div>
      </div>

      <div id="modal-event-date-wrap" class="hidden">
        <label for="modal-event-date" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('eventDateOptional') %></label>
        <input type="date" id="modal-event-date" name="event_date"
          class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
        <p class="text-[11px] text-zinc-500 mt-1"><%= t('eventDateNote') %></p>
      </div>

      <div>
        <label for="modal-title" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('titleLabel') %> <span class="text-red-400">*</span></label>
        <input type="text" id="modal-title" name="title" required minlength="5" maxlength="120"
          placeholder="<%= t('titleLabel') %>"
          class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
      </div>

      <div>
        <label for="modal-content" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('listingContentLabel') %> <span class="text-red-400">*</span></label>
        <textarea id="modal-content" name="content" required minlength="20" maxlength="4000" rows="5"
          placeholder="<%= t('listingContentPlaceholder') %>"
          class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors resize-y"></textarea>
      </div>

      <div>
        <label for="modal-image" class="block text-xs font-semibold text-zinc-300 mb-1.5"><%= t('photoLabel') %> <span class="text-zinc-500 text-[11px] font-normal">(<%= t('listingOptional') %>)</span></label>
        <input type="file" id="modal-image" name="image" accept="image/jpeg,image/png,image/webp,image/gif"
          class="w-full bg-zinc-950 text-zinc-400 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs file:mr-3 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:bg-zinc-800 file:text-zinc-300 file:text-xs hover:file:bg-zinc-700 file:cursor-pointer">
        <p class="text-[11px] text-zinc-500 mt-1"><%= t('photoHint') %></p>
        <div id="modal-image-info" class="hidden mt-1.5 text-xs text-emerald-400 flex items-center gap-1.5">
          <span>📷</span>
          <span id="modal-image-name" class="truncate font-mono"></span>
          <button type="button" id="modal-image-clear" class="text-zinc-500 hover:text-red-400 ml-auto font-bold text-xs cursor-pointer">✕ Kaldır</button>
        </div>
      </div>

      <!-- Robot Doğrulaması (reCAPTCHA) -->
      <div class="pt-1">
        <div class="portal-recaptcha" id="modal-recaptcha"></div>
      </div>

      <!-- Footer Butonları -->
      <div class="flex items-center justify-end gap-3 pt-3 border-t border-zinc-800/80">
        <button type="button" id="modal-cancel-btn" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer"><%= t('cancel') %></button>
        <button type="submit" id="modal-submit-btn" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-6 py-2.5 rounded-xl transition-all shadow-md shadow-emerald-950/40 inline-flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
          <span id="modal-submit-text"><%= t('listingSubmit') %></span>
          <span id="modal-submit-spinner" class="hidden">⏳</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('ilan-modal');
  var box = document.getElementById('ilan-modal-box');
  var openBtn = document.getElementById('open-ilan-modal-btn');
  var closeBtn = document.getElementById('close-ilan-modal-btn');
  var cancelBtn = document.getElementById('modal-cancel-btn');
  var form = document.getElementById('ilan-modal-form');
  var alertBox = document.getElementById('ilan-modal-alert');
  var captchaImg = document.getElementById('modal-captcha-img');
  var captchaRefresh = document.getElementById('modal-captcha-refresh');
  var captchaInput = document.getElementById('modal-captcha');
  var categorySelect = document.getElementById('modal-category');
  var eventDateWrap = document.getElementById('modal-event-date-wrap');
  var imageInput = document.getElementById('modal-image');
  var imageInfo = document.getElementById('modal-image-info');
  var imageName = document.getElementById('modal-image-name');
  var imageClear = document.getElementById('modal-image-clear');
  var submitBtn = document.getElementById('modal-submit-btn');
  var submitText = document.getElementById('modal-submit-text');
  var submitSpinner = document.getElementById('modal-submit-spinner');

  function refreshCaptcha() {
    if (window.PortalRecaptcha) window.PortalRecaptcha.reset(form);
  }

  function showAlert(msg, isSuccess) {
    if (!alertBox) return;
    alertBox.className = isSuccess
      ? 'mb-4 p-3.5 rounded-xl text-sm font-medium bg-emerald-950/80 border border-emerald-800 text-emerald-300'
      : 'mb-4 p-3.5 rounded-xl text-sm font-medium bg-red-950/80 border border-red-800 text-red-300';
    alertBox.textContent = msg;
    alertBox.classList.remove('hidden');
    alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideAlert() {
    if (alertBox) {
      alertBox.textContent = '';
      alertBox.classList.add('hidden');
    }
  }

  function openModal() {
    if (!modal) return;
    hideAlert();
    refreshCaptcha();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function() {
      if (box) {
        box.classList.remove('scale-95', 'opacity-0');
        box.classList.add('scale-100', 'opacity-100');
      }
    });
    var firstInput = document.getElementById('modal-user-name');
    if (firstInput && !firstInput.value) firstInput.focus();
    else if (document.getElementById('modal-title')) document.getElementById('modal-title').focus();
  }

  function closeModal() {
    if (!modal) return;
    if (box) {
      box.classList.remove('scale-100', 'opacity-100');
      box.classList.add('scale-95', 'opacity-0');
    }
    setTimeout(function() {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      hideAlert();
    }, 150);
  }

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  if (captchaImg) captchaImg.addEventListener('click', refreshCaptcha);
  if (captchaRefresh) captchaRefresh.addEventListener('click', refreshCaptcha);

  if (categorySelect && eventDateWrap) {
    categorySelect.addEventListener('change', function() {
      if (this.value === 'etkinlik') {
        eventDateWrap.classList.remove('hidden');
      } else {
        eventDateWrap.classList.add('hidden');
      }
    });
  }

  if (imageInput && imageInfo && imageName) {
    imageInput.addEventListener('change', function() {
      if (this.files && this.files[0]) {
        imageName.textContent = this.files[0].name;
        imageInfo.classList.remove('hidden');
      } else {
        imageInfo.classList.add('hidden');
      }
    });
  }

  if (imageClear && imageInput && imageInfo) {
    imageClear.addEventListener('click', function() {
      imageInput.value = '';
      imageInfo.classList.add('hidden');
    });
  }

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      hideAlert();

      var fd = new FormData(form);
      submitBtn.disabled = true;
      submitText.textContent = '<%= t("sending") || "Gönderiliyor..." %>';
      submitSpinner.classList.remove('hidden');

      fetch('/ilan-ver', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: fd
      })
      .then(function(res) {
        return res.json().then(function(data) {
          return { ok: res.ok, status: res.status, data: data };
        }).catch(function() {
          return { ok: res.ok, status: res.status, data: {} };
        });
      })
      .then(function(result) {
        submitBtn.disabled = false;
        submitText.textContent = '<%= t("listingSubmit") %>';
        submitSpinner.classList.add('hidden');

        if (result.ok && result.data.success) {
          hideAlert();
          if (window.adminToast) adminToast(result.data.message || '<%= t("ilanReceived") %>', 'success');
          form.reset();
          if (imageInfo) imageInfo.classList.add('hidden');
          setTimeout(function() {
            closeModal();
            window.location.href = '/duyurular?gonderildi=1';
          }, 1400);
        } else {
          var err = (result.data && result.data.error) ? result.data.error : '<%= t("errorOccurred") %>';
          showAlert(err, false);
          if (window.adminToast) adminToast(err, 'error');
          refreshCaptcha();
        }
      })
      .catch(function(err) {
        submitBtn.disabled = false;
        submitText.textContent = '<%= t("listingSubmit") %>';
        submitSpinner.classList.add('hidden');
        var msg = '<%= t("connError") %>: ' + (err.message || 'Lütfen bağlantınızı kontrol edin.');
        showAlert(msg, false);
        if (window.adminToast) adminToast(msg, 'error');
        refreshCaptcha();
      });
    });
  }

  // Kategori Gruplama (Tümü / Duyuru / İlan / Etkinlik) + Daha Fazla Duyuru Göster (+3)
  var annCards = Array.prototype.slice.call(document.querySelectorAll('.ann-card-item'));
  var annCatPills = document.querySelectorAll('#annCatPills .cat-pill');
  var annCatEmpty = document.getElementById('annCatEmpty');
  var loadMoreAnnBtn = document.getElementById('loadMoreAnnBtn');
  var allAnnLoadedNotice = document.getElementById('allAnnLoadedNotice');
  var annVisibleLimit = 6;
  var activeAnnCat = 'all';

  function updateAnnDisplay() {
    var matching = annCards.filter(function(card) {
      var c = card.getAttribute('data-cat') || 'duyuru';
      return activeAnnCat === 'all' || c === activeAnnCat;
    });
    annCards.forEach(function(card) {
      var idx = matching.indexOf(card);
      card.style.display = (idx !== -1 && idx < annVisibleLimit) ? '' : 'none';
    });
    if (annCatEmpty) {
      annCatEmpty.style.display = matching.length === 0 ? '' : 'none';
    }
    if (loadMoreAnnBtn) {
      loadMoreAnnBtn.style.display = matching.length > annVisibleLimit ? '' : 'none';
    }
    if (allAnnLoadedNotice) {
      allAnnLoadedNotice.style.display = (matching.length > 0 && matching.length <= annVisibleLimit) ? 'inline-flex' : 'none';
    }
  }

  annCatPills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      annCatPills.forEach(function(p) { p.classList.remove('active'); });
      pill.classList.add('active');
      activeAnnCat = pill.getAttribute('data-cat') || 'all';
      annVisibleLimit = 6;
      updateAnnDisplay();
    });
  });

  if (loadMoreAnnBtn) {
    loadMoreAnnBtn.addEventListener('click', function() {
      annVisibleLimit += 3;
      updateAnnDisplay();
    });
  }
})();
</script>
