<% layout('partials/layout') %>
<% locals.pageTitle = t('annList') %>

<div class="page-banner">
  <h1>📢 <%= t('annList') %></h1>
  <p><%= t('annSubtitle') %></p>
</div>

<style>
  .ann-full .rich-desc img { max-width: 100%; height: auto; border-radius: 0.75rem; margin: 0.5rem 0; }
  .ann-full .rich-desc a { word-break: break-word; }
</style>

<section class="section">
  <div class="mb-6 rounded-2xl border border-emerald-500/25 bg-gradient-to-r from-emerald-600/25 via-emerald-600/10 to-transparent p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3 min-w-0">
      <span class="shrink-0 w-11 h-11 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-xl">✏️</span>
      <p class="text-emerald-100/90 text-sm sm:text-base font-medium leading-snug"><%= t('postListingSub') %></p>
    </div>
    <a href="/ilan-ver" class="group inline-flex items-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-white font-black text-sm px-6 py-3.5 rounded-xl transition-all shadow-lg shadow-emerald-500/30 hover:shadow-emerald-400/50 hover:-translate-y-0.5 shrink-0">
      ✏️ <%= t('postListing') %>
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
  <% if (typeof submitted !== 'undefined' && submitted) { %>
    <div class="bg-emerald-950/60 border border-emerald-800/60 text-emerald-300 text-sm rounded-xl px-4 py-3 mb-6"><%= t('listingSubmitted') %></div>
  <% } %>
  <% if (announcements.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📢</div>
    <h3><%= t('noAnnouncements') %></h3>
    <p><%= t('annSoon') %></p>
  </div>
  <% } else { %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    <% announcements.forEach(a => { %>
    <%
      const isRich = /<[a-z][\s\S]*>/i.test(a.content || '');
      const dateStr = new Date(a.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' });
    %>
    <div class="card announcement-card ann-full relative">
      <span class="announce-tag <%= a.category === 'ilan' ? 'tag-ilan' : 'tag-duyuru' %>"><%= a.category === 'ilan' ? t('ad') : t('announcement') %></span>
      <% if (a.image) { %><img src="<%= img(a.image) %>" alt="<%= a.title %>" class="w-full h-64 object-cover rounded-xl mb-3" /><% } %>
      <h3 class="text-lg font-bold text-white mb-1"><%= a.title %></h3>
      <span class="card-date block mb-3"><%= dateStr %></span>
      <div class="article-body text-sm text-zinc-300 leading-relaxed">
        <% if (isRich) { %>
        <div class="rich-desc"><%- a.content %></div>
        <% } else { %>
        <div class="whitespace-pre-line"><%= a.content %></div>
        <% } %>
      </div>
      <a href="/duyuru/<%= a.id %>" class="absolute inset-0 rounded-2xl" aria-label="<%= a.title %>"></a>
    </div>
    <% }) %>
  </div>
  <% } %>
</section>
