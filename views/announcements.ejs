<% layout('partials/layout') %>
<% locals.pageTitle = t('annList') %>

<div class="page-banner">
  <h1>📢 <%= t('annList') %></h1>
  <p><%= t('annSubtitle') %></p>
</div>

<style>
  .ann-full .rich-desc img { max-width: 100%; height: auto; border-radius: 0.75rem; margin: 0.5rem 0; }
  .ann-full .rich-desc a { word-break: break-word; }
</style>

<section class="section">
  <% if (announcements.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📢</div>
    <h3><%= t('noAnnouncements') %></h3>
    <p><%= t('annSoon') %></p>
  </div>
  <% } else { %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    <% announcements.forEach(a => { %>
    <%
      const isRich = /<[a-z][\s\S]*>/i.test(a.content || '');
      const dateStr = new Date(a.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' });
    %>
    <div class="card announcement-card ann-full relative">
      <span class="announce-tag <%= a.category === 'ilan' ? 'tag-ilan' : 'tag-duyuru' %>"><%= a.category === 'ilan' ? t('ad') : t('announcement') %></span>
      <% if (a.image) { %><img src="<%= img(a.image) %>" alt="<%= a.title %>" class="w-full max-h-64 object-cover rounded-xl mb-3" /><% } %>
      <h3 class="text-lg font-bold text-white mb-1"><%= a.title %></h3>
      <span class="card-date block mb-3"><%= dateStr %></span>
      <div class="article-body text-sm text-zinc-300 leading-relaxed">
        <% if (isRich) { %>
        <div class="rich-desc"><%- a.content %></div>
        <% } else { %>
        <div class="whitespace-pre-line"><%= a.content %></div>
        <% } %>
      </div>
      <a href="/duyuru/<%= a.id %>" class="absolute inset-0 rounded-2xl" aria-label="<%= a.title %>"></a>
    </div>
    <% }) %>
  </div>
  <% } %>
</section>
