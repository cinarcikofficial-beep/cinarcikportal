<% layout('partials/layout') %>
<% locals.pageTitle = announcement.title %>
<%
  const isRich = /<[a-z][\s\S]*>/i.test(announcement.content || '');
  const dateStr = new Date(announcement.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' });
%>

<style>
  .rich-desc img { max-width: 100%; height: auto; border-radius: 0.75rem; margin: 0.5rem 0; }
  .rich-desc a { word-break: break-word; }
</style>

<div class="article-detail max-w-4xl mx-auto">
  <div class="article-header mb-6">
    <a href="/duyurular" class="back-link mb-4"><%= t('annList') %></a>
    <div class="flex flex-wrap items-center gap-3 mb-3">
      <span class="announce-tag <%= announcement.category === 'ilan' ? 'tag-ilan' : announcement.category === 'etkinlik' ? 'tag-etkinlik' : 'tag-duyuru' %>"><%= announcement.category === 'ilan' ? t('ad') : announcement.category === 'etkinlik' ? t('event') : t('announcement') %></span>
      <span class="card-date"><%= dateStr %></span>
    </div>
    <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight leading-tight"><%= announcement.title %></h1>
    <div class="mt-2 mb-2">
      <button type="button" class="fav-btn" data-fav data-fav-type="announcements" data-fav-id="<%= announcement.id %>"
        data-fav-url="/duyuru/<%= announcement.slug || announcement.id %>" data-fav-title="<%= announcement.title %>"
        data-fav-img="<%= announcement.image || '' %>" aria-pressed="false"></button>
    </div>
    <% if (announcement.views_count) { %>
    <div class="flex items-center gap-2 text-zinc-500 text-sm mt-2">
      <span>👁️</span>
      <span><%= announcement.views_count %> <%= t('views') %></span>
    </div>
    <% } %>
  </div>

  <% if (announcement.image) { %>
  <img src="<%= img(announcement.image) %>" alt="<%= announcement.title %>" class="ann-zoom w-full max-h-[640px] object-contain ann-img-frame rounded-2xl mb-6" />
  <% } %>

  <div class="article-body text-gray-300 leading-relaxed">
    <% if (isRich) { %>
    <div class="rich-desc"><%- announcement.content %></div>
    <% } else { %>
    <div class="whitespace-pre-line"><%= announcement.content %></div>
    <% } %>
  </div>
</div>

<%- include('partials/zoom-lightbox') %>
