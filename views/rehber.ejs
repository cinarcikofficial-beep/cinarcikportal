<% layout('partials/layout') %>
<% locals.pageTitle = t('guide') %>

<style>
  body { font-family: 'Inter', sans-serif; }
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  .fade-in-up { animation: fadeInUp 0.4s ease forwards; }
</style>

<!-- Hero Section — mekanlar ile aynı foto zeminli hero -->
<div class="places-hero">
  <div class="places-hero-bg"></div>
  <div class="places-hero-content">
    <span class="text-5xl mb-4 block">🏢</span>
    <h1 class="text-4xl md:text-5xl font-black text-white mb-3 tracking-tight"><%= t('guide') %></h1>
    <p class="text-zinc-300 text-lg max-w-2xl mx-auto"><%= t('rehberSubtitle') %></p>
    <div class="mt-8 max-w-lg mx-auto relative">
      <input type="text" id="company-search" placeholder="<%= t('companySearchPlaceholder') %>"
        class="w-full bg-zinc-950/80 text-white border border-zinc-700/60 rounded-2xl px-5 py-3.5 pl-12 text-sm placeholder-zinc-400 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors shadow-lg backdrop-blur">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </div>
    <!-- Category Pills -->
    <div class="mt-6 flex flex-wrap justify-center gap-2" id="category-pills">
      <button class="cat-pill cat-active" data-category="all"><%= t('catAll') %></button>
      <button class="cat-pill" data-category="İnşaat">🏗️ <%= t('catConstruction') %></button>
      <button class="cat-pill" data-category="Güzellik Merkezi">💆 <%= t('catBeauty') %></button>
      <button class="cat-pill" data-category="Market">🛒 <%= t('catMarket') %></button>
      <button class="cat-pill" data-category="Sağlık">🏥 <%= t('catHealth') %></button>
      <button class="cat-pill" data-category="Eğitim">📚 <%= t('catEducation') %></button>
      <button class="cat-pill" data-category="Hizmet">🔧 <%= t('catService') %></button>
      <button class="cat-pill" data-category="Emlak">🏠 <%= t('catRealEstate') %></button>
      <button class="cat-pill" data-category="Diğer">📁 <%= t('catOther') %></button>
    </div>
  </div>
</div>

<!-- Company List -->
<div class="max-w-7xl mx-auto px-4 py-8">
  <!-- 📞 Çınarcık Acil & Önemli Telefonlar -->
  <%- include('partials/emergency-phones') %>

  <% if (companies.length === 0) { %>
    <div class="text-center py-20">
      <span class="text-5xl block mb-4">📋</span>
      <p class="text-zinc-500 text-lg"><%= t('noCompanies') %></p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="company-grid">
      <% companies.forEach((company, idx) => {
        const gallery = typeof company.gallery_images === 'string' ? JSON.parse(company.gallery_images || '[]') : (company.gallery_images || []);
        const img = company.logo_url || (gallery[0] || '');
        const emoji = company.category === 'İnşaat' ? '🏗️' : company.category === 'Güzellik Merkezi' ? '💆' : company.category === 'Market' ? '🛒' : company.category === 'Sağlık' ? '🏥' : company.category === 'Eğitim' ? '📚' : company.category === 'Hizmet' ? '🔧' : company.category === 'Emlak' ? '🏠' : '🏢';
      %>
        <a href="/rehber/<%= company.slug || company.id %>"
          class="company-card group text-left w-full block bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden hover:border-zinc-700 transition-all shadow-lg hover:shadow-xl fade-in-up"
          style="animation-delay: <%= (idx % 6) * 50 %>ms; <%= idx >= 6 ? 'display:none;' : '' %>"
          data-category="<%= company.category || 'Genel' %>"
          data-name="<%= (company.name || '').toLowerCase() %>"
          data-sector="<%= (company.sector || '').toLowerCase() %>">

          <!-- Logo -->
          <div class="h-52 flex items-center justify-center bg-gradient-to-br from-zinc-950 to-zinc-900 relative overflow-hidden">
            <% if (img) { %>
              <img src="<%= img %>" alt="<%= company.name %>" loading="lazy" decoding="async" class="max-w-[85%] max-h-[80%] object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-lg">
            <% } else { %>
              <span class="text-6xl opacity-80 group-hover:scale-110 transition-transform duration-300"><%= emoji %></span>
            <% } %>
            <% if (company.is_featured == 1) { %>
              <span class="absolute top-3 right-3 bg-red-600 text-white text-[10px] font-bold px-2 py-1 rounded-full shadow-lg"><%= t('featured') %></span>
            <% } %>
          </div>

          <!-- İsim -->
          <div class="px-4 py-4 text-center">
            <h3 class="text-white font-bold text-base group-hover:text-emerald-400 transition-colors line-clamp-2"><%= company.name %></h3>
            <% if (company.sector) { %>
              <p class="text-white font-bold text-sm mt-1"><%= company.sector %></p>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>

    <%
      const safeLang = typeof lang !== 'undefined' ? lang : 'tr';
      const loadMoreCompaniesTxt = (typeof t === 'function' && t('loadMoreCompanies') && t('loadMoreCompanies') !== 'loadMoreCompanies')
        ? t('loadMoreCompanies')
        : ({ tr: 'Daha Fazla Firma Göster', en: 'Load More Companies', ru: 'Показать больше компаний', ar: 'عرض المزيد من الشركات', de: 'Mehr Firmen anzeigen' })[safeLang] || 'Daha Fazla Firma Göster';
      const allCompaniesLoadedTxt = (typeof t === 'function' && t('allCompaniesLoaded') && t('allCompaniesLoaded') !== 'allCompaniesLoaded')
        ? t('allCompaniesLoaded')
        : ({ tr: 'Tüm firmalar görüntülendi', en: 'All companies displayed', ru: 'Все компании показаны', ar: 'تم عرض جميع الشركات', de: 'Alle Firmen angezeigt' })[safeLang] || 'Tüm firmalar görüntülendi';
    %>
    <div class="flex flex-col items-center justify-center mt-10 mb-6 gap-3" id="loadMoreCompaniesContainer">
      <button type="button" id="loadMoreCompaniesBtn"
        style="<%= companies.length > 6 ? '' : 'display:none;' %>"
        class="group relative inline-flex items-center gap-3 px-8 py-3.5 rounded-full font-bold text-sm text-white bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 hover:from-emerald-500 hover:via-teal-500 hover:to-emerald-600 shadow-[0_4px_20px_rgba(16,185,129,0.35)] hover:shadow-[0_6px_28px_rgba(16,185,129,0.5)] border border-emerald-400/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-300 cursor-pointer select-none">
        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-black/20 text-white text-xs transition-transform duration-300 group-hover:translate-y-0.5">
          ↓
        </span>
        <span class="tracking-wide"><%= loadMoreCompaniesTxt %></span>
        <span class="text-[11px] font-black uppercase tracking-wider bg-white/20 px-2.5 py-0.5 rounded-full backdrop-blur-sm group-hover:bg-white group-hover:text-emerald-700 transition-colors">
          +3
        </span>
      </button>

      <div id="allCompaniesLoadedNotice" style="<%= companies.length <= 6 ? 'display:inline-flex;' : 'display:none;' %>" class="items-center gap-2 px-5 py-2 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-medium text-zinc-400">
        <span class="text-emerald-400 font-bold">✓</span>
        <span><%= allCompaniesLoadedTxt %></span>
      </div>
    </div>
  <% } %>
</div>

<script>
(function() {
  var searchInput = document.getElementById('company-search');
  var pills = document.querySelectorAll('.cat-pill');
  var cards = Array.from(document.querySelectorAll('.company-card'));
  var loadMoreBtn = document.getElementById('loadMoreCompaniesBtn');
  var allLoadedNotice = document.getElementById('allCompaniesLoadedNotice');
  var visibleLimit = 6;

  function filter(resetLimit) {
    if (resetLimit !== false) visibleLimit = 6;
    var term = searchInput ? searchInput.value.toLowerCase() : '';
    var activePill = document.querySelector('.cat-pill.cat-active');
    var cat = activePill ? activePill.dataset.category : 'all';

    var matching = cards.filter(function(card) {
      var name = card.dataset.name || '';
      var sector = card.dataset.sector || '';
      var category = card.dataset.category || '';
      var matchSearch = name.includes(term) || sector.includes(term);
      var matchCat = cat === 'all' || category === cat;
      return matchSearch && matchCat;
    });

    cards.forEach(function(card) {
      var idx = matching.indexOf(card);
      card.style.display = (idx !== -1 && idx < visibleLimit) ? '' : 'none';
    });

    if (loadMoreBtn) {
      loadMoreBtn.style.display = (matching.length > visibleLimit) ? '' : 'none';
    }
    if (allLoadedNotice) {
      allLoadedNotice.style.display = (matching.length > 0 && matching.length <= visibleLimit) ? 'inline-flex' : 'none';
    }
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function() {
      visibleLimit += 3;
      filter(false);
    });
  }

  if (searchInput) searchInput.addEventListener('input', function() { filter(true); });
  pills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      pills.forEach(function(p) { p.classList.remove('cat-active'); });
      pill.classList.add('cat-active');
      filter(true);
    });
  });
})();
</script>

<style>
  .cat-pill {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid rgba(63, 63, 70, 0.5);
    background: transparent;
    color: #a1a1aa;
    cursor: pointer;
    transition: all 0.2s;
  }
  .cat-pill:hover { background: rgba(39, 39, 42, 0.5); color: #e4e4e7; }
  .cat-pill.cat-active { background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.4); }
</style>
