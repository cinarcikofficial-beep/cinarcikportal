<% layout('partials/layout') %>
<% locals.pageTitle = t('eventsTitle') %>
<%
  const totalMainEvents = (upcoming ? upcoming.length : 0) + (undated ? undated.length : 0);
  let evCursor = 0;
  const safeLang = typeof lang !== 'undefined' ? lang : 'tr';
  const loadMoreEventsTxt = (typeof t === 'function' && t('loadMoreEvents') && t('loadMoreEvents') !== 'loadMoreEvents')
    ? t('loadMoreEvents')
    : ({ tr: 'Daha Fazla Etkinlik Göster', en: 'Load More Events', ru: 'Показать больше событий', ar: 'عرض المزيد من الفعاليات', de: 'Mehr Veranstaltungen anzeigen' })[safeLang] || 'Daha Fazla Etkinlik Göster';
  const allEventsLoadedTxt = (typeof t === 'function' && t('allEventsLoaded') && t('allEventsLoaded') !== 'allEventsLoaded')
    ? t('allEventsLoaded')
    : ({ tr: 'Tüm etkinlikler görüntülendi', en: 'All events displayed', ru: 'Все события показаны', ar: 'تم عرض جميع الفعاليات', de: 'Alle Veranstaltungen angezeigt' })[safeLang] || 'Tüm etkinlikler görüntülendi';
%>

<section class="section pt-6 sm:pt-8">
  <div class="section-header">
    <h2>🗓️ <%= t('eventsTitle') %></h2>
  </div>
  <% if (upcoming.length === 0 && undated.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">🗓️</div>
    <h3><%= t('noEvents') %></h3>
    <p><%= t('annSoon') %></p>
    <a href="/duyurular" class="inline-block mt-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition-all"><%= t('annList') %></a>
  </div>
  <% } %>

  <% if (upcoming.length > 0) { %>
  <div class="space-y-5 mb-8" id="upcomingEventsWrap">
    <% upcoming.forEach(ev => {
      const idx = evCursor++;
      const d = new Date(ev.event_date + 'T00:00:00');
      const isRich = /<[a-z][\s\S]*>/i.test(ev.content || '');
    %>
    <div class="flex flex-col sm:flex-row gap-4 items-stretch event-card-item" data-section="upcoming" <%- idx >= 6 ? 'style="display:none;"' : '' %>>
      <div class="shrink-0 w-full sm:w-28 bg-zinc-900 border border-amber-500/30 rounded-xl p-3 text-center self-start">
        <div class="text-amber-400 text-xs font-bold uppercase tracking-wide"><%= d.toLocaleDateString(t('dateLocale'), { weekday: 'short' }) %></div>
        <div class="text-white text-3xl font-black leading-none my-0.5"><%= d.getDate() %></div>
        <div class="text-zinc-400 text-xs"><%= d.toLocaleDateString(t('dateLocale'), { month: 'long' }) %></div>
      </div>
      <a href="/duyuru/<%= ev.slug || ev.id %>" class="card announcement-card ann-full relative flex-1 flex flex-col group">
        <span class="announce-tag tag-etkinlik"><%= t('event') %></span>
        <% if (ev.image) { %><img src="<%= img(ev.image) %>" alt="<%= ev.title %>" loading="lazy" decoding="async" class="ann-zoom w-full h-44 object-cover ann-img-frame rounded-xl mb-3" /><% } %>
        <h3 class="text-lg font-bold text-white mb-1 group-hover:text-emerald-400 transition-colors"><%= ev.title %></h3>
        <span class="card-date block mb-2"><%= d.toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        <div class="text-sm text-zinc-300 line-clamp-2"><%= isRich ? ev.content.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 180) : String(ev.content || '').replace(/\s+/g, ' ').trim().slice(0, 180) %></div>
      </a>
    </div>
    <% }) %>
  </div>
  <% } %>

  <% if (undated.length > 0) { %>
  <div id="undatedEventsWrap" <%- upcoming.length >= 6 ? 'style="display:none;"' : '' %>>
    <div class="section-header mb-4"><h2>🎟️ <%= t('undatedEvents') %></h2></div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch mb-8">
      <% undated.forEach(ev => {
        const idx = evCursor++;
        const isRich = /<[a-z][\s\S]*>/i.test(ev.content || '');
      %>
      <a href="/duyuru/<%= ev.slug || ev.id %>" class="card announcement-card ann-full event-card-item relative flex flex-col group" data-section="undated" <%- idx >= 6 ? 'style="display:none;"' : '' %>>
        <span class="announce-tag tag-etkinlik"><%= t('event') %></span>
        <% if (ev.image) { %><img src="<%= img(ev.image) %>" alt="<%= ev.title %>" loading="lazy" decoding="async" class="ann-zoom w-full h-44 object-cover ann-img-frame rounded-xl mb-3" /><% } %>
        <h3 class="text-lg font-bold text-white mb-1 group-hover:text-emerald-400 transition-colors"><%= ev.title %></h3>
        <span class="card-date block mb-2"><%= new Date(ev.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        <div class="text-sm text-zinc-300 line-clamp-2"><%= isRich ? ev.content.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 180) : String(ev.content || '').replace(/\s+/g, ' ').trim().slice(0, 180) %></div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% if (totalMainEvents > 0) { %>
  <div class="flex flex-col items-center justify-center mt-8 mb-8 gap-3" id="loadMoreEventsContainer">
    <button type="button" id="loadMoreEventsBtn"
      style="<%= totalMainEvents > 6 ? '' : 'display:none;' %>"
      class="group relative inline-flex items-center gap-3 px-8 py-3.5 rounded-full font-bold text-sm text-white bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 hover:from-emerald-500 hover:via-teal-500 hover:to-emerald-600 shadow-[0_4px_20px_rgba(16,185,129,0.35)] hover:shadow-[0_6px_28px_rgba(16,185,129,0.5)] border border-emerald-400/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-300 cursor-pointer select-none">
      <span class="flex items-center justify-center w-6 h-6 rounded-full bg-black/20 text-white text-xs transition-transform duration-300 group-hover:translate-y-0.5">
        ↓
      </span>
      <span class="tracking-wide"><%= loadMoreEventsTxt %></span>
      <span class="text-[11px] font-black uppercase tracking-wider bg-white/20 px-2.5 py-0.5 rounded-full backdrop-blur-sm group-hover:bg-white group-hover:text-emerald-700 transition-colors">
        +3
      </span>
    </button>

    <div id="allEventsLoadedNotice" style="<%= totalMainEvents <= 6 ? 'display:inline-flex;' : 'display:none;' %>" class="items-center gap-2 px-5 py-2 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-medium text-zinc-400">
      <span class="text-emerald-400 font-bold">✓</span>
      <span><%= allEventsLoadedTxt %></span>
    </div>
  </div>
  <% } %>

  <% if (past.length > 0) { %>
  <details class="bg-zinc-900/60 border border-zinc-800 rounded-2xl overflow-hidden">
    <summary class="cursor-pointer select-none px-5 py-4 text-sm font-semibold text-zinc-400 hover:text-white transition-colors">
      🕰️ <%= t('pastEvents') %> (<%= past.length %>)
    </summary>
    <ul class="px-5 pb-5 divide-y divide-zinc-800">
      <% past.forEach(ev => { %>
      <li class="py-2.5 flex items-center justify-between gap-4">
        <a href="/duyuru/<%= ev.slug || ev.id %>" class="text-sm text-zinc-400 hover:text-emerald-300 transition-colors line-clamp-1"><%= ev.title %></a>
        <span class="text-xs text-zinc-600 shrink-0"><%= ev.event_date %></span>
      </li>
      <% }) %>
    </ul>
  </details>
  <% } %>
</section>

<script>
(function() {
  var evCards = Array.prototype.slice.call(document.querySelectorAll('.event-card-item'));
  var loadMoreEventsBtn = document.getElementById('loadMoreEventsBtn');
  var allEventsLoadedNotice = document.getElementById('allEventsLoadedNotice');
  var undatedWrap = document.getElementById('undatedEventsWrap');
  var evVisibleLimit = 6;

  function updateEventsDisplay() {
    var anyUndatedVisible = false;
    evCards.forEach(function(card, idx) {
      var show = idx < evVisibleLimit;
      card.style.display = show ? '' : 'none';
      if (show && card.getAttribute('data-section') === 'undated') anyUndatedVisible = true;
    });
    if (undatedWrap) {
      undatedWrap.style.display = anyUndatedVisible ? '' : 'none';
    }
    if (loadMoreEventsBtn) {
      loadMoreEventsBtn.style.display = evCards.length > evVisibleLimit ? '' : 'none';
    }
    if (allEventsLoadedNotice) {
      allEventsLoadedNotice.style.display = (evCards.length > 0 && evCards.length <= evVisibleLimit) ? 'inline-flex' : 'none';
    }
  }

  if (loadMoreEventsBtn) {
    loadMoreEventsBtn.addEventListener('click', function() {
      evVisibleLimit += 3;
      updateEventsDisplay();
    });
  }
})();
</script>

<%- include('partials/zoom-lightbox') %>
