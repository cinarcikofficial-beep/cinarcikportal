<% layout('partials/layout') %>
<% locals.pageTitle = t('eventsTitle') %>

<div class="page-banner">
  <h1>🗓️ <%= t('eventsTitle') %></h1>
  <p><%= t('eventsUpcoming') %></p>
</div>

<section class="section">
  <% if (upcoming.length === 0 && undated.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">🗓️</div>
    <h3><%= t('noEvents') %></h3>
    <p><%= t('annSoon') %></p>
    <a href="/duyurular" class="inline-block mt-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition-all"><%= t('annList') %></a>
  </div>
  <% } %>

  <% if (upcoming.length > 0) { %>
  <div class="space-y-5 mb-8">
    <% upcoming.forEach(ev => {
      const d = new Date(ev.event_date + 'T00:00:00');
      const isRich = /<[a-z][\s\S]*>/i.test(ev.content || '');
    %>
    <div class="flex flex-col sm:flex-row gap-4 items-stretch">
      <div class="shrink-0 w-full sm:w-28 bg-zinc-900 border border-amber-500/30 rounded-xl p-3 text-center self-start">
        <div class="text-amber-400 text-xs font-bold uppercase tracking-wide"><%= d.toLocaleDateString(t('dateLocale'), { weekday: 'short' }) %></div>
        <div class="text-white text-3xl font-black leading-none my-0.5"><%= d.getDate() %></div>
        <div class="text-zinc-400 text-xs"><%= d.toLocaleDateString(t('dateLocale'), { month: 'long' }) %></div>
      </div>
      <a href="/duyuru/<%= ev.slug || ev.id %>" class="card announcement-card ann-full relative flex-1 flex flex-col group">
        <span class="announce-tag tag-etkinlik"><%= t('event') %></span>
      <% if (ev.image) { %><img src="<%= img(ev.image) %>" alt="<%= ev.title %>" loading="lazy" decoding="async" class="w-full h-44 object-cover ann-img-frame rounded-xl mb-3" /><% } %>
        <h3 class="text-lg font-bold text-white mb-1 group-hover:text-emerald-400 transition-colors"><%= ev.title %></h3>
        <span class="card-date block mb-2"><%= d.toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        <div class="text-sm text-zinc-300 line-clamp-2"><%= isRich ? ev.content.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 180) : String(ev.content || '').replace(/\s+/g, ' ').trim().slice(0, 180) %></div>
      </a>
    </div>
    <% }) %>
  </div>
  <% } %>

  <% if (undated.length > 0) { %>
  <div class="section-header mb-4"><h2>🎟️ <%= t('undatedEvents') %></h2></div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch mb-8">
    <% undated.forEach(ev => {
      const isRich = /<[a-z][\s\S]*>/i.test(ev.content || '');
    %>
    <a href="/duyuru/<%= ev.slug || ev.id %>" class="card announcement-card ann-full relative flex flex-col group">
      <span class="announce-tag tag-etkinlik"><%= t('event') %></span>
      <% if (ev.image) { %><img src="<%= img(ev.image) %>" alt="<%= ev.title %>" loading="lazy" decoding="async" class="w-full h-44 object-cover ann-img-frame rounded-xl mb-3" /><% } %>
      <h3 class="text-lg font-bold text-white mb-1 group-hover:text-emerald-400 transition-colors"><%= ev.title %></h3>
      <span class="card-date block mb-2"><%= new Date(ev.created_at).toLocaleDateString(t('dateLocale'), { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
      <div class="text-sm text-zinc-300 line-clamp-2"><%= isRich ? ev.content.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 180) : String(ev.content || '').replace(/\s+/g, ' ').trim().slice(0, 180) %></div>
    </a>
    <% }) %>
  </div>
  <% } %>

  <% if (past.length > 0) { %>
  <details class="bg-zinc-900/60 border border-zinc-800 rounded-2xl overflow-hidden">
    <summary class="cursor-pointer select-none px-5 py-4 text-sm font-semibold text-zinc-400 hover:text-white transition-colors">
      🕰️ <%= t('pastEvents') %> (<%= past.length %>)
    </summary>
    <ul class="px-5 pb-5 divide-y divide-zinc-800">
      <% past.forEach(ev => { %>
      <li class="py-2.5 flex items-center justify-between gap-4">
        <a href="/duyuru/<%= ev.slug || ev.id %>" class="text-sm text-zinc-400 hover:text-emerald-300 transition-colors line-clamp-1"><%= ev.title %></a>
        <span class="text-xs text-zinc-600 shrink-0"><%= ev.event_date %></span>
      </li>
      <% }) %>
    </ul>
  </details>
  <% } %>
</section>
