<% layout('partials/layout') %>
<% locals.pageTitle = t('postListing') %>

<style>
  #captcha-img { cursor: pointer; }
</style>
<script>
  function refreshCaptcha() {
    var img = document.getElementById('captcha-img');
    var input = document.getElementById('c-captcha');
    if (img) img.src = '/captcha.svg?t=' + Date.now();
    if (input) { input.value = ''; input.focus(); }
  }
</script>

<section class="section pt-6 sm:pt-8">
  <div class="max-w-2xl mx-auto">
    <div class="section-header">
      <h2>📝 <%= t('postListing') %></h2>
    </div>
    <% if (error) { %>
      <div class="bg-red-950/60 border border-red-800/60 text-red-300 text-sm rounded-xl px-4 py-3 mb-5"><%= error %></div>
    <% } %>

    <div class="card p-6 sm:p-8">
      <% if (user && user.email) { %>
        <div class="flex items-center gap-3 mb-6 pb-5 border-b border-zinc-800/70">
          <% if (user.avatar) { %>
            <img src="<%= user.avatar %>" alt="" class="w-10 h-10 rounded-full border border-zinc-700">
          <% } %>
          <div class="min-w-0">
            <p class="text-white font-semibold text-sm truncate"><%= user.name %></p>
            <p class="text-zinc-500 text-xs truncate"><%= user.email %></p>
          </div>
          <a href="/auth/google/logout?return=/ilan-ver" class="ml-auto text-xs text-zinc-500 hover:text-red-400 transition-colors shrink-0"><%= t('logout') %></a>
        </div>
      <% } %>

      <form action="/ilan-ver" method="POST" enctype="multipart/form-data" data-i18n-validate class="space-y-5" id="ilan-form">
        <!-- Kullanıcı İletişim Bilgileri -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="user_name" class="block text-sm font-medium text-zinc-300 mb-2"><%= t('nameLabel') %></label>
            <input type="text" id="user_name" name="user_name" required minlength="2" maxlength="80"
              value="<%= form.user_name || form.name || (user ? user.name : '') %>"
              class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors"
              placeholder="Adınız Soyadınız">
          </div>
          <div>
            <label for="user_email" class="block text-sm font-medium text-zinc-300 mb-2"><%= t('emailLabel') %> *</label>
            <input type="email" id="user_email" name="user_email" required maxlength="120"
              value="<%= form.user_email || form.email || (user ? user.email : '') %>"
              class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors"
              placeholder="ornek@email.com">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="phone" class="block text-sm font-medium text-zinc-300 mb-2"><%= t('phoneLabel') %> (<%= t('listingOptional') %>)</label>
            <input type="tel" id="phone" name="phone" maxlength="30"
              value="<%= form.phone || '' %>"
              class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors"
              placeholder="05XX XXX XX XX">
          </div>
          <div>
            <label for="category" class="block text-sm font-medium text-zinc-300 mb-2"><%= t('categoryLabel') %></label>
            <select id="category" name="category" class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors">
              <option value="ilan" <%= form.category !== 'duyuru' && form.category !== 'etkinlik' ? 'selected' : '' %>>🏷️ <%= t('ad') %></option>
              <option value="duyuru" <%= form.category === 'duyuru' ? 'selected' : '' %>>📢 <%= t('announcement') %></option>
              <option value="etkinlik" <%= form.category === 'etkinlik' ? 'selected' : '' %>>🎉 <%= t('event') %></option>
            </select>
          </div>
        </div>

        <div id="event-date-wrap" class="<%= form.category === 'etkinlik' ? '' : 'hidden' %>">
          <label for="event_date" class="block text-sm font-medium text-zinc-300 mb-2"><%= t('eventDateOptional') %></label>
          <input type="date" id="event_date" name="event_date" value="<%= form.event_date || '' %>"
            class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors" />
          <p class="text-xs text-zinc-500 mt-1"><%= t('eventDateNote') %></p>
        </div>

        <div>
          <label for="title" class="block text-sm font-medium text-zinc-300 mb-2"><%= t('titleLabel') %> *</label>
          <input type="text" id="title" name="title" maxlength="120" required minlength="5"
            value="<%= form.title || '' %>"
            class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors"
            placeholder="<%= t('titleLabel') %>">
        </div>

        <div>
          <label for="content" class="block text-sm font-medium text-zinc-300 mb-2"><%= t('listingContentLabel') %> *</label>
          <textarea id="content" name="content" rows="7" required minlength="20" maxlength="4000"
            class="w-full bg-zinc-950 text-white border border-zinc-800 rounded-xl px-4 py-3 text-sm placeholder-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-colors resize-y"
            placeholder="<%= t('listingContentPlaceholder') %>"><%= form.content || '' %></textarea>
          <p class="text-xs text-zinc-500 mt-1"><%= t('listingContactNote') %></p>
        </div>

        <div>
          <label for="image" class="block text-sm font-medium text-zinc-300 mb-2"><%= t('photoLabel') %> (<%= t('listingOptional') %>)</label>
          <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif"
            class="w-full bg-zinc-950 text-zinc-400 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-zinc-800 file:text-zinc-300 file:text-xs hover:file:bg-zinc-700 file:cursor-pointer">
          <p class="text-xs text-zinc-500 mt-1"><%= t('photoHint') %></p>
        </div>

        <div>
          <div class="portal-recaptcha" id="ilan-page-recaptcha"></div>
        </div>

        <button type="submit"
          class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm py-3.5 rounded-xl transition-all shadow-lg shadow-emerald-950/40 cursor-pointer">
          <%= t('listingSubmit') %>
        </button>
      </form>
    </div>
  </div>
</section>
